---
import Account from "../layouts/Account.astro";

interface Props {
  label?: string;
  showRefresh?: boolean;
  search?: boolean;
  showBack?: boolean;
}

const {
  label = "← 返回",
  showRefresh = false,
  search = false,
  showBack = true,
} = Astro.props;
---

<header class="topbar">
  <a class="brand" href="/" aria-label="返回 FuckXter 首页">
    <img
      class="logo-img logo-light"
      src="/fuckxter_bk.avif"
      alt="FuckXter"
      width="515"
      height="128"
      decoding="async"
    />
    <img
      class="logo-img logo-dark"
      src="/fuckxter_wh.avif"
      alt="FuckXter"
      width="514"
      height="514"
      decoding="async"
    />
  </a>
  {showBack && (
    <button type="button" class="back-btn" data-role="back">
      {label}
    </button>
  )}
  {search && (
    <form class="search" action="/" role="search">
      <input
        class="search-input"
        name="q"
        type="search"
        placeholder="搜索 FuckXter"
        aria-label="搜索 FuckXter"
        autocomplete="off"
      />
    </form>
  )}
  <div class="topbar-actions">
    {showRefresh && (
      <button
        type="button"
        class="topbar-icon"
        data-role="notice-refresh"
        aria-label="刷新通知"
        title="刷新通知"
      >
        <svg
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M20 6v5h-5" />
          <path d="M4 18v-5h5" />
          <path d="M6.1 9a7 7 0 0 1 11.2-2.6L20 9" />
          <path d="M17.9 15a7 7 0 0 1-11.2 2.6L4 15" />
        </svg>
      </button>
    )}
    <Account />
  </div>
</header>
