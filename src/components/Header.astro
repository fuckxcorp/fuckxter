---
interface Props {
  label?: string;
  showRefresh?: boolean;
}

const { label = "← 返回", showRefresh = false } = Astro.props;
---

<header class="fk-topbar">
  <a class="fk-brand" href="/" aria-label="返回 FuckXter 首页">
    <img
      class="fk-logo-img fk-logo-light"
      src="/fuckxter_bk.avif"
      alt="FuckXter"
      width="515"
      height="128"
      decoding="async"
    />
    <img
      class="fk-logo-img fk-logo-dark"
      src="/fuckxter_logo.avif"
      alt="FuckXter"
      width="514"
      height="514"
      decoding="async"
    />
  </a>
  <button type="button" class="fk-back-btn" data-role="back">{label}</button>
  {
    showRefresh && (
      <button
        type="button"
        class="fk-topbar-icon"
        data-role="notice-refresh"
        aria-label="刷新通知"
        title="刷新通知"
      >
        <svg
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M20 6v5h-5" />
          <path d="M4 18v-5h5" />
          <path d="M6.1 9a7 7 0 0 1 11.2-2.6L20 9" />
          <path d="M17.9 15a7 7 0 0 1-11.2 2.6L4 15" />
        </svg>
      </button>
    )
  }
</header>
