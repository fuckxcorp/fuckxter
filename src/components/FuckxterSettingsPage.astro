---
import "../styles/fuckxter/style.css";

import FuckxterLayout from "../layouts/FuckxterLayout.astro";
import FuckxterSubpageHeader from "./FuckxterSubpageHeader.astro";

type SettingsSection = "profile" | "security" | "saved" | "storage";

interface Props {
  section: SettingsSection;
}

const { section } = Astro.props;
const sectionTitles: Record<SettingsSection, string> = {
  profile: "个人资料",
  security: "访问控制",
  saved: "收藏",
  storage: "S3 存储",
};
---

<FuckxterLayout title={sectionTitles[section]}>
  <div
    class="fk-app fk-subpage"
    data-fk-settings
    data-settings-section={section}
  >
    <FuckxterSubpageHeader />

    <div class="fk-settings-layout">
      <nav class="fk-settings-nav fk-settings-nav-page" aria-label="设置分类">
        <a
          class:list={[
            "fk-settings-nav-btn",
            { "is-active": section === "profile" },
          ]}
          href="/settings/profile"
          aria-current={section === "profile" ? "page" : undefined}
        >
          个人资料
        </a>
        <a
          class:list={[
            "fk-settings-nav-btn",
            { "is-active": section === "security" },
          ]}
          href="/settings/security"
          aria-current={section === "security" ? "page" : undefined}
        >
          访问控制
        </a>
        <a
          class:list={[
            "fk-settings-nav-btn",
            { "is-active": section === "saved" },
          ]}
          href="/settings/saved"
          aria-current={section === "saved" ? "page" : undefined}
        >
          收藏
        </a>
        <a
          class:list={[
            "fk-settings-nav-btn",
            { "is-active": section === "storage" },
          ]}
          href="/settings/storage"
          aria-current={section === "storage" ? "page" : undefined}
        >
          S3 存储
        </a>
      </nav>

      <div class="fk-settings-body">
        {
          section === "profile" && (
            <section data-settings-pane="profile">
              <h3 class="fk-settings-title">个人资料</h3>
              <div class="fk-profile-header">
                <span
                  class="fk-profile-header-image"
                  data-role="profile-header"
                />
                <div class="fk-profile-header-actions">
                  <div>
                    <strong>主页头图</strong>
                    <small>会上传到 R2 的 headers/用户名.avif</small>
                  </div>
                  <button
                    type="button"
                    class="fk-ghost-btn"
                    data-role="header-upload"
                  >
                    更换头图
                  </button>
                  <button
                    type="button"
                    class="fk-ghost-btn"
                    data-role="header-remove"
                    hidden
                  >
                    移除头图
                  </button>
                  <input
                    type="file"
                    data-role="header-input"
                    accept="image/jpeg,image/png,image/gif,image/webp,image/avif"
                    hidden
                  />
                </div>
              </div>
              <progress
                class="fk-avatar-progress"
                data-role="header-progress"
                max="100"
                value="0"
                hidden
              />
              <div class="fk-profile-head">
                <span class="fk-profile-avatar" data-role="profile-avatar" />
                <button
                  type="button"
                  class="fk-ghost-btn"
                  data-role="avatar-upload"
                >
                  更换头像
                </button>
                <button
                  type="button"
                  class="fk-ghost-btn"
                  data-role="avatar-remove"
                  hidden
                >
                  移除头像
                </button>
                <input
                  type="file"
                  data-role="avatar-input"
                  accept="image/jpeg,image/png,image/gif,image/webp,image/avif"
                  hidden
                />
              </div>
              <progress
                class="fk-avatar-progress"
                data-role="avatar-progress"
                max="100"
                value="0"
                hidden
              />
              <dialog class="fk-avatar-dialog" data-role="avatar-crop-dialog">
                <h4>裁切头像</h4>
                <canvas
                  class="fk-avatar-crop-canvas"
                  data-role="avatar-crop-canvas"
                  width="280"
                  height="280"
                />
                <label class="fk-avatar-zoom">
                  <span>缩放</span>
                  <input
                    data-role="avatar-crop-zoom"
                    type="range"
                    min="1"
                    max="3"
                    step="0.01"
                    value="1"
                  />
                </label>
                <div class="fk-inline-row">
                  <button
                    type="button"
                    class="fk-ghost-btn"
                    data-role="avatar-crop-cancel"
                  >
                    取消
                  </button>
                  <button
                    type="button"
                    class="fk-primary-btn"
                    data-role="avatar-crop-confirm"
                  >
                    确认并上传
                  </button>
                </div>
              </dialog>
              <form data-role="profile-form" novalidate>
                <label class="fk-field">
                  <span class="fk-field-label">昵称</span>
                  <input name="name" type="text" maxlength="20" required />
                </label>
                <label class="fk-field">
                  <span class="fk-field-label">用户名</span>
                  <input
                    name="handle"
                    type="text"
                    minlength="2"
                    maxlength="32"
                    required
                  />
                  <span class="fk-form-hint">
                    2-32 个 Unicode 字母、数字、组合字符、下划线或连字符
                  </span>
                </label>
                <label class="fk-field">
                  <span class="fk-field-label">性别</span>
                  <select name="gender" data-role="gender-select">
                    <option value="">不公开</option>
                    <option value="男">男</option>
                    <option value="女">女</option>
                    <option value="跨性别男">跨性别男</option>
                    <option value="跨性别女">跨性别女</option>
                    <option value="自定义">自定义</option>
                  </select>
                </label>
                <label class="fk-field" data-role="gender-custom-field">
                  <span class="fk-field-label">自定义性别</span>
                  <input
                    name="genderCustom"
                    type="text"
                    maxlength="30"
                    placeholder="选择「自定义」后可填写"
                    disabled
                  />
                </label>
                <label class="fk-field">
                  <span class="fk-field-label">地区</span>
                  <input
                    name="region"
                    type="text"
                    maxlength="60"
                    placeholder="如：上海，中国"
                  />
                </label>
                <label class="fk-field">
                  <span class="fk-field-label">生日</span>
                  <input
                    name="birthday"
                    type="date"
                    min="1700-01-01"
                    max={new Date().toISOString().slice(0, 10)}
                  />
                </label>
                <label class="fk-field">
                  <span class="fk-field-label">个人简介</span>
                  <textarea
                    name="bio"
                    rows="4"
                    maxlength="200"
                    placeholder="介绍一下自己（200 字以内）"
                  />
                  <span class="fk-char-count" data-role="bio-count">
                    0 / 200
                  </span>
                </label>
                <p class="fk-form-status" aria-live="polite" />
                <button class="fk-primary-btn" type="submit">
                  保存更改
                </button>
              </form>
            </section>
          )
        }

        {
          section === "saved" && (
            <section data-settings-pane="saved">
              <h3 class="fk-settings-title">收藏</h3>
              <p class="fk-form-hint">
                你收藏的帖子会保存在本机，点击卡片可在独立页面打开。
              </p>
              <div class="fk-saved-list" data-role="saved-list" />
              <p class="fk-status" data-role="saved-empty" hidden>
                还没有收藏内容
              </p>
            </section>
          )
        }

        {
          section === "security" && (
            <section data-settings-pane="security">
              <h3 class="fk-settings-title">访问控制</h3>

              <div class="fk-security-forms">
                <form class="fk-fieldset" data-role="email-form" novalidate>
                  <p class="fk-fieldset-title">更改邮箱</p>
                  <p class="fk-form-hint">
                    当前邮箱：
                    <span data-role="current-email" />
                  </p>
                  <label class="fk-field">
                    <span class="fk-field-label">新邮箱</span>
                    <input
                      name="email"
                      type="email"
                      placeholder="new@example.com"
                      required
                    />
                  </label>
                  <label class="fk-field">
                    <span class="fk-field-label">当前密码</span>
                    <input
                      name="password"
                      type="password"
                      autocomplete="current-password"
                      required
                    />
                  </label>
                  <p class="fk-form-status" aria-live="polite" />
                  <button class="fk-primary-btn" type="submit">
                    更新邮箱
                  </button>
                </form>

                <form class="fk-fieldset" data-role="password-form" novalidate>
                  <p class="fk-fieldset-title">更改密码</p>
                  <label class="fk-field">
                    <span class="fk-field-label">当前密码</span>
                    <input
                      name="current"
                      type="password"
                      autocomplete="current-password"
                      required
                    />
                  </label>
                  <label class="fk-field">
                    <span class="fk-field-label">新密码</span>
                    <input
                      name="next"
                      type="password"
                      autocomplete="new-password"
                      minlength="8"
                      placeholder="至少 8 位"
                      required
                    />
                  </label>
                  <label class="fk-field">
                    <span class="fk-field-label">确认新密码</span>
                    <input
                      name="confirm"
                      type="password"
                      autocomplete="new-password"
                      required
                    />
                  </label>
                  <p class="fk-form-status" aria-live="polite" />
                  <button class="fk-primary-btn" type="submit">
                    更新密码
                  </button>
                </form>
              </div>

              <div class="fk-security-forms fk-security-advanced">
                <div class="fk-fieldset">
                  <p class="fk-fieldset-title">两步验证（2FA）</p>
                  <p class="fk-form-hint" data-role="tfa-status" />

                  <div
                    class="fk-security-state-row"
                    data-role="tfa-manage"
                    hidden
                  >
                    <span class="fk-security-state fk-security-state-badge">
                      已绑定 TOTP
                    </span>
                    <button
                      type="button"
                      class="fk-ghost-btn"
                      data-role="tfa-replace"
                    >
                      更换
                    </button>
                  </div>

                  <div data-role="tfa-off">
                    <button
                      type="button"
                      class="fk-ghost-btn"
                      data-role="tfa-start"
                    >
                      添加 2FA
                    </button>
                  </div>

                  <div data-role="tfa-setup" hidden>
                    <p class="fk-form-hint">
                      1. 在验证器 App 中手动添加以下密钥：
                    </p>
                    <code class="fk-tfa-secret" data-role="tfa-secret" />
                    <p class="fk-form-hint">
                      2. 输入 App 显示的 6 位验证码完成绑定：
                    </p>
                    <div class="fk-inline-row">
                      <input
                        class="fk-tfa-code"
                        data-role="tfa-code"
                        inputmode="numeric"
                        maxlength="6"
                        placeholder="201010"
                        autocomplete="one-time-code"
                      />
                      <button
                        type="button"
                        class="fk-primary-btn"
                        data-role="tfa-confirm"
                      >
                        绑定
                      </button>
                      <button
                        type="button"
                        class="fk-ghost-btn"
                        data-role="tfa-cancel"
                      >
                        取消
                      </button>
                    </div>
                    <p
                      class="fk-form-status"
                      data-role="tfa-setup-status"
                      aria-live="polite"
                    />
                  </div>
                </div>

                <div class="fk-fieldset">
                  <p class="fk-fieldset-title">恢复密钥</p>
                  <p class="fk-form-hint" data-role="recovery-hint" hidden>
                    需要先开启两步验证，才能生成恢复密钥。
                  </p>
                  <div
                    class="fk-security-state-row"
                    data-role="recovery-summary"
                    hidden
                  >
                    <span
                      class="fk-security-state"
                      data-role="recovery-count"
                    />
                    <button
                      type="button"
                      class="fk-ghost-btn"
                      data-role="recovery-replace"
                    >
                      更换
                    </button>
                  </div>
                  <p
                    class="fk-form-status"
                    data-role="recovery-status"
                    aria-live="polite"
                  />

                  <div data-role="recovery-box" hidden>
                    <ol class="fk-recovery-list" data-role="recovery-list" />
                    <div class="fk-inline-row">
                      <button
                        type="button"
                        class="fk-ghost-btn"
                        data-role="recovery-copy"
                      >
                        复制全部
                      </button>
                      <button
                        type="button"
                        class="fk-ghost-btn"
                        data-role="recovery-download"
                      >
                        下载 .txt
                      </button>
                    </div>
                    <p class="fk-form-hint">
                      恢复密钥只显示一次，请立即下载或复制到安全的地方。
                    </p>
                  </div>

                  <button
                    type="button"
                    class="fk-ghost-btn"
                    data-role="recovery-generate"
                  >
                    生成恢复密钥
                  </button>
                </div>
              </div>
            </section>
          )
        }

        {
          section === "storage" && (
            <section data-settings-pane="storage">
              <h3 class="fk-settings-title">S3 兼容存储</h3>
              <p class="fk-form-hint">
                连接你自己的对象存储（S3 API
                兼容），媒体文件将直接上传到你的桶中，存储成本完全由你掌控。
              </p>
              <div class="fk-storage-toolbar">
                <select
                  class="fk-storage-select"
                  data-role="s3-config-select"
                  aria-label="选择 S3 配置"
                />
                <button type="button" class="fk-ghost-btn" data-role="s3-new">
                  新增
                </button>
                <button
                  type="button"
                  class="fk-ghost-btn"
                  data-role="s3-delete"
                  disabled
                >
                  删除
                </button>
              </div>
              <form data-role="s3-form" novalidate>
                <label class="fk-field">
                  <span class="fk-field-label">配置名称</span>
                  <input
                    name="name"
                    type="text"
                    maxlength="60"
                    placeholder="例如：我的 Cloudflare R2"
                    required
                  />
                </label>
                <label class="fk-field">
                  <span class="fk-field-label">Endpoint</span>
                  <input
                    name="endpoint"
                    type="url"
                    placeholder="https://s3.example.com"
                    required
                  />
                </label>
                <label class="fk-field">
                  <span class="fk-field-label">Region</span>
                  <input name="region" type="text" placeholder="us-east-1" />
                </label>
                <label class="fk-field">
                  <span class="fk-field-label">Bucket</span>
                  <input
                    name="bucket"
                    type="text"
                    placeholder="my-fuckxter-media"
                    required
                  />
                </label>
                <label class="fk-field">
                  <span class="fk-field-label">Access Key ID</span>
                  <input
                    name="accessKeyId"
                    type="text"
                    autocomplete="off"
                    placeholder="AKIA…"
                    required
                  />
                </label>
                <label class="fk-field">
                  <span class="fk-field-label">Secret Access Key</span>
                  <input
                    name="secretAccessKey"
                    type="password"
                    autocomplete="off"
                    placeholder="••••••••"
                    required
                  />
                </label>
                <label class="fk-check-row">
                  <input name="isDefault" type="checkbox" />
                  <span>设为媒体上传的默认存储</span>
                </label>
                <label class="fk-check-row">
                  <input name="pathStyle" type="checkbox" />
                  <span>
                    使用路径风格寻址（path-style，MinIO 等自建存储常用）
                  </span>
                </label>
                <p class="fk-form-status" aria-live="polite" />
                <div class="fk-inline-row">
                  <button
                    class="fk-ghost-btn"
                    type="button"
                    data-role="s3-test"
                  >
                    测试连接
                  </button>
                  <button class="fk-primary-btn" type="submit">
                    保存
                  </button>
                </div>
              </form>
            </section>
          )
        }
      </div>
    </div>
  </div>
</FuckxterLayout>

<script>
  import { mountFuckxterSettings } from "../lib/fuckxter/settings";
  import { onFuckxterPageReady } from "../lib/fuckxter/page";

  onFuckxterPageReady(() => {
    const root = document.querySelector<HTMLElement>("[data-fk-settings]");
    if (!root) return;
    mountFuckxterSettings(
      root,
      (root.dataset.settingsSection ?? "profile") as
        "profile" | "security" | "saved" | "storage",
    );
  });
</script>
