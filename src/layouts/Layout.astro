---
import "../styles/global.css";
import ThemeScript from "../components/Theme.astro";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
}

const { title = "FuckXter" } = Astro.props;
const documentTitle = title === "FuckXter" ? title : `${title} | FuckXter`;
---

<html lang="zh-CN" data-theme="light" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="description" content="FuckXter 是一个开放、轻量的社交平台。" />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:site_name" content="FuckXter" />
    <link rel="icon" type="image/avif" href="/fuckxter_logo.avif" />
    <meta name="generator" content={Astro.generator} />
    <title>{documentTitle}</title>
    <ClientRouter />
    <ThemeScript />
  </head>
  <body>
    <slot />
    <dialog class="media-viewer" data-media-viewer aria-label="图片预览">
      <button type="button" aria-label="关闭图片预览">
        ×
      </button>
      <img alt="" />
    </dialog>
    <script is:inline>
      document.addEventListener("click", (event) => {
        const target = event.target;
        const viewer = document.querySelector("[data-media-viewer]");
        if (!(viewer instanceof HTMLDialogElement)) return;
        if (
          target instanceof HTMLImageElement &&
          target.matches(".media-image")
        ) {
          event.preventDefault();
          event.stopPropagation();
          const image = viewer.querySelector("img");
          image.src = target.currentSrc || target.src;
          image.alt = target.alt;
          viewer.showModal();
          return;
        }
        if (
          target === viewer ||
          (target instanceof HTMLButtonElement &&
            target.closest("[data-media-viewer]"))
        ) {
          viewer.close();
        }
      });
      document.addEventListener(
        "error",
        (event) => {
          const target = event.target;
          if (target instanceof HTMLImageElement) {
            target.classList.add("is-image-error");
            const container = target.closest(
              ".avatar, .account-avatar, .menu-user-avatar, .user-avatar, .notice-avatar, .user-banner, .media",
            );
            if (container) {
              container.classList.add("is-image-error");
              container.removeAttribute("style");
              container
                .querySelector(".avatar-fallback")
                ?.setAttribute("hidden", "");
            }
            if (target.closest(".user-banner-host")) {
              target.closest(".user-banner-host").hidden = true;
            }
            target.removeAttribute("src");
          } else if (target instanceof HTMLVideoElement) {
            target.classList.add("is-image-error");
          }
        },
        true,
      );
    </script>
  </body>
</html>
