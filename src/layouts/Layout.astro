---
import "../styles/global.css";
import ThemeScript from "../components/ThemeScript.astro";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
}

const { title = "FuckXter" } = Astro.props;
const documentTitle = title === "FuckXter" ? title : `${title} | FuckXter`;
---

<html lang="zh-CN" data-theme="light" transition:animate="none">
  <head>
    <!--
      ╔══════════════════════════════════════════╗
      ║  你既然這麼喜歡開 F12，那來加入我們吧     ║
      ╚══════════════════════════════════════════╝
    -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="FuckXter 是一个开放、轻量的社交平台。" />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:site_name" content="FuckXter" />
    <link rel="icon" type="image/avif" href="/fuckxter_logo.avif" />
    <meta name="generator" content={Astro.generator} />
    <title>{documentTitle}</title>
    <ClientRouter />
    <ThemeScript />
  </head>
  <body>
    <slot />
    <script is:inline>
      // 彩蛋：開 F12 的人至少要看得到這行。
      (() => {
        console.log(
          "%c你既然這麼喜歡開 F12，那來加入我們吧",
          "color:#f2f4f6;background:#101215;padding:8px 14px;border-radius:4px;font-size:14px;font-weight:700;",
        );
        console.log(
          "%cFuckXter%c · 原始碼裡也留了一句給你，慢慢找。",
          "color:#5b7aa8;font-size:15px;font-weight:800;",
          "color:#6c7480;font-size:12px;",
        );
      })();

      document.addEventListener(
        "error",
        (event) => {
          const target = event.target;
          if (target instanceof HTMLImageElement) {
            target.classList.add("is-image-error");
            const container = target.closest(
              ".fk-avatar, .fk-account-avatar, .fk-menu-user-avatar, .fk-user-avatar, .fk-notice-avatar, .fk-user-banner, .fk-media",
            );
            if (container) {
              container.classList.add("is-image-error");
              container.removeAttribute("style");
              container
                .querySelector(".fk-avatar-fallback")
                ?.setAttribute("hidden", "");
            }
            if (target.closest(".fk-user-banner-host")) {
              target.closest(".fk-user-banner-host").hidden = true;
            }
            target.removeAttribute("src");
          } else if (target instanceof HTMLVideoElement) {
            target.classList.add("is-image-error");
          }
        },
        true,
      );
    </script>
  </body>
</html>
