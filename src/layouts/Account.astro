---
import { languages } from "../lib/i18n";
import AccountIcon from "../components/AccountIcon.astro";
import "../styles/account-menu.css";
---

<div class="account" data-account>
  <button
    type="button"
    class="account-btn"
    data-role="account-btn"
    aria-label="账号"
    aria-expanded="false"
    aria-haspopup="menu"
  >
    <span class="account-avatar" data-role="account-avatar" hidden></span>
    <svg
      class="account-icon"
      data-role="account-icon"
      viewBox="0 0 24 24"
      width="21"
      height="21"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="12" cy="8" r="4"></circle>
      <path d="M4 21c0-4 3.6-6.5 8-6.5s8 2.5 8 6.5"></path>
    </svg>
    <span
      class="account-notice-dot"
      data-role="account-notice-dot"
      hidden
    ></span>
  </button>

  <div class="menu account-menu" data-role="account-menu" role="menu" hidden>
    <div data-role="auth-items">
      <p class="menu-title">登录 FuckXter</p>
      <button
        type="button"
        class="menu-item"
        role="menuitem"
        data-auth-open="signin"
      >
        <AccountIcon name="signin" />
        登录 / 注册
      </button>
      <button
        type="button"
        class="menu-item"
        role="menuitem"
        data-account-open="history"
      >
        <AccountIcon name="history" />
        历史
      </button>
    </div>

    <div data-role="user-items" hidden>
      <button
        type="button"
        class="menu-user"
        role="menuitem"
        data-account-open="profile"
        aria-label="进入我的主页"
      >
        <span class="menu-user-avatar" data-role="menu-avatar"></span>
        <span class="menu-user-meta">
          <strong data-role="menu-name"></strong>
          <small data-role="menu-handle"></small>
        </span>
      </button>
      <button
        type="button"
        class="menu-item notice-menu-item"
        role="menuitem"
        data-account-open="notice"
        data-role="notice-menu-item"
      >
        <AccountIcon name="notice" />
        <span>通知</span>
        <span
          class="notice-menu-badge"
          data-role="notice-menu-badge"
          hidden
        ></span>
      </button>
      <button
        type="button"
        class="menu-item"
        role="menuitem"
        data-account-open="saved"
      >
        <AccountIcon name="saved" />
        收藏
      </button>
      <button
        type="button"
        class="menu-item"
        role="menuitem"
        data-account-open="history"
      >
        <AccountIcon name="history" />
        历史
      </button>
      <button
        type="button"
        class="menu-item notice-menu-item"
        role="menuitem"
        data-account-open="messages"
        data-role="message-menu-item"
      >
        <AccountIcon name="messages" />
        <span>私信</span>
        <span
          class="notice-menu-badge"
          data-role="message-menu-badge"
          hidden
        ></span>
      </button>
    </div>
    <div class="menu-row">
      <button
        type="button"
        class="menu-item menu-expandable"
        role="menuitem"
        aria-expanded="false"
        aria-haspopup="menu"
        data-account-open="language"
      >
        <AccountIcon name="language" />
        <span>语言</span>
        <span class="menu-arrow" aria-hidden="true">
          ▸
        </span>
      </button>
      <div
        class="submenu language-submenu"
        data-role="language-submenu"
        role="menu"
        hidden
      >
        {languages.map((language) => (
          <button
            type="button"
            class="menu-item"
            role="menuitemradio"
            data-language-choice={language.code}
            data-no-translate
          >
            <span class="menu-check">✓</span>
            <span data-language-label={language.name}>{language.name}</span>
          </button>
        ))}
      </div>
    </div>
    <button
      type="button"
      class="menu-item"
      role="menuitem"
      data-account-open="settings"
    >
      <AccountIcon name="settings" />
      设置
    </button>
    <a
      class="menu-item"
      role="menuitem"
      href="https://867678.xyz/docs/fuckxter"
    >
      <AccountIcon name="help" />
      帮助
    </a>

    <div data-role="signout-items" hidden>
      <hr class="menu-sep" />
      <button
        type="button"
        class="menu-item"
        role="menuitem"
        data-account-action="signout"
      >
        <AccountIcon name="signout" />
        注销
      </button>
    </div>
  </div>
</div>

<script>
  import { mountAccountControls } from "../lib/accounts/account";
  import { hydrateSession } from "../lib/accounts/auth";
  import { onPageReady } from "../lib/core/page";

  const mount = () => {
    const account = document.querySelector<HTMLElement>("[data-account]");
    const container = account?.closest<HTMLElement>(".app");
    if (!account || !container || account.dataset.mounted === "true") return;
    account.dataset.mounted = "true";

    let disposed = false;
    let controls: ReturnType<typeof mountAccountControls> | undefined;
    document.addEventListener(
      "astro:before-swap",
      () => {
        disposed = true;
        controls?.dispose();
      },
      { once: true },
    );
    controls = mountAccountControls(container, {
      onAccountChange: () =>
        document.dispatchEvent(new Event("fuckxter:account-change")),
    });
    void hydrateSession().then(() => {
      if (disposed || !account.isConnected) return;
      controls?.sync();
    });
  };

  onPageReady(mount);
</script>
