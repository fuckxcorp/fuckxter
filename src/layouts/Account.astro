---
interface Props {
  columns?: boolean;
}

const { columns = false } = Astro.props;
---

<div class="account" data-account>
  <button
    type="button"
    class="account-btn"
    data-role="account-btn"
    aria-label="账号"
    aria-expanded="false"
    aria-haspopup="menu"
  >
    <span class="account-avatar" data-role="account-avatar" hidden></span>
    <svg
      class="account-icon"
      data-role="account-icon"
      viewBox="0 0 24 24"
      width="21"
      height="21"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="12" cy="8" r="4"></circle>
      <path d="M4 21c0-4 3.6-6.5 8-6.5s8 2.5 8 6.5"></path>
    </svg>
    <span
      class="account-notice-dot"
      data-role="account-notice-dot"
      hidden
    ></span>
  </button>

  <div class="menu account-menu" data-role="account-menu" role="menu" hidden>
    <div data-role="auth-items">
      <p class="menu-title">登录 FuckXter</p>
      <button
        type="button"
        class="menu-item"
        role="menuitem"
        data-auth-open="signin"
      >
        登录 / 注册
      </button>
    </div>

    <div data-role="user-items" hidden>
      <button
        type="button"
        class="menu-user"
        role="menuitem"
        data-account-open="profile"
        aria-label="进入我的主页"
      >
        <span class="menu-user-avatar" data-role="menu-avatar"></span>
        <span class="menu-user-meta">
          <strong data-role="menu-name"></strong>
          <small data-role="menu-handle"></small>
        </span>
      </button>
      <button
        type="button"
        class="menu-item notice-menu-item"
        role="menuitem"
        data-account-open="notice"
        data-role="notice-menu-item"
      >
        <span>通知</span>
        <span
          class="notice-menu-badge"
          data-role="notice-menu-badge"
          hidden
        ></span>
      </button>
      <button
        type="button"
        class="menu-item notice-menu-item"
        role="menuitem"
        data-account-open="messages"
        data-role="message-menu-item"
      >
        <span>私信</span>
        <span
          class="notice-menu-badge"
          data-role="message-menu-badge"
          hidden
        ></span>
      </button>
      <button
        type="button"
        class="menu-item"
        role="menuitem"
        data-account-open="saved"
      >
        收藏
      </button>
      <button
        type="button"
        class="menu-item"
        role="menuitem"
        data-account-open="settings"
      >
        设置
      </button>
    </div>

    <div class="menu-row">
      <button
        type="button"
        class="menu-item menu-expandable"
        role="menuitem"
        aria-expanded="false"
        aria-haspopup="menu"
        data-account-open="theme"
      >
        主题{" "}
        <span class="menu-arrow" aria-hidden="true">
          ▸
        </span>
      </button>
      <div class="submenu" data-role="theme-submenu" role="menu" hidden>
        <button
          type="button"
          class="menu-item"
          role="menuitemradio"
          data-theme-choice="auto"
        >
          <span class="menu-check">✓</span>跟随系统
        </button>
        <button
          type="button"
          class="menu-item"
          role="menuitemradio"
          data-theme-choice="light"
        >
          <span class="menu-check">✓</span>浅色
        </button>
        <button
          type="button"
          class="menu-item"
          role="menuitemradio"
          data-theme-choice="dark"
        >
          <span class="menu-check">✓</span>深色
        </button>
      </div>
    </div>

    {columns && (
      <div class="menu-row">
        <button
          type="button"
          class="menu-item menu-expandable"
          role="menuitem"
          aria-expanded="false"
          aria-haspopup="menu"
          data-role="columns-trigger"
        >
          列数
          <span class="columns-value" data-role="columns-value">
            2 列
          </span>
          <span class="menu-arrow" aria-hidden="true">
            ▸
          </span>
        </button>
        <div class="submenu" data-role="columns-submenu" role="menu" hidden>
          <button
            type="button"
            class="menu-item"
            role="menuitemradio"
            aria-checked="false"
            data-columns-choice="3"
          >
            <span class="menu-check">✓</span>3 列
          </button>
          <button
            type="button"
            class="menu-item"
            role="menuitemradio"
            aria-checked="true"
            data-columns-choice="2"
          >
            <span class="menu-check">✓</span>2 列
          </button>
          <button
            type="button"
            class="menu-item"
            role="menuitemradio"
            aria-checked="false"
            data-columns-choice="1"
          >
            <span class="menu-check">✓</span>1 列
          </button>
          <button
            type="button"
            class="menu-item"
            role="menuitemradio"
            aria-checked="false"
            data-columns-choice="auto"
          >
            <span class="menu-check">✓</span>自动
          </button>
        </div>
      </div>
    )}

    <div data-role="signout-items" hidden>
      <hr class="menu-sep" />
      <button
        type="button"
        class="menu-item"
        role="menuitem"
        data-account-action="signout"
      >
        注销
      </button>
    </div>
  </div>
</div>

<script>
  import { mountAccountControls } from "../lib/accounts/account";
  import { hydrateSession } from "../lib/accounts/auth";
  import { onPageReady } from "../lib/core/page";

  const mount = () => {
    const account = document.querySelector<HTMLElement>("[data-account]");
    const container = account?.closest<HTMLElement>(".app");
    if (!account || !container || account.dataset.mounted === "true") return;
    account.dataset.mounted = "true";

    let disposed = false;
    let controls: ReturnType<typeof mountAccountControls> | undefined;
    document.addEventListener(
      "astro:before-swap",
      () => {
        disposed = true;
        controls?.dispose();
      },
      { once: true },
    );
    void hydrateSession().then(() => {
      if (disposed || !account.isConnected) return;
      controls = mountAccountControls(container, {
        onAccountChange: () =>
          document.dispatchEvent(new Event("fuckxter:account-change")),
      });
    });
  };

  onPageReady(mount);
</script>
