---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";

type SettingsSection = "profile" | "security" | "storage";

interface Props {
  section: SettingsSection;
}

const { section } = Astro.props;
const sectionTitles: Record<SettingsSection, string> = {
  profile: "个人资料",
  security: "访问控制",
  storage: "S3 存储",
};
---

<Layout title={sectionTitles[section]}>
  <div class="app subpage" data-settings data-settings-section={section}>
    <Header />
    <button
      type="button"
      class="settings-menu-trigger"
      data-role="settings-menu-trigger"
      aria-label="打开设置菜单"
      aria-expanded="false"
    >
      <svg
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>
    <nav
      class="settings-menu"
      data-role="settings-menu"
      aria-label="设置菜单"
      hidden
    >
      <a
        class:list={[
          "settings-menu-item",
          { "is-active": section === "profile" },
        ]}
        href="/settings/profile"
      >
        个人资料
      </a>
      <a
        class:list={[
          "settings-menu-item",
          { "is-active": section === "security" },
        ]}
        href="/settings/security"
      >
        访问控制
      </a>
      <a
        class:list={[
          "settings-menu-item",
          { "is-active": section === "storage" },
        ]}
        href="/settings/storage"
      >
        S3 存储
      </a>
    </nav>

    <div class="settings-layout">
      <nav class="settings-nav settings-nav-page" aria-label="设置分类">
        <a
          class:list={[
            "settings-nav-btn",
            { "is-active": section === "profile" },
          ]}
          href="/settings/profile"
          aria-current={section === "profile" ? "page" : undefined}
        >
          个人资料
        </a>
        <a
          class:list={[
            "settings-nav-btn",
            { "is-active": section === "security" },
          ]}
          href="/settings/security"
          aria-current={section === "security" ? "page" : undefined}
        >
          访问控制
        </a>
        <a
          class:list={[
            "settings-nav-btn",
            { "is-active": section === "storage" },
          ]}
          href="/settings/storage"
          aria-current={section === "storage" ? "page" : undefined}
        >
          S3 存储
        </a>
      </nav>

      <div class="settings-body">
        {section === "profile" && (
          <section data-settings-pane="profile">
            <h3 class="settings-title">个人资料</h3>
            <div class="profile-header">
              <span class="profile-header-image" data-role="profile-header" />
              <div class="profile-header-actions">
                <div>
                  <strong>主页头图</strong>
                  <small>
                    自定义您个人主页最上面的图片，推荐比例 5:1，最大处理尺寸
                    1500×300，文件大小限制 30MB。
                  </small>
                </div>
                <button
                  type="button"
                  class="ghost-btn"
                  data-role="header-upload"
                >
                  更换头图
                </button>
                <button
                  type="button"
                  class="ghost-btn"
                  data-role="header-remove"
                  hidden
                >
                  移除头图
                </button>
                <input
                  type="file"
                  data-role="header-input"
                  accept="image/jpeg,image/png,image/gif,image/webp,image/avif"
                  hidden
                />
              </div>
            </div>
            <progress
              class="avatar-progress"
              data-role="header-progress"
              max="100"
              value="0"
              hidden
            />
            <div class="profile-head">
              <span class="profile-avatar" data-role="profile-avatar" />
              <button type="button" class="ghost-btn" data-role="avatar-upload">
                更换头像
              </button>
              <button
                type="button"
                class="ghost-btn"
                data-role="avatar-remove"
                hidden
              >
                移除头像
              </button>
              <input
                type="file"
                data-role="avatar-input"
                accept="image/jpeg,image/png,image/gif,image/webp,image/avif"
                hidden
              />
            </div>
            <progress
              class="avatar-progress"
              data-role="avatar-progress"
              max="100"
              value="0"
              hidden
            />
            <dialog class="avatar-dialog" data-role="avatar-crop-dialog">
              <h4>裁切头像</h4>
              <p class="avatar-crop-hint">
                拖动和缩放图片，让头像完整落在圆形区域内。
              </p>
              <div class="avatar-crop-stage">
                <canvas
                  class="avatar-crop-canvas"
                  data-role="avatar-crop-canvas"
                  width="280"
                  height="280"
                />
                <span class="avatar-crop-outline" aria-hidden="true" />
                <span class="avatar-crop-label">头像显示区域</span>
              </div>
              <label class="avatar-zoom">
                <span>缩放</span>
                <input
                  data-role="avatar-crop-zoom"
                  type="range"
                  min="1"
                  max="3"
                  step="0.01"
                  value="1"
                />
              </label>
              <div class="inline-row">
                <button
                  type="button"
                  class="ghost-btn"
                  data-role="avatar-crop-cancel"
                >
                  取消
                </button>
                <button
                  type="button"
                  class="primary-btn"
                  data-role="avatar-crop-confirm"
                >
                  确认并上传
                </button>
              </div>
            </dialog>
            <dialog
              class="avatar-dialog header-crop-dialog"
              data-role="header-crop-dialog"
            >
              <h4>调整头图显示区域</h4>
              <p class="header-crop-hint">
                下方区域就是主页头图的最终显示范围（5:1）。拖动图片选择位置，使用滑杆调整缩放。
              </p>
              <div class="header-crop-stage">
                <canvas
                  class="header-crop-canvas"
                  data-role="header-crop-canvas"
                  width="1500"
                  height="300"
                  aria-label="头图裁切预览"
                />
                <span class="header-crop-label">主页显示区域</span>
              </div>
              <label class="avatar-zoom">
                <span>缩放</span>
                <input
                  data-role="header-crop-zoom"
                  type="range"
                  min="1"
                  max="3"
                  step="0.01"
                  value="1"
                />
              </label>
              <div class="inline-row">
                <button
                  type="button"
                  class="ghost-btn"
                  data-role="header-crop-cancel"
                >
                  取消
                </button>
                <button
                  type="button"
                  class="primary-btn"
                  data-role="header-crop-confirm"
                >
                  确认并上传
                </button>
              </div>
            </dialog>
            <form data-role="profile-form" novalidate>
              <label class="field">
                <span class="field-label">昵称</span>
                <input name="name" type="text" maxlength="20" required />
              </label>
              <label class="field">
                <span class="field-label">用户名</span>
                <input
                  name="handle"
                  type="text"
                  minlength="2"
                  maxlength="32"
                  required
                />
                <span class="form-hint">
                  2-32 个 Unicode 字母、数字、组合字符、下划线或连字符
                </span>
              </label>
              <label class="field">
                <span class="field-label">性别</span>
                <select name="gender" data-role="gender-select">
                  <option value="">不公开</option>
                  <option value="男">男</option>
                  <option value="女">女</option>
                  <option value="跨性别男">跨性别男</option>
                  <option value="跨性别女">跨性别女</option>
                  <option value="自定义">自定义</option>
                </select>
              </label>
              <label class="field" data-role="gender-custom-field">
                <span class="field-label">自定义性别</span>
                <input
                  name="genderCustom"
                  type="text"
                  maxlength="30"
                  placeholder="选择「自定义」后可填写"
                  disabled
                />
              </label>
              <label class="field">
                <span class="field-label">地区</span>
                <input
                  name="region"
                  type="text"
                  maxlength="60"
                  placeholder="如：上海，中国"
                />
              </label>
              <label class="field">
                <span class="field-label">生日</span>
                <input
                  name="birthday"
                  type="date"
                  min="1700-01-01"
                  max={new Date().toISOString().slice(0, 10)}
                />
              </label>
              <label class="field">
                <span class="field-label">个人简介</span>
                <textarea
                  name="bio"
                  rows="4"
                  maxlength="200"
                  placeholder="介绍一下自己（200 字以内）"
                ></textarea>
                <span class="char-count" data-role="bio-count">
                  0 / 200
                </span>
              </label>
              <p class="form-status" aria-live="polite" />
              <button class="primary-btn" type="submit">
                保存更改
              </button>
            </form>
          </section>
        )}

        {section === "security" && (
          <section data-settings-pane="security">
            <h3 class="settings-title">访问控制</h3>

            <div class="security-forms">
              <form class="fieldset" data-role="email-form" novalidate>
                <p class="fieldset-title">更改邮箱</p>
                <p class="form-hint">
                  当前邮箱：
                  <span data-role="current-email" />
                </p>
                <label class="field">
                  <span class="field-label">新邮箱</span>
                  <input
                    name="email"
                    type="email"
                    placeholder="new@example.com"
                    required
                  />
                </label>
                <label class="field">
                  <span class="field-label">当前密码</span>
                  <input
                    name="password"
                    type="password"
                    autocomplete="current-password"
                    required
                  />
                </label>
                <p class="form-status" aria-live="polite" />
                <button class="primary-btn" type="submit">
                  更新邮箱
                </button>
              </form>

              <form class="fieldset" data-role="password-form" novalidate>
                <p class="fieldset-title">更改密码</p>
                <label class="field">
                  <span class="field-label">当前密码</span>
                  <input
                    name="current"
                    type="password"
                    autocomplete="current-password"
                    required
                  />
                </label>
                <label class="field">
                  <span class="field-label">新密码</span>
                  <input
                    name="next"
                    type="password"
                    autocomplete="new-password"
                    minlength="8"
                    placeholder="至少 8 位"
                    required
                  />
                </label>
                <label class="field">
                  <span class="field-label">确认新密码</span>
                  <input
                    name="confirm"
                    type="password"
                    autocomplete="new-password"
                    required
                  />
                </label>
                <p class="form-status" aria-live="polite" />
                <button class="primary-btn" type="submit">
                  更新密码
                </button>
              </form>
            </div>

            <div class="security-forms security-advanced">
              <div class="fieldset">
                <p class="fieldset-title">两步验证（2FA）</p>
                <p class="form-hint" data-role="tfa-status" />

                <div class="security-state-row" data-role="tfa-manage" hidden>
                  <span class="security-state security-state-badge">
                    已绑定 TOTP
                  </span>
                  <button
                    type="button"
                    class="ghost-btn"
                    data-role="tfa-replace"
                  >
                    更换
                  </button>
                </div>

                <div data-role="tfa-off">
                  <button type="button" class="ghost-btn" data-role="tfa-start">
                    添加 2FA
                  </button>
                </div>

                <div data-role="tfa-setup" hidden>
                  <p class="form-hint">1. 在验证器 App 中手动添加以下密钥：</p>
                  <code class="tfa-secret" data-role="tfa-secret" />
                  <p class="form-hint">
                    2. 输入 App 显示的 6 位验证码完成绑定：
                  </p>
                  <div class="inline-row">
                    <input
                      class="tfa-code"
                      data-role="tfa-code"
                      inputmode="numeric"
                      maxlength="6"
                      placeholder="201010"
                      autocomplete="one-time-code"
                    />
                    <button
                      type="button"
                      class="primary-btn"
                      data-role="tfa-confirm"
                    >
                      绑定
                    </button>
                    <button
                      type="button"
                      class="ghost-btn"
                      data-role="tfa-cancel"
                    >
                      取消
                    </button>
                  </div>
                  <p
                    class="form-status"
                    data-role="tfa-setup-status"
                    aria-live="polite"
                  />
                </div>
              </div>

              <div class="fieldset">
                <p class="fieldset-title">恢复密钥</p>
                <p class="form-hint" data-role="recovery-hint" hidden>
                  需要先开启两步验证，才能生成恢复密钥。
                </p>
                <div
                  class="security-state-row"
                  data-role="recovery-summary"
                  hidden
                >
                  <span class="security-state" data-role="recovery-count" />
                  <button
                    type="button"
                    class="ghost-btn"
                    data-role="recovery-replace"
                  >
                    更换
                  </button>
                </div>
                <p
                  class="form-status"
                  data-role="recovery-status"
                  aria-live="polite"
                />

                <div data-role="recovery-box" hidden>
                  <ol class="recovery-list" data-role="recovery-list" />
                  <div class="inline-row">
                    <button
                      type="button"
                      class="ghost-btn"
                      data-role="recovery-copy"
                    >
                      复制全部
                    </button>
                    <button
                      type="button"
                      class="ghost-btn"
                      data-role="recovery-download"
                    >
                      下载 .txt
                    </button>
                  </div>
                  <p class="form-hint">
                    恢复密钥只显示一次，请立即下载或复制到安全的地方。
                  </p>
                </div>

                <button
                  type="button"
                  class="ghost-btn"
                  data-role="recovery-generate"
                >
                  生成恢复密钥
                </button>
              </div>

              <div class="fieldset" data-role="delete-account">
                <p class="fieldset-title">删除账号</p>
                <p class="form-hint">
                  提交后账号会立即下线，内容也不再对外显示。3
                  天内登录回来会自动取消；超过 3 天，账号和数据会被永久删除。
                </p>
                <button
                  type="button"
                  class="ghost-btn"
                  data-role="account-delete"
                >
                  删除账号
                </button>
                <p
                  class="form-status"
                  data-role="account-delete-status"
                  aria-live="polite"
                />
              </div>
            </div>
          </section>
        )}

        {section === "storage" && (
          <section data-settings-pane="storage">
            <h3 class="settings-title">S3 兼容存储</h3>
            <p class="form-hint">
              连接你自己的对象存储（S3 API
              兼容），媒体文件将直接上传到你的桶中，存储成本完全由你掌控。
            </p>
            <p class="form-hint">
              不配置也可以：图片会存到平台自己的存储里，随时可以在下面补上自己的桶。
            </p>
            <div class="storage-toolbar">
              <select
                class="storage-select"
                data-role="s3-config-select"
                aria-label="选择 S3 配置"
              />
              <button type="button" class="ghost-btn" data-role="s3-new">
                新增
              </button>
              <button
                type="button"
                class="ghost-btn"
                data-role="s3-delete"
                disabled
              >
                删除
              </button>
            </div>
            <label class="field upload-mode-setting">
              <span class="field-label">上传方式</span>
              <select
                class="storage-select"
                data-role="upload-mode-setting"
                aria-label="选择上传方式"
              >
                <option value="proxy">代理上传</option>
                <option value="direct">直传存储桶</option>
              </select>
            </label>
            <form data-role="s3-form" novalidate>
              <label class="field">
                <span class="field-label">配置名称</span>
                <input
                  name="name"
                  type="text"
                  maxlength="60"
                  placeholder="例如：我的 Cloudflare R2"
                  required
                />
              </label>
              <label class="field">
                <span class="field-label">Endpoint</span>
                <input
                  name="endpoint"
                  type="url"
                  placeholder="https://s3.example.com"
                  required
                />
              </label>
              <label class="field">
                <span class="field-label">Region</span>
                <input name="region" type="text" placeholder="us-east-1" />
              </label>
              <label class="field">
                <span class="field-label">Bucket</span>
                <input
                  name="bucket"
                  type="text"
                  placeholder="my-fuckxter-media"
                  required
                />
              </label>
              <label class="field">
                <span class="field-label">Access Key ID</span>
                <input
                  name="accessKeyId"
                  type="text"
                  autocomplete="off"
                  placeholder="AKIA…"
                  required
                />
              </label>
              <label class="field">
                <span class="field-label">Secret Access Key</span>
                <input
                  name="secretAccessKey"
                  type="password"
                  autocomplete="off"
                  placeholder="••••••••"
                  required
                />
              </label>
              <label class="check-row">
                <input name="isDefault" type="checkbox" />
                <span>设为媒体上传的默认存储</span>
              </label>
              <label class="check-row">
                <input name="pathStyle" type="checkbox" />
                <span>
                  使用路径风格寻址（path-style，MinIO 等自建存储常用）
                </span>
              </label>
              <p class="form-status" aria-live="polite" />
              <div class="inline-row">
                <button class="ghost-btn" type="button" data-role="s3-test">
                  测试连接
                </button>
                <button class="primary-btn" type="submit">
                  保存
                </button>
              </div>
            </form>
          </section>
        )}
      </div>
    </div>
  </div>
</Layout>

<script>
  import { mountSettings } from "../lib/settings";
  import { onPageReady } from "../lib/core/page";

  onPageReady(() => {
    const root = document.querySelector<HTMLElement>("[data-settings]");
    if (!root) return;
    const menuTrigger = root.querySelector<HTMLButtonElement>(
      "[data-role=settings-menu-trigger]",
    )!;
    const menu = root.querySelector<HTMLElement>("[data-role=settings-menu]")!;
    const closeMenu = () => {
      menu.hidden = true;
      menuTrigger.setAttribute("aria-expanded", "false");
    };
    menuTrigger.addEventListener("click", (event) => {
      event.stopPropagation();
      const willOpen = menu.hidden;
      menu.hidden = !willOpen;
      menuTrigger.setAttribute("aria-expanded", String(willOpen));
    });
    menu.addEventListener("click", closeMenu);
    document.addEventListener("click", (event) => {
      const target = event.target as Node;
      if (
        !menu.hidden &&
        !menu.contains(target) &&
        !menuTrigger.contains(target)
      ) {
        closeMenu();
      }
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeMenu();
    });
    mountSettings(
      root,
      (root.dataset.settingsSection ?? "profile") as
        "profile" | "security" | "storage",
    );
  });
</script>
