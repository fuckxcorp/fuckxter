---
import "../styles/notice.css";

import Notice from "../layouts/Notice.astro";
---

<Notice title="通知" root="data-notice" showRefresh>
  <p slot="subtitle" data-role="notice-summary">
    正在加载…
  </p>
  <button
    slot="actions"
    type="button"
    class="notice-read-all"
    data-role="notice-read-all"
    disabled
  >
    全部已读
  </button>
  <div class="notice-list" data-role="notice-list"></div>
  <button type="button" class="notice-more" data-role="notice-more" hidden>
    加载更早
  </button>
</Notice>

<script>
  import { getNotifications, markNotificationsRead } from "../lib/accounts/api";
  import { hydrateSession } from "../lib/accounts/auth";
  import { avatarGradient, el, ICONS, relativeTime } from "../lib/ui/dom";
  import { apiEndpoint } from "../lib/core/http";
  import { onPageReady } from "../lib/core/page";
  import type { Notification } from "../lib/core/types";
  import { userPath } from "../lib/core/urls";

  function noticeTarget(notice: Notification): string | null {
    if (
      notice.post &&
      (notice.type === "reply" ||
        notice.type === "like" ||
        notice.type === "repost")
    ) {
      const path = `/post/${encodeURIComponent(notice.post.authorHandle)}/${encodeURIComponent(notice.post.slug)}`;
      return notice.type === "reply" && notice.comment
        ? `${path}#comment-${encodeURIComponent(notice.comment.id)}`
        : path;
    }
    if (notice.actor && notice.type === "follow") {
      return `/user/${encodeURIComponent(notice.actor.handle)}`;
    }
    return null;
  }

  function noticeMessage(notice: Notification): {
    action: string;
    detail: string;
  } {
    if (notice.type === "reply") {
      return {
        action: "回帖了你的帖子",
        detail: notice.comment?.text ?? notice.post?.text ?? "",
      };
    }
    if (notice.type === "like") {
      return {
        action: "赞了你的帖子",
        detail: notice.post?.text ?? "",
      };
    }
    if (notice.type === "repost") {
      return {
        action: "转发了你的帖子",
        detail: notice.post?.text ?? "",
      };
    }
    if (notice.type === "follow") {
      return { action: "关注了你", detail: "查看对方的主页" };
    }
    return {
      action: String(notice.data.title ?? "系统通知"),
      detail: String(notice.data.body ?? ""),
    };
  }

  function noticeAvatar(notice: Notification): HTMLElement {
    if (!notice.actor) {
      const avatar = el("span", "notice-avatar");
      avatar.classList.add("is-system");
      avatar.textContent = "SYS";
      return avatar;
    }
    const avatar = el("a", "notice-avatar avatar-link");
    avatar.href = userPath(notice.actor.handle);
    avatar.dataset.handle = notice.actor.handle;
    avatar.setAttribute("aria-label", `查看 ${notice.actor.name} 的主页`);
    avatar.setAttribute("style", avatarGradient(notice.actor.handle));
    const image = el("img", "avatar-image");
    image.src = notice.actor.avatarUrl
      ? notice.actor.avatarUrl.startsWith("/")
        ? apiEndpoint(notice.actor.avatarUrl)
        : notice.actor.avatarUrl
      : "/user.avif";
    image.alt = "";
    image.loading = "lazy";
    image.decoding = "async";
    image.fetchPriority = "low";
    avatar.append(image);
    return avatar;
  }

  const mount = async () => {
    const container = document.querySelector<HTMLElement>("[data-notice]");
    if (!container || container.dataset.noticeMounted === "true") return;
    container.dataset.noticeMounted = "true";

    const list = container.querySelector<HTMLElement>(
      "[data-role=notice-list]",
    )!;
    const summary = container.querySelector<HTMLElement>(
      "[data-role=notice-summary]",
    )!;
    const readAll = container.querySelector<HTMLButtonElement>(
      "[data-role=notice-read-all]",
    )!;
    const more = container.querySelector<HTMLButtonElement>(
      "[data-role=notice-more]",
    )!;
    const refresh = container.querySelector<HTMLButtonElement>(
      "[data-role=notice-refresh]",
    );

    const current = await hydrateSession();
    if (!current) {
      summary.textContent = "登录后查看通知";
      const link = el("a", "primary-btn notice-login");
      link.href = "/";
      link.textContent = "返回首页登录";
      list.append(link);
      return;
    }

    let cursor: string | null = null;
    let unread = 0;
    const seen = new Set<string>();

    const updateSummary = () => {
      summary.textContent =
        unread > 0 ? `${unread} 条未读通知` : "没有未读通知";
      readAll.disabled = unread === 0;
    };

    const markRead = async (
      notice: Notification,
      item: HTMLElement,
    ): Promise<void> => {
      if (notice.read) return;
      notice.read = true;
      unread = Math.max(0, unread - 1);
      item.classList.remove("is-unread");
      updateSummary();
      try {
        await markNotificationsRead(notice.id, true);
      } catch {
        notice.read = false;
        unread += 1;
        item.classList.add("is-unread");
        updateSummary();
      }
    };

    const noticeById = new Map<string, Notification>();
    const readObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const item = entry.target as HTMLElement;
          const notice = noticeById.get(item.dataset.noticeId ?? "");
          readObserver.unobserve(item);
          if (notice) void markRead(notice, item);
        }
      },
      { threshold: 0.45 },
    );

    const render = (notices: Notification[], append: boolean) => {
      if (!append) {
        seen.clear();
        noticeById.clear();
        list.replaceChildren();
        unread = 0;
      }
      for (const notice of notices) {
        if (seen.has(notice.id)) continue;
        seen.add(notice.id);
        if (!notice.read) unread += 1;

        const item = el("article", "notice-item");
        item.dataset.noticeId = notice.id;
        item.classList.toggle("is-unread", !notice.read);
        noticeById.set(notice.id, notice);
        const target = noticeTarget(notice);
        const message = noticeMessage(notice);
        const actor = el("div", "notice-actor");
        const actorCopy = el("div", "notice-actor-copy");
        const actorNameLine = el("div", "notice-actor-name");
        const actorName = el("strong");
        actorName.textContent = notice.actor?.name ?? "系统";
        actorNameLine.append(actorName);
        if (notice.actor?.verified) {
          actorNameLine.insertAdjacentHTML("beforeend", ICONS.verified);
        }
        const actorMeta = el("span", "notice-actor-handle");
        actorMeta.textContent = notice.actor
          ? `@${notice.actor.handle}`
          : "FuckXter 官方通知";
        const time = el("time", "notice-time");
        time.dateTime = notice.createdAt;
        time.textContent = relativeTime(notice.createdAt);
        const action = el("span", "notice-action");
        action.textContent = message.action;
        actorCopy.append(actorNameLine, actorMeta, action, time);
        actor.append(noticeAvatar(notice), actorCopy);

        const content = el("div", "notice-content");
        const detail = el("p", "notice-text");
        detail.textContent =
          message.detail || (target ? "点击查看详情" : "暂无更多内容");
        content.append(detail);
        const openNotice = (event: Event) => {
          const actorLink = (
            event.target as HTMLElement
          ).closest<HTMLAnchorElement>(".notice-avatar.avatar-link");
          if (actorLink?.dataset.handle) {
            event.preventDefault();
            void markRead(notice, item);
            location.href = userPath(actorLink.dataset.handle);
            return;
          }
          void markRead(notice, item);
          if (!target) return;
          event.preventDefault();
          location.href = target;
        };
        item.tabIndex = 0;
        item.setAttribute("role", target ? "link" : "button");
        item.addEventListener("click", openNotice);
        item.addEventListener("keydown", (event) => {
          if (event.key !== "Enter" && event.key !== " ") return;
          event.preventDefault();
          openNotice(event);
        });

        item.append(actor, content);
        list.append(item);
        if (!notice.read) readObserver.observe(item);
      }
      updateSummary();
    };

    let loading = false;
    const load = async (append: boolean, silent = false) => {
      if (loading || (append && !cursor)) return;
      loading = true;
      more.disabled = true;
      if (refresh) refresh.disabled = true;
      try {
        const page = await getNotifications(append ? cursor : null);
        cursor = page.nextCursor;
        render(page.notices, append);
        if (!append) {
          unread = page.unread;
          updateSummary();
        }
        more.hidden = !cursor;
      } catch (error) {
        if (!silent) {
          summary.textContent =
            error instanceof Error ? error.message : "通知加载失败";
        }
      } finally {
        loading = false;
        more.disabled = false;
        if (refresh) refresh.disabled = false;
      }
    };

    readAll.addEventListener("click", async () => {
      readAll.disabled = true;
      try {
        await markNotificationsRead();
        unread = 0;
        for (const item of list.querySelectorAll(".notice-item")) {
          item.classList.remove("is-unread");
        }
        updateSummary();
      } catch (error) {
        summary.textContent =
          error instanceof Error ? error.message : "操作失败";
        readAll.disabled = false;
      }
    });

    more.addEventListener("click", () => void load(true));
    refresh?.addEventListener("click", () => void load(false));

    const refreshInterval = window.setInterval(() => {
      if (document.visibilityState === "visible") void load(false, true);
    }, 30_000);
    const onVisibilityChange = () => {
      if (document.visibilityState === "visible") void load(false, true);
    };
    document.addEventListener("visibilitychange", onVisibilityChange);
    document.addEventListener(
      "astro:before-swap",
      () => {
        window.clearInterval(refreshInterval);
        readObserver.disconnect();
        document.removeEventListener("visibilitychange", onVisibilityChange);
      },
      { once: true },
    );
    await load(false);
  };

  onPageReady(() => {
    void mount();
  });
</script>
