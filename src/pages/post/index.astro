---
import "../../styles/fuckxter/style.css";

import FuckxterLayout from "../../layouts/FuckxterLayout.astro";
import FuckxterSubpageHeader from "../../components/FuckxterSubpageHeader.astro";
---

<FuckxterLayout title="详情">
  <div class="fk-app fk-subpage" data-fk-post>
    <FuckxterSubpageHeader />

    <div class="fk-post-layout">
      <div class="fk-post-main">
        <div class="fk-post-main-inner" data-role="post-detail">
          <p class="fk-status">加载中…</p>
        </div>
      </div>
      <aside class="fk-post-side" data-role="post-side" hidden></aside>
    </div>
  </div>
</FuckxterLayout>

<script>
  import { navigate } from "astro:transitions/client";
  import {
    createComment,
    deleteComment,
    deletePost,
    getComments,
    getPostByPath,
    setFollow,
    toggleLike,
    toggleRepost,
  } from "../../lib/fuckxter/api";
  import {
    getAccount,
    hydrateSession,
    requestAuthentication,
  } from "../../lib/fuckxter/auth";
  import {
    actionButton,
    authorAvatar,
    el,
    followButton,
    fmtCount,
    ICONS,
    renderRichText,
    setFollowButtonState,
    showToast,
    statusRow,
  } from "../../lib/fuckxter/dom";
  import { ApiError, apiEndpoint } from "../../lib/fuckxter/http";
  import { onFuckxterPageReady } from "../../lib/fuckxter/page";
  import { openPostShareMenu } from "../../lib/fuckxter/share";
  import type { Comment, Post } from "../../lib/fuckxter/types";
  import { parsePostPath, postPath, userPath } from "../../lib/fuckxter/urls";

  const fullTime = (iso: string) =>
    new Date(iso).toLocaleString("zh-CN", {
      dateStyle: "long",
      timeStyle: "short",
    });

  const formatBytes = (bytes: number): string => {
    if (bytes < 1024) return `${bytes} B`;
    if (bytes < 1024 * 1024) return `${Math.round(bytes / 1024)} KB`;
    return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
  };

  function renderPostInfo(post: Post): HTMLElement {
    const box = el("section", "fk-post-info");
    const title = el("h4", "fk-post-info-title");
    title.textContent = "详情";
    const author = el("div", "fk-post-info-author");
    const avatar = authorAvatar(
      post.author.handle,
      post.author.name,
      "fk-avatar",
      post.author.avatarUrl,
    );
    const who = el("div");
    const name = el("strong");
    name.textContent = post.author.name;
    const handle = el("small");
    handle.textContent = `@${post.author.handle}`;
    who.append(name, handle);
    author.append(avatar, who, followButton(post));

    const rows = el("dl", "fk-post-info-rows");
    const row = (label: string, value: string) => {
      const dt = el("dt");
      dt.textContent = label;
      const dd = el("dd");
      dd.textContent = value;
      rows.append(dt, dd);
    };
    row("发布时间", fullTime(post.createdAt));
    row("帖子 ID", post.id);
    row("正文字数", `${[...post.text].length} 字`);
    row(
      "互动数据",
      `${post.stats.replies} 回帖 · ${post.stats.reposts} 转发 · ${post.stats.likes} 喜欢`,
    );
    row(
      "媒体文件",
      post.media
        ? `${post.media.contentType.replace("image/", "").toUpperCase()} · ${formatBytes(post.media.byteSize)}`
        : "无",
    );
    if (post.media?.alt) row("媒体描述", post.media.alt);

    box.append(title, author, rows);
    return box;
  }

  function renderPostControls(post: Post): HTMLElement {
    const box = el("section", "fk-post-controls");
    const title = el("h4", "fk-post-controls-title");
    title.textContent = "互动";

    const actions = el("div", "fk-post-control-actions");
    actions.append(
      actionButton("reply", ICONS.reply, "回帖", post.stats.replies),
      actionButton("repost", ICONS.repost, "转发", post.stats.reposts),
      actionButton("like", ICONS.heart, "喜欢", post.stats.likes),
      actionButton("share", ICONS.share, "分享", 0),
    );

    if (post.viewer?.isAuthor) {
      const remove = actionButton("delete", ICONS.trash, "删除", 0);
      remove.classList.add("is-danger");
      actions.append(remove);
    }

    const repostBtn = actions.querySelector<HTMLButtonElement>(
      '[data-action="repost"]',
    )!;
    const likeBtn = actions.querySelector<HTMLButtonElement>(
      '[data-action="like"]',
    )!;
    repostBtn.classList.toggle("is-reposted", Boolean(post.viewer?.reposted));
    likeBtn.classList.toggle("is-liked", Boolean(post.viewer?.liked));

    const setCount = (btn: HTMLButtonElement, count: number) => {
      btn.dataset.count = String(count);
      btn.querySelector<HTMLElement>(".fk-action-count")!.textContent =
        count > 0 ? fmtCount(count) : "";
    };

    actions.addEventListener("click", async (event) => {
      const btn = (event.target as HTMLElement).closest<HTMLButtonElement>(
        ".fk-action",
      );
      if (!btn) return;
      const action = btn.dataset.action;

      if (action === "reply") {
        if (!getAccount()) {
          requestAuthentication();
          return;
        }
        const input =
          document.querySelector<HTMLTextAreaElement>(".fk-comment-input");
        input?.scrollIntoView({ behavior: "smooth", block: "center" });
        input?.focus();
        return;
      }

      if (action === "like" || action === "repost") {
        const activeClass = action === "like" ? "is-liked" : "is-reposted";
        const willActive = !btn.classList.contains(activeClass);
        const current = Number(btn.dataset.count ?? "0");
        setCount(btn, Math.max(0, current + (willActive ? 1 : -1)));
        btn.classList.toggle(activeClass, willActive);
        try {
          if (action === "like") {
            const result = await toggleLike(post.id, willActive);
            setCount(btn, result.likes);
            btn.classList.toggle(activeClass, result.liked);
          } else {
            const result = await toggleRepost(post.id, willActive);
            setCount(btn, result.reposts);
            btn.classList.toggle(activeClass, result.reposted);
          }
        } catch {
          setCount(btn, current);
          btn.classList.toggle(activeClass, !willActive);
        }
        return;
      }

      if (action === "delete") {
        if (!confirm("确定删除这条帖子吗？")) return;
        btn.disabled = true;
        try {
          await deletePost(post.id);
          navigate("/");
        } catch (error) {
          btn.disabled = false;
          btn.title = error instanceof Error ? error.message : "删除失败";
        }
        return;
      }

      if (action === "share") {
        const result = await openPostShareMenu(btn, post);
        if (result === "copied") showToast("链接已复制");
        if (result === "shared") showToast("已分享");
        if (result === "failed") showToast("分享失败");
      }
    });

    box.append(title, actions);
    return box;
  }

  function threadAuthorLine(
    author: Comment["author"],
    createdAt: string,
  ): HTMLElement {
    const head = el("header", "fk-thread-meta");
    const who = el("div", "fk-thread-who");
    const name = el("strong");
    name.textContent = author.name;
    who.append(name);
    if (author.verified) who.insertAdjacentHTML("beforeend", ICONS.verified);
    const handle = el("span", "fk-thread-handle");
    handle.textContent = `@${author.handle}`;
    const time = el("time");
    time.dateTime = createdAt;
    time.textContent = fullTime(createdAt);
    who.append(handle);
    head.append(who, time);
    return head;
  }

  function renderOriginPost(post: Post): HTMLElement {
    const article = el("article", "fk-thread-post fk-thread-origin");
    const kind = el("span", "fk-thread-kind");
    kind.textContent = "发起";
    const avatar = authorAvatar(
      post.author.handle,
      post.author.name,
      "fk-avatar",
      post.author.avatarUrl,
    );
    const body = el("div", "fk-thread-body");
    body.append(threadAuthorLine(post.author, post.createdAt));
    const text = el("p", "fk-thread-text");
    text.append(renderRichText(post.text));
    body.append(text);
    if (post.media) {
      const media = el("div", "fk-media");
      const image = el("img", "fk-media-image");
      image.src = post.media.url.startsWith("/")
        ? apiEndpoint(post.media.url)
        : post.media.url;
      image.alt = post.media.alt;
      image.loading = "eager";
      image.decoding = "async";
      image.referrerPolicy = "no-referrer";
      media.append(image);
      body.append(media);
    }
    article.append(kind, avatar, body);
    return article;
  }

  function renderReply(
    postId: string,
    comment: Comment,
    canModerate: boolean,
    replyTo: (handle: string) => void,
    refreshComments: () => Promise<void>,
    status: HTMLElement,
  ): HTMLElement {
    const article = el("article", "fk-thread-post fk-thread-reply");
    article.id = `comment-${comment.id}`;
    const kind = el("span", "fk-thread-kind");
    kind.textContent = "回帖";
    const avatar = authorAvatar(
      comment.author.handle,
      comment.author.name,
      "fk-avatar",
      comment.author.avatarUrl,
    );
    const body = el("div", "fk-thread-body");
    body.append(threadAuthorLine(comment.author, comment.createdAt));
    const text = el("p", "fk-thread-text");
    text.append(renderRichText(comment.text));
    body.append(text);

    const actions = el("footer", "fk-thread-reply-actions");
    const reply = el("button", "fk-thread-link-btn");
    reply.type = "button";
    reply.textContent = "回复";
    reply.addEventListener("click", () => replyTo(comment.author.handle));
    actions.append(reply);

    const me = getAccount();
    if (me && (canModerate || comment.author.handle === me.profile.handle)) {
      const remove = el("button", "fk-thread-link-btn is-danger");
      remove.type = "button";
      remove.textContent = "删除";
      remove.addEventListener("click", async () => {
        if (!confirm("确定删除这条回帖吗？")) return;
        remove.disabled = true;
        try {
          await deleteComment(postId, comment.id);
          await refreshComments();
        } catch (error) {
          remove.disabled = false;
          status.textContent =
            error instanceof Error ? error.message : "删除失败";
        }
      });
      actions.append(remove);
    }
    body.append(actions);
    article.append(kind, avatar, body);
    return article;
  }

  function renderThread(
    post: Post,
    canModerate: boolean,
    onReplyCountChange: (count: number) => void,
  ): HTMLElement {
    const thread = el("section", "fk-thread");
    const head = el("header", "fk-thread-head");
    const title = el("h1");
    title.textContent = "帖子线程";
    const hint = el("p");
    hint.textContent = "发起与回帖按时间排列";
    head.append(title, hint);

    const replies = el("section", "fk-thread-replies");
    const repliesHead = el("header", "fk-replies-head");
    const repliesTitle = el("h2");
    repliesTitle.textContent = "回帖";
    const repliesCount = el("span");
    repliesCount.textContent = "0";
    repliesHead.append(repliesTitle, repliesCount);

    const me = getAccount();
    const input = el("textarea", "fk-comment-input") as HTMLTextAreaElement;
    input.rows = 2;
    input.placeholder = me ? "写下你的回帖" : "登录后才能回帖";
    input.disabled = !me;
    const submit = el("button", "fk-primary-btn fk-comment-submit");
    submit.type = "button";
    submit.textContent = "回帖";
    submit.disabled = !me;
    const composer = el("div", "fk-comments-composer fk-thread-composer");
    composer.append(input, submit);

    const status = el("p", "fk-thread-status");
    status.setAttribute("aria-live", "polite");
    const list = el("div", "fk-comments-list fk-thread-list");

    const replyTo = (handle: string) => {
      if (!me) {
        requestAuthentication();
        return;
      }
      const prefix = `@${handle} `;
      input.value = input.value.startsWith(prefix)
        ? input.value
        : `${prefix}${input.value}`;
      input.focus();
      input.setSelectionRange(input.value.length, input.value.length);
      composer.scrollIntoView({ behavior: "smooth", block: "center" });
    };

    let renderedComments: Comment[] = [];
    const renderList = (comments: Comment[], total = comments.length): void => {
      renderedComments = comments;
      repliesCount.textContent =
        total > comments.length ? `${comments.length}/${total}` : String(total);
      repliesCount.title =
        total > comments.length ? `仅显示最近 ${comments.length} 条回帖` : "";
      onReplyCountChange(total);
      list.replaceChildren(
        ...(comments.length === 0
          ? [
              (() => {
                const empty = el("div", "fk-comments-empty");
                const emptyTitle = el("strong");
                emptyTitle.textContent = "还没有回帖";
                const emptyHint = el("span");
                emptyHint.textContent = "来发布第一条回帖吧。";
                empty.append(emptyTitle, emptyHint);
                return empty;
              })(),
            ]
          : comments.map((comment) =>
              renderReply(
                post.id,
                comment,
                canModerate,
                replyTo,
                refreshComments,
                status,
              ),
            )),
      );
    };

    const refreshComments = async () => {
      try {
        const page = await getComments(post.id);
        renderList(page.comments, page.total);
        if (location.hash.startsWith("#comment-")) {
          requestAnimationFrame(() => {
            document
              .getElementById(decodeURIComponent(location.hash.slice(1)))
              ?.scrollIntoView({ behavior: "smooth", block: "center" });
          });
        }
      } catch (error) {
        renderList([], 0);
        status.textContent =
          error instanceof Error ? error.message : "回帖加载失败";
      }
    };

    submit.addEventListener("click", async () => {
      const text = input.value.trim();
      if (!text || !me) return;
      submit.disabled = true;
      try {
        await createComment(post.id, text);
        input.value = "";
        status.textContent = "";
        await refreshComments();
        const latest = renderedComments.at(-1);
        if (latest) {
          document
            .getElementById(`comment-${latest.id}`)
            ?.scrollIntoView({ behavior: "smooth", block: "center" });
        }
      } catch (error) {
        status.textContent =
          error instanceof Error ? error.message : "回帖失败";
      } finally {
        submit.disabled = false;
      }
    });

    replies.append(repliesHead, composer, status, list);
    thread.append(head, renderOriginPost(post), replies);
    if (location.hash === "#reply" && me) {
      requestAnimationFrame(() => {
        composer.scrollIntoView({ behavior: "smooth", block: "center" });
        input.focus();
      });
    }
    void refreshComments();
    return thread;
  }

  const mount = async () => {
    const container = document.querySelector<HTMLElement>("[data-fk-post]");
    if (!container) return;
    if (container.dataset.fkPostMounted === "true") return;
    container.dataset.fkPostMounted = "true";
    await hydrateSession();

    container
      .querySelector<HTMLButtonElement>("[data-role=back]")!
      .addEventListener("click", () =>
        history.length > 1 ? history.back() : (location.href = "/"),
      );

    const layout = container.querySelector<HTMLElement>(".fk-post-layout")!;
    layout.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      const follow = target.closest<HTMLButtonElement>(".fk-follow-btn");
      if (follow?.dataset.handle) {
        if (!getAccount()) {
          requestAuthentication();
          return;
        }
        follow.disabled = true;
        const following = follow.dataset.following !== "true";
        void setFollow(follow.dataset.handle, following)
          .then((result) => setFollowButtonState(follow, result.following))
          .catch((error: unknown) => {
            if (error instanceof ApiError && error.status === 401) {
              requestAuthentication();
            }
          })
          .finally(() => {
            follow.disabled = false;
          });
        return;
      }

      const avatarLink = target.closest<HTMLElement>(".fk-avatar-link");
      if (avatarLink?.dataset.handle) {
        event.preventDefault();
        navigate(userPath(avatarLink.dataset.handle));
      }
    });

    const parsedPath = parsePostPath(location.pathname);
    const host = container.querySelector<HTMLElement>(
      "[data-role=post-detail]",
    )!;
    const side = container.querySelector<HTMLElement>("[data-role=post-side]")!;

    const postRequest = parsedPath
      ? getPostByPath(parsedPath.handle, parsedPath.slug)
      : Promise.resolve(null);

    void postRequest
      .then((post) => {
        if (!post) {
          host.replaceChildren(
            statusRow("没有找到这条帖子，可能还未加载或已失效。"),
          );
          return;
        }
        if (!parsedPath) {
          history.replaceState(null, "", postPath(post));
        }
        document.title = `${post.author.name}：${post.text.slice(0, 30)} | FuckXter`;
        const controls = renderPostControls(post);
        const thread = renderThread(
          post,
          getAccount()?.profile.handle === post.author.handle,
          (count) => {
            post.stats.replies = count;
            const reply = controls.querySelector<HTMLButtonElement>(
              '[data-action="reply"]',
            );
            if (!reply) return;
            reply.dataset.count = String(count);
            reply.querySelector<HTMLElement>(".fk-action-count")!.textContent =
              count > 0 ? fmtCount(count) : "";
          },
        );
        host.replaceChildren(thread);
        side.replaceChildren(renderPostInfo(post), controls);
        side.hidden = false;
      })
      .catch((error: unknown) => {
        host.replaceChildren(
          statusRow(error instanceof Error ? error.message : "帖子加载失败。"),
        );
      });
  };

  onFuckxterPageReady(() => {
    void mount();
  });
</script>
