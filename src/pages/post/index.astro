---
import "../../styles/post.css";

import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
---

<Layout title="详情">
  <div class="fk-app fk-subpage" data-fk-post>
    <Header />

    <div class="fk-post-layout">
      <div class="fk-post-main">
        <div class="fk-post-main-inner" data-role="post-detail">
          <section class="fk-thread" aria-label="正在加载帖子">
            <header class="fk-thread-head">
              <h1>帖子线程</h1>
              <p>发起与回帖按时间排列</p>
            </header>

            <article class="fk-thread-post fk-thread-origin fk-post-skeleton">
              <span class="fk-skeleton fk-skeleton-pill"></span>
              <span class="fk-skeleton fk-skeleton-avatar"></span>
              <div class="fk-skeleton-copy">
                <span class="fk-skeleton fk-skeleton-line is-short"></span>
                <span class="fk-skeleton fk-skeleton-line"></span>
                <span class="fk-skeleton fk-skeleton-line is-medium"></span>
              </div>
            </article>

            <section class="fk-thread-replies">
              <header class="fk-replies-head">
                <h2>回帖</h2>
                <span>加载中</span>
              </header>
            </section>
          </section>
        </div>
      </div>
      <aside class="fk-post-side" data-role="post-side" aria-label="帖子信息">
        <section class="fk-post-info">
          <h4 class="fk-post-info-title">详情</h4>
          <div class="fk-detail-skeleton">
            <span class="fk-skeleton fk-skeleton-avatar is-small"></span>
            <span class="fk-skeleton fk-skeleton-line is-medium"></span>
            <span class="fk-skeleton fk-skeleton-line"></span>
          </div>
        </section>
        <section class="fk-post-controls">
          <h4 class="fk-post-controls-title">互动</h4>
          <div class="fk-control-skeleton">
            <span class="fk-skeleton fk-skeleton-button"></span>
            <span class="fk-skeleton fk-skeleton-button"></span>
            <span class="fk-skeleton fk-skeleton-button"></span>
          </div>
        </section>
      </aside>
    </div>
  </div>
</Layout>

<script>
  import { navigate } from "astro:transitions/client";
  import {
    createComment,
    createPost,
    deleteComment,
    deletePost,
    getComments,
    getPostByPath,
    getTimeline,
    recordPostView,
    setFollow,
    toggleLike,
    toggleCommentLike,
    toggleCommentRepost,
    toggleRepost,
  } from "../../lib/fuckxter/api";
  import {
    getAccount,
    hydrateSession,
    requestAuthentication,
  } from "../../lib/fuckxter/auth";
  import {
    actionButton,
    authorAvatar,
    el,
    followButton,
    fmtCount,
    ICONS,
    renderRichText,
    setFollowButtonState,
    showToast,
    statusRow,
  } from "../../lib/fuckxter/dom";
  import { ApiError, apiEndpoint } from "../../lib/fuckxter/http";
  import { onFuckxterPageReady } from "../../lib/fuckxter/page";
  import { openPostShareMenu } from "../../lib/fuckxter/share";
  import type { Comment, Post } from "../../lib/fuckxter/types";
  import { parsePostPath, postPath, userPath } from "../../lib/fuckxter/urls";

  const fullTime = (iso: string) =>
    new Date(iso).toLocaleString("zh-CN", {
      dateStyle: "long",
      timeStyle: "short",
    });

  const formatBytes = (bytes: number): string => {
    if (bytes < 1024) return `${bytes} B`;
    if (bytes < 1024 * 1024) return `${Math.round(bytes / 1024)} KB`;
    return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
  };

  const MAX_COMMENT_CHARS = 1000;

  function renderPostInfo(post: Post): HTMLElement {
    const box = el("section", "fk-post-info");
    const title = el("h4", "fk-post-info-title");
    title.textContent = "详情";
    const author = el("div", "fk-post-info-author");
    const avatar = authorAvatar(
      post.author.handle,
      post.author.name,
      "fk-avatar",
      post.author.avatarUrl,
    );
    const who = el("div");
    const name = el("strong");
    name.textContent = post.author.name;
    const handle = el("small");
    handle.textContent = `@${post.author.handle}`;
    who.append(name, handle);
    author.append(avatar, who, followButton(post));

    const rows = el("dl", "fk-post-info-rows");
    const row = (label: string, value: string) => {
      const dt = el("dt");
      dt.textContent = label;
      const dd = el("dd");
      dd.textContent = value;
      rows.append(dt, dd);
    };
    row("发布时间", fullTime(post.createdAt));
    row("帖子 ID", post.id);
    row("正文字数", `${[...post.text].length} 字`);
    row(
      "互动数据",
      `${post.stats.replies} 回帖 · ${post.stats.reposts} 转发 · ${post.stats.likes} 喜欢 · ${fmtCount(post.stats.views ?? 0)} 次浏览`,
    );
    row(
      "媒体文件",
      post.media
        ? `${post.media.contentType.replace("image/", "").toUpperCase()} · ${formatBytes(post.media.byteSize)}`
        : "无",
    );
    if (post.media?.alt) row("媒体描述", post.media.alt);

    box.append(title, author, rows);
    return box;
  }

  function renderHotPosts(
    posts: Post[] | null,
    currentId: string,
  ): HTMLElement {
    const box = el("section", "fk-hot-posts");
    const title = el("h4", "fk-hot-title");
    title.textContent = "热门帖子";
    const hint = el("p", "fk-hot-hint");
    hint.textContent = "按浏览热度排序";
    const list = el("div", "fk-hot-list");

    if (posts === null) {
      list.append(statusRow("正在加载…"));
    } else {
      const items = posts.filter((item) => item.id !== currentId).slice(0, 5);
      if (items.length === 0) {
        list.append(statusRow("暂时没有其他热门帖子。"));
      }
      items.forEach((item, index) => {
        const row = el("a", "fk-hot-item");
        row.href = postPath(item);
        row.dataset.postId = item.id;

        const rank = el("span", "fk-hot-rank");
        rank.textContent = String(index + 1);

        const body = el("span", "fk-hot-body");
        const meta = el("span", "fk-hot-meta");
        meta.textContent = `${item.author.name} · @${item.author.handle}`;
        const text = el("span", "fk-hot-text");
        text.textContent = item.text;
        const views = el("span", "fk-hot-views");
        views.textContent = `${fmtCount(item.stats.views ?? 0)} 次浏览`;
        body.append(meta, text, views);

        row.append(rank, body);
        list.append(row);
      });
    }

    box.append(title, hint, list);
    return box;
  }

  function renderPostControls(post: Post): HTMLElement {
    const box = el("section", "fk-post-controls");
    const title = el("h4", "fk-post-controls-title");
    title.textContent = "互动";

    const actions = el("div", "fk-post-control-actions");
    actions.append(
      actionButton("reply", ICONS.reply, "回帖", post.stats.replies),
      actionButton("repost", ICONS.repost, "转发", post.stats.reposts),
      actionButton("like", ICONS.heart, "喜欢", post.stats.likes),
      actionButton("share", ICONS.share, "分享", 0),
    );

    if (post.viewer?.isAuthor) {
      const remove = actionButton("delete", ICONS.trash, "删除", 0);
      remove.classList.add("is-danger");
      actions.append(remove);
    }

    const repostBtn = actions.querySelector<HTMLButtonElement>(
      '[data-action="repost"]',
    )!;
    const likeBtn = actions.querySelector<HTMLButtonElement>(
      '[data-action="like"]',
    )!;
    repostBtn.classList.toggle("is-reposted", Boolean(post.viewer?.reposted));
    likeBtn.classList.toggle("is-liked", Boolean(post.viewer?.liked));

    const setCount = (btn: HTMLButtonElement, count: number) => {
      btn.dataset.count = String(count);
      btn.querySelector<HTMLElement>(".fk-action-count")!.textContent =
        count > 0 ? fmtCount(count) : "";
    };

    actions.addEventListener("click", async (event) => {
      const btn = (event.target as HTMLElement).closest<HTMLButtonElement>(
        ".fk-action",
      );
      if (!btn) return;
      const action = btn.dataset.action;

      if (action === "reply") {
        if (!getAccount()) {
          requestAuthentication();
          return;
        }
        const input =
          document.querySelector<HTMLTextAreaElement>(".fk-comment-input");
        input?.scrollIntoView({ behavior: "smooth", block: "center" });
        input?.focus();
        return;
      }

      if (action === "like" || action === "repost") {
        const activeClass = action === "like" ? "is-liked" : "is-reposted";
        const willActive = !btn.classList.contains(activeClass);
        const current = Number(btn.dataset.count ?? "0");
        setCount(btn, Math.max(0, current + (willActive ? 1 : -1)));
        btn.classList.toggle(activeClass, willActive);
        try {
          if (action === "like") {
            const result = await toggleLike(post.id, willActive);
            setCount(btn, result.likes);
            btn.classList.toggle(activeClass, result.liked);
          } else {
            const result = await toggleRepost(post.id, willActive);
            setCount(btn, result.reposts);
            btn.classList.toggle(activeClass, result.reposted);
          }
        } catch {
          setCount(btn, current);
          btn.classList.toggle(activeClass, !willActive);
        }
        return;
      }

      if (action === "delete") {
        if (!confirm("确定删除这条帖子吗？")) return;
        btn.disabled = true;
        try {
          await deletePost(post.id);
          navigate("/");
        } catch (error) {
          btn.disabled = false;
          btn.title = error instanceof Error ? error.message : "删除失败";
        }
        return;
      }

      if (action === "share") {
        const result = await openPostShareMenu(btn, post);
        if (result === "copied") showToast("链接已复制");
        if (result === "shared") showToast("已分享");
        if (result === "failed") showToast("分享失败");
      }
    });

    box.append(title, actions);
    return box;
  }

  function threadAuthorLine(
    author: Comment["author"],
    createdAt: string,
  ): HTMLElement {
    const head = el("header", "fk-thread-meta");
    const who = el("div", "fk-thread-who");
    const name = el("strong");
    name.textContent = author.name;
    who.append(name);
    if (author.verified) who.insertAdjacentHTML("beforeend", ICONS.verified);
    const handle = el("span", "fk-thread-handle");
    handle.textContent = `@${author.handle}`;
    const time = el("time");
    time.dateTime = createdAt;
    time.textContent = fullTime(createdAt);
    who.append(handle);
    head.append(who, time);
    return head;
  }

  function renderOriginPost(post: Post): HTMLElement {
    const article = el("article", "fk-thread-post fk-thread-origin");
    const kind = el("span", "fk-thread-kind");
    kind.textContent = "发起";
    const avatar = authorAvatar(
      post.author.handle,
      post.author.name,
      "fk-avatar",
      post.author.avatarUrl,
    );
    const body = el("div", "fk-thread-body");
    body.append(threadAuthorLine(post.author, post.createdAt));
    const text = el("p", "fk-thread-text");
    text.append(renderRichText(post.text));
    body.append(text);
    if (post.media) {
      const media = el("div", "fk-media");
      const image = el("img", "fk-media-image");
      image.src = post.media.url.startsWith("/")
        ? apiEndpoint(post.media.url)
        : post.media.url;
      image.alt = post.media.alt;
      image.loading = "eager";
      image.decoding = "async";
      image.referrerPolicy = "no-referrer";
      media.append(image);
      body.append(media);
    }
    article.append(kind, avatar, body);
    return article;
  }

  function renderReply(
    postId: string,
    comment: Comment,
    canModerate: boolean,
    replyTo: (handle: string, commentId?: string) => void,
    refreshComments: () => Promise<void>,
    status: HTMLElement,
    nested: boolean,
  ): HTMLElement {
    const article = el("article", "fk-thread-post fk-thread-reply");
    article.id = `comment-${comment.id}`;
    const kind = el("span", "fk-thread-kind");
    kind.textContent = "回帖";
    const avatar = authorAvatar(
      comment.author.handle,
      comment.author.name,
      "fk-avatar",
      comment.author.avatarUrl,
    );
    const body = el("div", "fk-thread-body");
    body.append(threadAuthorLine(comment.author, comment.createdAt));
    if (comment.parent && !nested) {
      const quote = el("button", "fk-reply-quote");
      quote.type = "button";
      const who = el("strong");
      who.textContent = `回覆 @${comment.parent.handle}`;
      const snippet = el("span");
      snippet.textContent = `：${comment.parent.text.replace(/\s+/g, " ").slice(0, 40)}`;
      quote.append(who, snippet);
      quote.addEventListener("click", () => {
        document
          .getElementById(`comment-${comment.parent!.id}`)
          ?.scrollIntoView({ behavior: "smooth", block: "center" });
      });
      body.append(quote);
    }
    const text = el("p", "fk-thread-text");
    text.append(renderRichText(comment.text));
    body.append(text);

    const actions = el("footer", "fk-thread-reply-actions");
    const reply = el("button", "fk-thread-link-btn");
    reply.type = "button";
    reply.textContent = "回复";
    reply.addEventListener("click", () =>
      replyTo(comment.author.handle, comment.id),
    );
    actions.append(reply);

    const like = actionButton("like", ICONS.heart, "喜欢", comment.stats.likes);
    const repost = actionButton(
      "repost",
      ICONS.repost,
      "转发",
      comment.stats.reposts,
    );
    like.classList.toggle("is-liked", comment.viewer.liked);
    repost.classList.toggle("is-reposted", comment.viewer.reposted);
    const setCommentCount = (button: HTMLButtonElement, count: number) => {
      button.dataset.count = String(count);
      button.querySelector<HTMLElement>(".fk-action-count")!.textContent =
        count > 0 ? fmtCount(count) : "";
    };
    like.addEventListener("click", async () => {
      if (!getAccount()) {
        requestAuthentication();
        return;
      }
      const next = !like.classList.contains("is-liked");
      like.classList.toggle("is-liked", next);
      try {
        const result = await toggleCommentLike(postId, comment.id, next);
        comment.viewer.liked = result.liked;
        setCommentCount(like, result.likes);
        like.classList.toggle("is-liked", result.liked);
      } catch {
        like.classList.toggle("is-liked", !next);
      }
    });
    repost.addEventListener("click", async () => {
      if (!getAccount()) {
        requestAuthentication();
        return;
      }
      const next = !repost.classList.contains("is-reposted");
      repost.classList.toggle("is-reposted", next);
      try {
        const result = await toggleCommentRepost(postId, comment.id, next);
        comment.viewer.reposted = result.reposted;
        setCommentCount(repost, result.reposts);
        repost.classList.toggle("is-reposted", result.reposted);
      } catch {
        repost.classList.toggle("is-reposted", !next);
      }
    });
    const quote = actionButton("quote", ICONS.copy, "转贴", 0);
    quote.addEventListener("click", async () => {
      if (!getAccount()) {
        requestAuthentication();
        return;
      }
      const prefix = `转贴 @${comment.author.handle}：\n`;
      const text = [...`${prefix}${comment.text}`].slice(0, 1000).join("");
      quote.disabled = true;
      try {
        await createPost(text);
        showToast("已转贴");
      } catch (error) {
        showToast(error instanceof Error ? error.message : "转贴失败");
      } finally {
        quote.disabled = false;
      }
    });
    actions.append(like, repost, quote);

    const me = getAccount();
    if (me && (canModerate || comment.author.handle === me.profile.handle)) {
      const remove = el("button", "fk-thread-link-btn is-danger");
      remove.type = "button";
      remove.textContent = "删除";
      remove.addEventListener("click", async () => {
        if (!confirm("确定删除这条回帖吗？")) return;
        remove.disabled = true;
        try {
          await deleteComment(postId, comment.id);
          await refreshComments();
        } catch (error) {
          remove.disabled = false;
          status.textContent =
            error instanceof Error ? error.message : "删除失败";
        }
      });
      actions.append(remove);
    }
    body.append(actions);
    article.append(kind, avatar, body);
    return article;
  }

  function renderThread(
    post: Post,
    canModerate: boolean,
    onReplyCountChange: (count: number) => void,
  ): { thread: HTMLElement; composer: HTMLElement } {
    const thread = el("section", "fk-thread");
    const head = el("header", "fk-thread-head");
    const title = el("h1");
    title.textContent = "帖子线程";
    const hint = el("p");
    hint.textContent = "发起与回帖按时间排列";
    head.append(title, hint);

    const replies = el("section", "fk-thread-replies");
    const repliesHead = el("header", "fk-replies-head");
    const repliesTitle = el("h2");
    repliesTitle.textContent = "回帖";
    const repliesCount = el("span");
    repliesCount.textContent = "0";
    repliesHead.append(repliesTitle, repliesCount);

    const me = getAccount();
    const input = el(
      "textarea",
      "fk-comment-input fk-side-comment-input",
    ) as HTMLTextAreaElement;
    input.rows = 2;
    input.placeholder = me ? "写下你的回帖" : "登录后才能回帖";
    input.disabled = !me;
    const submit = el("button", "fk-primary-btn fk-comment-submit");
    submit.type = "button";
    submit.textContent = "回帖";
    submit.disabled = !me;
    const count = el("span", "fk-comment-count");
    count.textContent = `0 / ${MAX_COMMENT_CHARS}`;
    const composerActions = el("div", "fk-thread-composer-actions");
    composerActions.append(count, submit);
    const composer = el("section", "fk-thread-composer");
    const composerAvatar = me
      ? authorAvatar(
          me.profile.handle,
          me.profile.name,
          "fk-avatar",
          me.avatarUrl,
        )
      : el("span", "fk-avatar");
    const composerBody = el("div", "fk-composer-body");
    composerBody.append(input);

    const status = el("p", "fk-thread-status");
    status.setAttribute("aria-live", "polite");
    const list = el("div", "fk-comments-list fk-thread-list");

    const replyChip = el("div", "fk-reply-chip");
    const replyChipLabel = el("span", "fk-reply-chip-label");
    const replyChipClear = el("button", "fk-reply-chip-clear");
    replyChipClear.type = "button";
    replyChipClear.textContent = "×";
    replyChipClear.setAttribute("aria-label", "取消回覆");
    replyChip.append(replyChipLabel, replyChipClear);
    replyChip.hidden = true;
    let replyParent: string | null = null;
    const clearReplyTarget = () => {
      replyParent = null;
      replyChip.hidden = true;
      replyChipLabel.textContent = "";
    };
    replyChipClear.addEventListener("click", clearReplyTarget);

    composerBody.append(replyChip, status, composerActions);
    composer.append(composerAvatar, composerBody);

    const resizeCommentInput = () => {
      input.style.height = "auto";
      const maxHeight = matchMedia("(max-width: 900px)").matches ? 240 : 360;
      const nextHeight = Math.min(input.scrollHeight, maxHeight);
      input.style.height = `${nextHeight}px`;
      input.style.overflowY =
        input.scrollHeight > maxHeight ? "auto" : "hidden";
    };

    const syncCommentSubmit = () => {
      const length = [...input.value].length;
      count.textContent = `${length} / ${MAX_COMMENT_CHARS}`;
      count.classList.toggle("is-over", length > MAX_COMMENT_CHARS);
      submit.disabled =
        !me ||
        [...input.value.trim()].length === 0 ||
        length > MAX_COMMENT_CHARS ||
        submit.dataset.busy === "true";
    };

    const replyTo = (handle: string, commentId?: string) => {
      if (!me) {
        showToast("请先登录后再回帖");
        return;
      }
      if (commentId) {
        replyParent = commentId;
        replyChipLabel.textContent = `回覆 @${handle}`;
        replyChip.hidden = false;
      }
      const prefix = `@${handle} `;
      input.value = input.value.startsWith(prefix)
        ? input.value
        : `${prefix}${input.value}`;
      syncCommentSubmit();
      resizeCommentInput();
      input.focus();
      input.setSelectionRange(input.value.length, input.value.length);
      composer.scrollIntoView({ behavior: "smooth", block: "center" });
    };

    let renderedComments: Comment[] = [];
    const renderList = (comments: Comment[], total = comments.length): void => {
      renderedComments = comments;
      repliesCount.textContent =
        total > comments.length ? `${comments.length}/${total}` : String(total);
      repliesCount.title =
        total > comments.length ? `仅显示最近 ${comments.length} 条回帖` : "";
      onReplyCountChange(total);
      if (comments.length === 0) {
        const empty = el("div", "fk-comments-empty");
        const emptyTitle = el("strong");
        emptyTitle.textContent = "还没有回帖";
        const emptyHint = el("span");
        emptyHint.textContent = "来发布第一条回帖吧。";
        empty.append(emptyTitle, emptyHint);
        list.replaceChildren(empty);
        return;
      }

      const byId = new Map(comments.map((comment) => [comment.id, comment]));
      const children = new Map<string, Comment[]>();
      const roots: Comment[] = [];
      for (const comment of comments) {
        const parentId =
          comment.parent && byId.has(comment.parent.id)
            ? comment.parent.id
            : null;
        if (!parentId) {
          roots.push(comment);
          continue;
        }
        const bucket = children.get(parentId) ?? [];
        bucket.push(comment);
        children.set(parentId, bucket);
      }

      const renderNode = (comment: Comment, depth: number): HTMLElement => {
        const node = renderReply(
          post.id,
          comment,
          canModerate,
          replyTo,
          refreshComments,
          status,
          depth > 0,
        );
        node.dataset.depth = String(depth);
        if (depth > 0) node.classList.add("is-nested");
        const kids = children.get(comment.id) ?? [];
        if (kids.length > 0) {
          const box = el("div", "fk-thread-children");
          for (const kid of kids) box.append(renderNode(kid, depth + 1));
          node.append(box);
        }
        return node;
      };

      list.replaceChildren(...roots.map((comment) => renderNode(comment, 0)));
    };

    const refreshComments = async () => {
      try {
        const page = await getComments(post.id);
        renderList(page.comments, page.total);
        if (location.hash.startsWith("#comment-")) {
          requestAnimationFrame(() => {
            document
              .getElementById(decodeURIComponent(location.hash.slice(1)))
              ?.scrollIntoView({ behavior: "smooth", block: "center" });
          });
        }
      } catch (error) {
        renderList([], 0);
        status.textContent =
          error instanceof Error ? error.message : "回帖加载失败";
      }
    };

    submit.addEventListener("click", async () => {
      const text = input.value.trim();
      if (!text || !me || [...input.value].length > MAX_COMMENT_CHARS) return;
      submit.dataset.busy = "true";
      submit.disabled = true;
      submit.textContent = "回帖中…";
      try {
        await createComment(post.id, text, replyParent ?? undefined);
        input.value = "";
        clearReplyTarget();
        syncCommentSubmit();
        resizeCommentInput();
        status.textContent = "";
        await refreshComments();
        const latest = renderedComments.at(-1);
        if (latest) {
          document
            .getElementById(`comment-${latest.id}`)
            ?.scrollIntoView({ behavior: "smooth", block: "center" });
        }
      } catch (error) {
        status.textContent =
          error instanceof Error ? error.message : "回帖失败";
      } finally {
        delete submit.dataset.busy;
        submit.textContent = "回帖";
        syncCommentSubmit();
      }
    });

    input.addEventListener("input", () => {
      syncCommentSubmit();
      resizeCommentInput();
    });
    syncCommentSubmit();
    requestAnimationFrame(resizeCommentInput);

    replies.append(repliesHead, list);
    thread.append(head, renderOriginPost(post), composer, replies);
    if (location.hash === "#reply" && me) {
      requestAnimationFrame(() => {
        composer.scrollIntoView({ behavior: "smooth", block: "center" });
        input.focus();
      });
    }
    void refreshComments();
    return { thread, composer };
  }

  const mount = async () => {
    const container = document.querySelector<HTMLElement>("[data-fk-post]");
    if (!container) return;
    if (container.dataset.fkPostMounted === "true") return;
    container.dataset.fkPostMounted = "true";
    const sessionPromise = hydrateSession();

    container
      .querySelector<HTMLButtonElement>("[data-role=back]")!
      .addEventListener("click", () =>
        history.length > 1 ? history.back() : (location.href = "/"),
      );

    const layout = container.querySelector<HTMLElement>(".fk-post-layout")!;
    layout.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      const follow = target.closest<HTMLButtonElement>(".fk-follow-btn");
      if (follow?.dataset.handle) {
        if (!getAccount()) {
          requestAuthentication();
          return;
        }
        follow.disabled = true;
        const following = follow.dataset.following !== "true";
        void setFollow(follow.dataset.handle, following)
          .then((result) => setFollowButtonState(follow, result.following))
          .catch((error: unknown) => {
            if (error instanceof ApiError && error.status === 401) {
              requestAuthentication();
            }
          })
          .finally(() => {
            follow.disabled = false;
          });
        return;
      }

      const avatarLink = target.closest<HTMLElement>(".fk-avatar-link");
      if (avatarLink?.dataset.handle) {
        event.preventDefault();
        navigate(userPath(avatarLink.dataset.handle));
      }
    });

    const parsedPath = parsePostPath(location.pathname);
    const host = container.querySelector<HTMLElement>(
      "[data-role=post-detail]",
    )!;
    const side = container.querySelector<HTMLElement>("[data-role=post-side]")!;

    const postRequest = parsedPath
      ? getPostByPath(parsedPath.handle, parsedPath.slug)
      : Promise.resolve(null);

    void Promise.all([postRequest, sessionPromise])
      .then(([post]) => {
        if (!post) {
          host.replaceChildren(
            statusRow("没有找到这条帖子，可能还未加载或已失效。"),
          );
          return;
        }
        if (!parsedPath) {
          history.replaceState(null, "", postPath(post));
        }
        document.title = `${post.author.name}：${post.text.slice(0, 30)} | FuckXter`;
        const controls = renderPostControls(post);
        const { thread } = renderThread(
          post,
          getAccount()?.profile.handle === post.author.handle,
          (count) => {
            post.stats.replies = count;
            const reply = controls.querySelector<HTMLButtonElement>(
              '[data-action="reply"]',
            );
            if (!reply) return;
            reply.dataset.count = String(count);
            reply.querySelector<HTMLElement>(".fk-action-count")!.textContent =
              count > 0 ? fmtCount(count) : "";
          },
        );
        host.replaceChildren(thread);
        const hot = renderHotPosts(null, post.id);
        side.replaceChildren(renderPostInfo(post), controls, hot);
        side.hidden = false;
        void getTimeline("foryou", null)
          .then((page) => {
            hot.replaceWith(renderHotPosts(page.posts, post.id));
          })
          .catch(() => {
            hot.replaceWith(renderHotPosts([], post.id));
          });
        void recordPostView(post.id)
          .then((result) => {
            post.stats.views = result.views;
            side
              .querySelector<HTMLElement>(".fk-post-info")
              ?.replaceWith(renderPostInfo(post));
          })
          .catch(() => {});
      })
      .catch((error: unknown) => {
        const message =
          error instanceof Error ? error.message : "帖子加载失败。";
        host.replaceChildren(statusRow(message));
        side.replaceChildren(statusRow(message));
      });
  };

  onFuckxterPageReady(() => {
    void mount();
  });
</script>
