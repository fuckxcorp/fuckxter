---
import "../../styles/post.css";

import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
---

<Layout title="详情">
  <div class="app subpage" data-post>
    <Header search />

    <div class="post-layout">
      <div class="post-main">
        <div class="post-main-inner" data-role="post-detail">
          <section class="thread" aria-label="帖子线程">
            <header class="thread-head">
              <h1>帖子线程</h1>
              <p>发起与回帖按时间排列</p>
            </header>

            <article
              class="thread-post thread-origin post-skeleton shard"
              data-shard="0"
            >
              <span class="skeleton skeleton-pill"></span>
              <span class="skeleton skeleton-avatar"></span>
              <div class="skeleton-copy">
                <span class="skeleton skeleton-line is-short"></span>
                <span class="skeleton skeleton-line"></span>
                <span class="skeleton skeleton-line is-medium"></span>
              </div>
            </article>

            <section class="thread-replies">
              <header class="replies-head">
                <h2>回帖</h2>
                <span>加载中</span>
              </header>
            </section>
          </section>
        </div>
      </div>
      <aside class="post-side" data-role="post-side" aria-label="帖子信息">
        <section class="post-info">
          <h4 class="post-info-title">详情</h4>
          <div class="detail-skeleton">
            <span class="skeleton skeleton-avatar is-small"></span>
            <span class="skeleton skeleton-line is-medium"></span>
            <span class="skeleton skeleton-line"></span>
          </div>
        </section>
        <section class="post-controls">
          <h4 class="post-controls-title">互动</h4>
          <div class="control-skeleton">
            <span class="skeleton skeleton-button"></span>
            <span class="skeleton skeleton-button"></span>
            <span class="skeleton skeleton-button"></span>
          </div>
        </section>
      </aside>
    </div>
  </div>
</Layout>

<script>
  import { navigate } from "astro:transitions/client";
  import {
    createComment,
    uploadMedia,
    createPost,
    deleteComment,
    deletePost,
    getComments,
    getPostByPath,
    getTimeline,
    recordPostView,
    setFollow,
    toggleLike,
    toggleCommentLike,
    toggleCommentRepost,
    toggleRepost,
  } from "../../lib/accounts/api";
  import {
    getAccount,
    hydrateSession,
    requestAuthentication,
  } from "../../lib/accounts/auth";
  import {
    actionButton,
    authorAvatar,
    el,
    followButton,
    fmtCount,
    ICONS,
    postShard,
    relativeTime,
    renderRichText,
    renderPostSource,
    setFollowButtonState,
    showToast,
    statusRow,
  } from "../../lib/ui/dom";
  import { ApiError, apiEndpoint } from "../../lib/core/http";
  import { onPageReady } from "../../lib/core/page";
  import { rememberPost } from "../../lib/feed/history";
  import { openPostShareMenu } from "../../lib/ui/share";
  import { openPostRepostMenu, quotePost } from "../../lib/ui/repost";
  import type { Comment, Post, PostMedia } from "../../lib/core/types";
  import { parsePostPath, postPath, userPath } from "../../lib/core/urls";

  const fullTime = (iso: string) =>
    new Date(iso).toLocaleString("zh-CN", {
      dateStyle: "long",
      timeStyle: "short",
    });

  const MAX_COMMENT_CHARS = 1000;

  function renderPostInfo(post: Post): HTMLElement {
    const box = el("section", "post-info shard");
    box.dataset.shard = postShard(`${post.id}:info`);
    const title = el("h4", "post-info-title");
    title.textContent = "详情";
    const author = el("div", "post-info-author");
    const avatar = authorAvatar(
      post.author.handle,
      post.author.name,
      "avatar",
      post.author.avatarUrl,
    );
    const who = el("div");
    const name = el("strong");
    name.textContent = post.author.name;
    const handle = el("small");
    handle.textContent = `@${post.author.handle}`;
    who.append(name, handle);
    author.append(avatar, who, followButton(post));

    const rows = el("dl", "post-info-rows");
    const row = (label: string, value: string) => {
      const dt = el("dt");
      dt.textContent = label;
      const dd = el("dd");
      dd.textContent = value;
      rows.append(dt, dd);
    };
    row("发布时间", fullTime(post.createdAt));
    row("帖子 ID", post.id);
    row("正文字数", `${[...post.text].length} 字`);
    row(
      "互动数据",
      `${post.stats.replies} 回帖 · ${post.stats.reposts} 转发 · ${post.stats.likes} 喜欢 · ${fmtCount(post.stats.views ?? 0)} 次浏览`,
    );
    box.append(title, author, rows);
    return box;
  }

  function renderHotPosts(
    posts: Post[] | null,
    currentId: string,
    limit = 1,
  ): HTMLElement {
    const box = el("section", "hot-posts shard");
    box.dataset.shard = postShard(`${currentId}:hot`);
    const title = el("h4", "hot-title");
    title.textContent = "热门帖子";
    const hint = el("p", "hot-hint");
    hint.textContent = "按浏览热度排序";
    const list = el("div", "hot-list");

    if (posts === null) {
      list.append(statusRow("正在加载…"));
    } else {
      const items = posts
        .filter((item) => item.id !== currentId)
        .slice(0, limit);
      if (items.length === 0) {
        list.append(statusRow("暂时没有其他热门帖子。"));
      }
      items.forEach((item, index) => {
        const row = el("a", "hot-item");
        row.href = postPath(item);
        row.dataset.postId = item.id;

        const rank = el("span", "hot-rank");
        rank.textContent = String(index + 1);

        const body = el("span", "hot-body");
        const meta = el("span", "hot-meta");
        meta.textContent = `${item.author.name} · @${item.author.handle}`;
        const text = el("span", "hot-text");
        text.textContent = item.text;
        const views = el("span", "hot-views");
        views.textContent = `${fmtCount(item.stats.views ?? 0)} 次浏览`;
        body.append(meta, text, views);

        row.append(rank, body);
        list.append(row);
      });
    }

    box.append(title, hint, list);
    return box;
  }

  function renderPostControls(post: Post): HTMLElement {
    const box = el("section", "post-controls shard");
    box.dataset.shard = postShard(`${post.id}:controls`);
    const title = el("h4", "post-controls-title");
    title.textContent = "互动";

    const actions = el("div", "post-control-actions");
    actions.append(
      actionButton("reply", ICONS.reply, "回帖", post.stats.replies),
      actionButton("repost", ICONS.repost, "转发", post.stats.reposts),
      actionButton("like", ICONS.heart, "喜欢", post.stats.likes),
      actionButton("share", ICONS.share, "分享", 0),
    );

    if (post.viewer?.isAuthor) {
      actions.append(actionButton("edit", ICONS.edit, "编辑", 0));
      const remove = actionButton("delete", ICONS.trash, "删除", 0);
      remove.classList.add("is-danger");
      actions.append(remove);
    }

    const repostBtn = actions.querySelector<HTMLButtonElement>(
      '[data-action="repost"]',
    )!;
    const likeBtn = actions.querySelector<HTMLButtonElement>(
      '[data-action="like"]',
    )!;
    repostBtn.classList.toggle("is-reposted", Boolean(post.viewer?.reposted));
    likeBtn.classList.toggle("is-liked", Boolean(post.viewer?.liked));

    const setCount = (btn: HTMLButtonElement, count: number) => {
      btn.dataset.count = String(count);
      btn.querySelector<HTMLElement>(".action-count")!.textContent =
        count > 0 ? fmtCount(count) : "";
    };

    actions.addEventListener("click", async (event) => {
      const btn = (event.target as HTMLElement).closest<HTMLButtonElement>(
        ".action",
      );
      if (!btn) return;
      const action = btn.dataset.action;

      if (action === "reply") {
        if (!getAccount()) {
          requestAuthentication();
          return;
        }
        const input =
          document.querySelector<HTMLTextAreaElement>(".comment-input");
        input?.scrollIntoView({ behavior: "smooth", block: "center" });
        input?.focus();
        return;
      }

      if (action === "like" || action === "repost") {
        if (!getAccount()) {
          requestAuthentication();
          return;
        }
        if (action === "repost") {
          const choice = await openPostRepostMenu(
            btn,
            btn.classList.contains("is-reposted"),
          );
          if (choice === "cancelled") return;
          if (choice === "quote") {
            await quotePost(post);
            return;
          }
        }
        const activeClass = action === "like" ? "is-liked" : "is-reposted";
        const willActive = !btn.classList.contains(activeClass);
        const current = Number(btn.dataset.count ?? "0");
        setCount(btn, Math.max(0, current + (willActive ? 1 : -1)));
        btn.classList.toggle(activeClass, willActive);
        btn.disabled = true;
        try {
          if (action === "like") {
            const result = await toggleLike(post.id, willActive);
            setCount(btn, result.likes);
            btn.classList.toggle(activeClass, result.liked);
          } else {
            const result = await toggleRepost(post.id, willActive);
            setCount(btn, result.reposts);
            btn.classList.toggle(activeClass, result.reposted);
            showToast(result.reposted ? "已转发" : "已取消转发");
          }
        } catch (error) {
          setCount(btn, current);
          btn.classList.toggle(activeClass, !willActive);
          if (error instanceof ApiError && error.status === 401) {
            requestAuthentication();
          } else if (action === "repost") {
            showToast(
              error instanceof Error ? error.message : "转发失败，请重试。",
            );
          }
        } finally {
          btn.disabled = false;
        }
        return;
      }

      if (action === "edit") {
        void navigate(`/edit?post=${encodeURIComponent(postPath(post))}`);
        return;
      }

      if (action === "delete") {
        if (!confirm("确定删除这条帖子吗？")) return;
        btn.disabled = true;
        try {
          await deletePost(post.id);
          navigate("/");
        } catch (error) {
          btn.disabled = false;
          btn.title = error instanceof Error ? error.message : "删除失败";
        }
        return;
      }

      if (action === "share") {
        const result = await openPostShareMenu(btn, post);
        if (result === "copied") showToast("链接已复制");
        if (result === "shared") showToast("已分享");
        if (result === "failed") showToast("分享失败");
      }
    });

    box.append(title, actions);
    return box;
  }

  function threadAuthorLine(
    author: Comment["author"],
    createdAt: string,
    compact = false,
  ): HTMLElement {
    const head = el("header", "thread-meta");
    const who = el("div", "thread-who");
    const name = el("strong");
    name.textContent = author.name;
    who.append(name);
    if (author.verified) who.insertAdjacentHTML("beforeend", ICONS.verified);
    const handle = el("span", "thread-handle");
    handle.textContent = `@${author.handle}`;
    const time = el("time");
    time.dateTime = createdAt;
    time.textContent = compact ? relativeTime(createdAt) : fullTime(createdAt);
    time.title = fullTime(createdAt);
    who.append(handle);
    head.append(who, time);
    return head;
  }

  function renderOriginPost(post: Post): HTMLElement {
    const article = el("article", "thread-post thread-origin shard");
    article.dataset.shard = postShard(post.id);
    const kind = el("span", "thread-kind");
    kind.textContent = "发起";
    const avatar = authorAvatar(
      post.author.handle,
      post.author.name,
      "avatar",
      post.author.avatarUrl,
    );
    const body = el("div", "thread-body");
    body.append(threadAuthorLine(post.author, post.createdAt));
    const text = el("p", "thread-text");
    text.append(renderRichText(post.text));
    if (post.repostKind !== "repost") body.append(text);
    if (post.repostKind) body.append(renderPostSource(post));
    if (post.media?.length && post.repostKind !== "repost") {
      const list = el("div", "media-list is-detail");
      if (post.media.length > 3) list.classList.add("is-scrollable");
      for (const item of post.media) {
        const media = el("div", item.hdr ? "media is-hdr" : "media");
        const image = el("img", "media-image");
        image.src = item.url.startsWith("/") ? apiEndpoint(item.url) : item.url;
        image.alt = item.alt;
        image.loading = "eager";
        image.decoding = "async";
        image.referrerPolicy = "no-referrer";
        media.append(image);
        if (item.hdr) {
          const badge = el("span", "media-hdr-badge");
          badge.textContent = "HDR";
          badge.title = "这条图片按 HDR 显示：在支持 HDR 的屏幕上不做 SDR 压暗";
          media.append(badge);
        }
        list.append(media);
      }
      body.append(list);
    }
    article.append(kind, avatar, body);
    return article;
  }

  function renderReply(
    postId: string,
    comment: Comment,
    canModerate: boolean,
    openReply: (host: HTMLElement, comment: Comment) => void,
    refreshComments: () => Promise<void>,
    status: HTMLElement,
    descendantCount: number,
    sourceUrl: string,
  ): HTMLElement {
    const article = el("article", "thread-post thread-reply");
    article.id = `comment-${comment.id}`;
    const avatar = authorAvatar(
      comment.author.handle,
      comment.author.name,
      "avatar",
      comment.author.avatarUrl,
    );
    const body = el("div", "thread-body");
    body.append(threadAuthorLine(comment.author, comment.createdAt, true));
    const text = el("p", "thread-text");
    text.append(renderRichText(comment.text));
    body.append(text);
    if (comment.media?.length) {
      const mediaList = el("div", "media-list reply-media");
      for (const item of comment.media) {
        const media = el("div", "media");
        const image = document.createElement("img");
        image.className = "media-image";
        image.src = item.url.startsWith("/") ? apiEndpoint(item.url) : item.url;
        image.alt = item.alt;
        image.loading = "lazy";
        image.decoding = "async";
        media.append(image);
        mediaList.append(media);
      }
      body.append(mediaList);
    }

    const actions = el("footer", "thread-reply-actions");
    const reply = el("button", "thread-link-btn");
    reply.type = "button";
    reply.textContent = "回复";
    // 就地回复：输入框直接长在这一层下面，不再把页面拽回顶部的主输入框
    const inlineHost = el("div", "reply-inline");
    inlineHost.hidden = true;
    reply.addEventListener("click", () => openReply(inlineHost, comment));
    actions.append(reply);

    const like = actionButton("like", ICONS.heart, "喜欢", comment.stats.likes);
    const repost = actionButton(
      "repost",
      ICONS.repost,
      "转发",
      comment.stats.reposts,
    );
    like.classList.toggle("is-liked", comment.viewer.liked);
    repost.classList.toggle("is-reposted", comment.viewer.reposted);
    const setCommentCount = (button: HTMLButtonElement, count: number) => {
      button.dataset.count = String(count);
      button.querySelector<HTMLElement>(".action-count")!.textContent =
        count > 0 ? fmtCount(count) : "";
    };
    like.addEventListener("click", async () => {
      if (!getAccount()) {
        requestAuthentication();
        return;
      }
      const next = !like.classList.contains("is-liked");
      like.classList.toggle("is-liked", next);
      try {
        const result = await toggleCommentLike(postId, comment.id, next);
        comment.viewer.liked = result.liked;
        setCommentCount(like, result.likes);
        like.classList.toggle("is-liked", result.liked);
      } catch {
        like.classList.toggle("is-liked", !next);
      }
    });
    repost.addEventListener("click", async () => {
      if (!getAccount()) {
        requestAuthentication();
        return;
      }
      const next = !repost.classList.contains("is-reposted");
      repost.classList.toggle("is-reposted", next);
      try {
        const result = await toggleCommentRepost(postId, comment.id, next);
        comment.viewer.reposted = result.reposted;
        setCommentCount(repost, result.reposts);
        repost.classList.toggle("is-reposted", result.reposted);
      } catch {
        repost.classList.toggle("is-reposted", !next);
      }
    });
    const quote = actionButton("quote", ICONS.copy, "转发并评论", 0);
    quote.addEventListener("click", async () => {
      if (!getAccount()) {
        requestAuthentication();
        return;
      }
      if (quote.disabled) return;
      quote.disabled = true;
      const dialog = document.createElement("dialog");
      dialog.className = "quote-dialog";
      const title = el("h2");
      title.textContent = "转贴回帖";
      const preview = el("blockquote", "quote-preview");
      const author = el("strong");
      author.textContent = `@${comment.author.handle}`;
      const content = el("p");
      content.append(renderRichText(comment.text));
      const source = el("a", "inline-link");
      source.textContent = "查看原回帖";
      source.href = `${sourceUrl}#comment-${encodeURIComponent(comment.id)}`;
      source.target = "_blank";
      source.rel = "noopener";
      preview.append(author, content, source);
      const input = document.createElement("textarea");
      input.placeholder = "添加你的想法（可选）";
      input.setAttribute("aria-label", "转贴附言");
      input.rows = 3;
      const link = `\n\n${sourceUrl}#comment-${encodeURIComponent(comment.id)}`;
      const prefix = `转贴 @${comment.author.handle}：\n`;
      const excerpt = [...comment.text].slice(0, 500).join("") || "[图片回帖]";
      const quoted = `${prefix}${excerpt}${[...comment.text].length > 500 ? "…" : ""}${link}`;
      input.maxLength = Math.max(0, 1000 - [...quoted].length - 2);
      const error = el("p", "thread-status");
      error.setAttribute("role", "status");
      const foot = el("div", "quote-dialog-actions");
      const cancel = el("button", "ghost-btn");
      cancel.type = "button";
      cancel.textContent = "取消";
      const send = el("button", "primary-btn");
      send.type = "button";
      send.textContent = "发布转贴";
      foot.append(cancel, send);
      dialog.append(title, preview, input, error, foot);
      dialog.addEventListener("close", () => {
        dialog.remove();
        quote.disabled = false;
        quote.focus();
      });
      cancel.addEventListener("click", () => dialog.close());
      dialog.addEventListener("cancel", (event) => {
        if (send.disabled) event.preventDefault();
      });
      send.addEventListener("click", async () => {
        if (send.disabled) return;
        send.disabled = true;
        cancel.disabled = true;
        error.textContent = "";
        try {
          const note = input.value.trim();
          await createPost(note ? `${note}\n\n${quoted}` : quoted);
          dialog.close();
          showToast("已转贴，原回帖链接已附上");
        } catch (failure) {
          error.textContent =
            failure instanceof Error ? failure.message : "转贴失败，请重试";
        } finally {
          send.disabled = false;
          cancel.disabled = false;
        }
      });
      document.body.append(dialog);
      dialog.showModal();
      input.focus();
    });
    actions.append(like, repost, quote);

    const me = getAccount();
    if (me && (canModerate || comment.author.handle === me.profile.handle)) {
      const remove = el("button", "thread-link-btn is-danger");
      remove.type = "button";
      remove.textContent = "删除";
      remove.addEventListener("click", async () => {
        const message = descendantCount
          ? `这条回帖下有 ${descendantCount} 条楼中楼回复，删除后会一并删除。确定继续吗？`
          : "确定删除这条回帖吗？";
        if (!confirm(message)) return;
        remove.disabled = true;
        try {
          await deleteComment(postId, comment.id);
          await refreshComments();
        } catch (error) {
          remove.disabled = false;
          status.textContent =
            error instanceof Error ? error.message : "删除失败";
        }
      });
      actions.append(remove);
    }
    body.append(actions, inlineHost);
    article.append(avatar, body);
    return article;
  }

  function renderThread(
    post: Post,
    canModerate: boolean,
    onReplyCountChange: (count: number) => void,
    initialReplies?: HTMLElement,
  ): { thread: HTMLElement; composer: HTMLElement } {
    const thread = el("section", "thread");
    const head = el("header", "thread-head");
    const title = el("h1");
    title.textContent = "帖子线程";
    const hint = el("p");
    hint.textContent = "发起与回帖按时间排列";
    head.append(title, hint);

    // 直达帖子页时，Worker 已将回帖渲染进 HTML。复用该节点而不是
    // 再请求一次并替换它，首屏内容便始终是静态 HTML，不会闪成 JS 加载。
    const replies = initialReplies ?? el("section", "thread-replies");
    let repliesHead = replies.querySelector<HTMLElement>(".replies-head");
    let repliesCount = repliesHead?.querySelector<HTMLElement>("span");
    if (!repliesHead || !repliesCount) {
      repliesHead = el("header", "replies-head");
      const repliesTitle = el("h2");
      repliesTitle.textContent = "回帖";
      repliesCount = el("span");
      repliesCount.textContent = "0";
      repliesHead.append(repliesTitle, repliesCount);
      replies.prepend(repliesHead);
    }

    const me = getAccount();
    // 主回复和楼中楼共用同一套输入框布局与控件，避免两处越改越不一致。
    const mediaDrafts = new Map<string, PostMedia[]>();
    const createReplyFields = (
      fieldId: string,
      placeholder: string,
      ariaLabel: string,
    ) => {
      const input = el(
        "textarea",
        "comment-input side-comment-input reply-composer-input",
      ) as HTMLTextAreaElement;
      input.rows = 2;
      input.maxLength = MAX_COMMENT_CHARS;
      input.id = fieldId;
      input.name = "reply";
      input.autocomplete = "off";
      input.placeholder = placeholder;
      input.setAttribute("aria-label", ariaLabel);
      const count = el("span", "comment-count");
      count.textContent = `0 / ${MAX_COMMENT_CHARS}`;
      const submit = el("button", "primary-btn comment-submit reply-submit");
      submit.type = "button";
      submit.textContent = "回复";
      const actions = el(
        "div",
        "thread-composer-actions reply-composer-actions",
      );
      const media = mediaDrafts.get(fieldId) ?? [];
      mediaDrafts.set(fieldId, media);
      const preview = el("div", "reply-media-preview");
      const picker = document.createElement("input");
      picker.type = "file";
      picker.accept = "image/*";
      picker.multiple = true;
      picker.hidden = true;
      const attach = el("button", "ghost-btn reply-attach");
      attach.type = "button";
      attach.textContent = "添加图片";
      attach.disabled = !getAccount();
      const error = el("p", "thread-status");
      error.setAttribute("aria-live", "polite");
      const syncMedia = () => {
        preview.replaceChildren();
        for (const item of media) {
          const tile = el("div", "reply-media-tile");
          const image = document.createElement("img");
          image.src = item.url.startsWith("/")
            ? apiEndpoint(item.url)
            : item.url;
          image.alt = item.alt;
          const remove = el("button");
          remove.type = "button";
          remove.textContent = "×";
          remove.setAttribute("aria-label", `移除 ${item.alt}`);
          remove.disabled =
            submit.dataset.busy === "true" ||
            submit.dataset.uploading === "true";
          remove.addEventListener("click", () => {
            media.splice(media.indexOf(item), 1);
            syncMedia();
          });
          tile.append(image, remove);
          preview.append(tile);
        }
        attach.disabled =
          !getAccount() ||
          media.length >= 4 ||
          submit.dataset.busy === "true" ||
          submit.dataset.uploading === "true";
        const cancel = input
          .closest(".inline-composer")
          ?.querySelector<HTMLButtonElement>(".inline-cancel");
        if (cancel)
          cancel.disabled =
            submit.dataset.busy === "true" ||
            submit.dataset.uploading === "true";
        input.dispatchEvent(new Event("input"));
      };
      attach.addEventListener("click", () => picker.click());
      picker.addEventListener("change", async () => {
        const files = [...(picker.files ?? [])];
        picker.value = "";
        if (!files.length) return;
        if (
          files.length + media.length > 4 ||
          files.some((file) => !file.type.startsWith("image/"))
        ) {
          error.textContent = "每条回帖最多添加 4 张图片。";
          return;
        }
        error.textContent = "";
        submit.dataset.uploading = "true";
        const host = input.closest<HTMLElement>(".reply-inline");
        if (host) host.dataset.busy = "true";
        attach.textContent = "上传中…";
        syncMedia();
        try {
          for (const file of files) media.push(await uploadMedia(file));
        } catch (failure) {
          error.textContent =
            failure instanceof Error ? failure.message : "图片上传失败，请重试";
        } finally {
          delete submit.dataset.uploading;
          if (host) delete host.dataset.busy;
          attach.textContent = "添加图片";
          syncMedia();
        }
      });
      actions.append(attach, count, submit);
      syncMedia();
      const clearMedia = () => {
        media.splice(0);
        syncMedia();
      };
      return {
        input,
        count,
        submit,
        actions,
        preview,
        picker,
        mediaError: error,
        media,
        clearMedia,
        syncMedia,
      };
    };
    const {
      input,
      count,
      submit,
      actions: composerActions,
      preview: composerPreview,
      picker: composerPicker,
      mediaError: composerMediaError,
      media: composerMedia,
      clearMedia: clearComposerMedia,
      syncMedia: syncComposerMedia,
    } = createReplyFields(
      `reply-${encodeURIComponent(post.id)}`,
      me ? "写下你的回复" : "登录后才能回复",
      "回复内容",
    );
    input.disabled = !me;
    submit.disabled = !me;
    const composer = el("section", "thread-composer shard");
    composer.dataset.shard = postShard(`${post.id}:composer`);
    const composerAvatar = me
      ? authorAvatar(me.profile.handle, me.profile.name, "avatar", me.avatarUrl)
      : el("span", "avatar");
    const composerBody = el("div", "composer-body");
    composerBody.append(
      input,
      composerPicker,
      composerPreview,
      composerMediaError,
    );

    const status = el("p", "thread-status");
    status.setAttribute("aria-live", "polite");
    const list =
      replies.querySelector<HTMLElement>(".comments-list.thread-list") ??
      el("div", "comments-list thread-list");

    composerBody.append(status, composerActions);
    composer.append(composerAvatar, composerBody);

    const resizeCommentInput = () => {
      input.style.height = "auto";
      const maxHeight = matchMedia("(max-width: 900px)").matches ? 240 : 360;
      const nextHeight = Math.min(input.scrollHeight, maxHeight);
      input.style.height = `${nextHeight}px`;
      input.style.overflowY =
        input.scrollHeight > maxHeight ? "auto" : "hidden";
    };

    const syncCommentSubmit = () => {
      const length = [...input.value].length;
      count.textContent = `${length} / ${MAX_COMMENT_CHARS}`;
      count.classList.toggle("is-over", length > MAX_COMMENT_CHARS);
      submit.disabled =
        !me ||
        (![...input.value.trim()].length && !composerMedia.length) ||
        submit.dataset.uploading === "true" ||
        length > MAX_COMMENT_CHARS ||
        submit.dataset.busy === "true";
    };

    /**
     * 楼中楼太长时默认折叠。
     * 一层回帖下面挂几十条回复，整个评论区会被撑到几万像素高，后面的楼层在窄屏
     * （评论列表不单独滚动、跟着整页滚）上等于「看不见了」。所以只默认展示前几条，
     * 其余收起来；要看的点了就展开（展开后仍然限高，避免又一次把下面的楼层顶走）。
     */
    const AUTO_COLLAPSE_DESCENDANTS = 3;
    const PREVIEW_CHILDREN = 2;
    /**
     * 已经很深的楼中楼不再预览子回复：每层都预览几条会指数膨胀（2ⁿ 条），
     * 照样能把后面的楼层顶走。注意这个上限只作用于「本来就很大的楼中楼」，
     * 正常的小楼中楼（子孙不超过 AUTO_COLLAPSE_DESCENDANTS）保持原样。
     */
    const AUTO_COLLAPSE_DEPTH = 1;
    /** 一次「继续展开」放出多少条（按回复条数算），避免一口气铺开几千条 */
    const EXPAND_PAGE_SIZE = 10;
    const expandedCounts = new Map<string, number>();
    const collapsedBranches = new Set<string>();
    const replyDrafts = new Map<string, string>();
    const descendantCounts = new Map<string, number>();
    /** 折叠区块 -> 展开函数，深链接跳进去之前先把祖先展开 */
    const expanders = new Map<HTMLElement, () => void>();

    const revealComment = (target: HTMLElement | null): void => {
      if (!target) return;
      for (const [box, expand] of expanders) {
        if (box.hidden && box.contains(target)) expand();
      }
    };

    const scrollToComment = (target: HTMLElement | null): void => {
      if (!target) return;
      revealComment(target);
      requestAnimationFrame(() =>
        target.scrollIntoView({ behavior: "smooth", block: "center" }),
      );
    };

    /**
     * 就地回复：点某一层的「回复」时，输入框长在那条回帖下面。
     * 之前是滚回顶部那个大输入框，视线被拽走一大截，很割裂。
     */
    let inlineReply: { host: HTMLElement; close: () => void } | null = null;
    const closeInlineReply = () => {
      const current = inlineReply;
      inlineReply = null;
      current?.close();
    };

    const openInlineReply = (
      host: HTMLElement,
      comment: Pick<Comment, "id"> & {
        author: Pick<Comment["author"], "handle">;
      },
    ): void => {
      if (!getAccount()) {
        requestAuthentication();
        return;
      }
      if (inlineReply?.host.dataset.busy === "true") {
        showToast("正在发送回复，请稍候");
        return;
      }
      // 再点一次同一层就收起
      if (inlineReply?.host === host) {
        closeInlineReply();
        return;
      }
      closeInlineReply();

      const handle = comment.author.handle;
      const box = el("div", "inline-composer");
      const {
        input,
        count: hint,
        submit: send,
        actions: foot,
        preview,
        picker,
        mediaError,
        media,
        clearMedia,
        syncMedia,
      } = createReplyFields(
        `reply-${encodeURIComponent(post.id)}-${encodeURIComponent(comment.id)}`,
        `回复 @${handle}…`,
        `回复 @${handle}`,
      );
      input.value = replyDrafts.get(comment.id) ?? "";
      const error = el("p", "thread-status");
      error.setAttribute("aria-live", "polite");
      const cancel = el("button", "thread-link-btn inline-cancel");
      cancel.type = "button";
      cancel.textContent = "取消";
      send.disabled = true;
      foot.insertBefore(cancel, send);
      box.append(input, picker, preview, mediaError, error, foot);
      host.replaceChildren(box);
      host.hidden = false;

      const close = () => {
        if (input.value) replyDrafts.set(comment.id, input.value);
        else replyDrafts.delete(comment.id);
        host.hidden = true;
        host.replaceChildren();
      };
      inlineReply = { host, close };

      const sync = () => {
        const length = [...input.value].length;
        hint.textContent = `${length} / ${MAX_COMMENT_CHARS}`;
        hint.classList.toggle("is-over", length > MAX_COMMENT_CHARS);
        send.disabled =
          (!input.value.trim() && !media.length) ||
          send.dataset.uploading === "true" ||
          length > MAX_COMMENT_CHARS ||
          send.dataset.busy === "true";
      };

      const submitInline = async () => {
        const text = input.value.trim();
        if (
          (!text && !media.length) ||
          send.dataset.uploading === "true" ||
          [...input.value].length > MAX_COMMENT_CHARS ||
          send.dataset.busy === "true"
        )
          return;
        error.textContent = "";
        input.disabled = true;
        cancel.disabled = true;
        send.dataset.busy = "true";
        host.dataset.busy = "true";
        send.textContent = "回复中…";
        sync();
        syncMedia();
        try {
          const created = await createComment(
            post.id,
            text,
            comment.id,
            media.map((item) => item.id),
          );
          clearMedia();
          input.value = "";
          replyDrafts.delete(comment.id);
          closeInlineReply();
          await refreshComments();
          scrollToComment(document.getElementById(`comment-${created.id}`));
        } catch (failure) {
          error.textContent =
            failure instanceof Error ? failure.message : "回帖失败";
        } finally {
          input.disabled = false;
          cancel.disabled = false;
          delete host.dataset.busy;
          delete send.dataset.busy;
          send.textContent = "回复";
          sync();
          syncMedia();
        }
      };

      input.addEventListener("input", () => {
        sync();
        input.style.height = "auto";
        input.style.height = `${Math.min(input.scrollHeight, 240)}px`;
      });
      let composing = false;
      let compositionEndedAt = -Infinity;
      input.addEventListener("compositionstart", () => {
        composing = true;
      });
      input.addEventListener("compositionend", () => {
        composing = false;
        compositionEndedAt = performance.now();
      });
      input.addEventListener("keydown", (event) => {
        if (
          composing ||
          (event.key === "Enter" &&
            performance.now() - compositionEndedAt < 120)
        )
          return;
        if (
          event.isComposing ||
          event.key === "Process" ||
          send.dataset.uploading === "true" ||
          send.dataset.busy === "true"
        )
          return;
        if (event.key === "Escape") {
          event.preventDefault();
          closeInlineReply();
          return;
        }
        if (event.key === "Enter" && !event.shiftKey) {
          event.preventDefault();
          void submitInline();
        }
      });
      cancel.addEventListener("click", closeInlineReply);
      send.addEventListener("click", () => void submitInline());

      sync();
      input.focus();
    };

    // 首屏回帖由 Worker 直接输出。这里用事件代理接管其中的静态按钮，
    // 不必等待评论接口返回、也不必先把静态楼中楼重绘成客户端 DOM。
    list.addEventListener("click", async (event) => {
      const target = event.target as HTMLElement;
      const remove = target.closest<HTMLButtonElement>("[data-static-delete]");
      if (remove?.dataset.commentId) {
        const count = remove
          .closest<HTMLElement>("article.thread-reply")
          ?.querySelectorAll("article.thread-reply").length;
        const message = count
          ? `这条回帖下有 ${count} 条楼中楼回复，删除后会一并删除。确定继续吗？`
          : "确定删除这条回帖吗？";
        if (!confirm(message)) return;
        remove.disabled = true;
        try {
          await deleteComment(post.id, remove.dataset.commentId);
          await refreshComments();
        } catch (error) {
          remove.disabled = false;
          status.textContent =
            error instanceof Error ? error.message : "删除失败";
        }
        return;
      }
      const button = target.closest<HTMLButtonElement>("[data-static-reply]");
      if (!button) return;
      const article = button.closest<HTMLElement>("article.thread-reply");
      const id = button.dataset.commentId;
      const handle = button.dataset.commentHandle;
      if (!article || !id || !handle) return;
      let host = article.querySelector<HTMLElement>(".reply-inline");
      if (!host) {
        host = el("div", "reply-inline");
        host.hidden = true;
        article.querySelector<HTMLElement>(".thread-body")?.append(host);
      }
      openInlineReply(host, {
        id,
        author: { handle },
      });
    });

    const renderList = (comments: Comment[], total = comments.length): void => {
      descendantCounts.clear();
      expanders.clear();
      closeInlineReply();
      repliesCount.textContent =
        total > comments.length ? `${comments.length}/${total}` : String(total);
      repliesCount.title =
        total > comments.length ? `仅显示最近 ${comments.length} 条回帖` : "";
      onReplyCountChange(total);
      if (comments.length === 0) {
        const empty = el("div", "comments-empty");
        const emptyTitle = el("strong");
        emptyTitle.textContent = "还没有回帖";
        const emptyHint = el("span");
        emptyHint.textContent = "来发布第一条回帖吧。";
        empty.append(emptyTitle, emptyHint);
        list.replaceChildren(empty);
        return;
      }

      const byId = new Map(comments.map((comment) => [comment.id, comment]));
      const children = new Map<string, Comment[]>();
      const roots: Comment[] = [];
      for (const comment of comments) {
        const parentId =
          comment.parent && byId.has(comment.parent.id)
            ? comment.parent.id
            : null;
        if (!parentId) {
          roots.push(comment);
          continue;
        }
        const bucket = children.get(parentId) ?? [];
        bucket.push(comment);
        children.set(parentId, bucket);
      }

      /**
       * 楼中楼只缩进前几层。
       * 每往下一层都会叠加卡片内边距 + 子层内边距 + 缩进边距（约 72px），
       * 不封顶的话十几层之后回帖会被挤成一条竖线并一路向右延伸，
       * 楼中楼下面的其他回帖就被顶到很下面、也基本没法看了。
       */
      const MAX_INDENT_DEPTH = 3;

      const countDescendants = (commentId: string): number => {
        const cached = descendantCounts.get(commentId);
        if (cached !== undefined) return cached;
        let total = 0;
        for (const kid of children.get(commentId) ?? []) {
          total += 1 + countDescendants(kid.id);
        }
        descendantCounts.set(commentId, total);
        return total;
      };

      const renderNode = (comment: Comment, depth: number): HTMLElement => {
        const node = renderReply(
          post.id,
          comment,
          canModerate,
          openInlineReply,
          refreshComments,
          status,
          countDescendants(comment.id),
          new URL(postPath(post), location.origin).href,
        );
        node.dataset.depth = String(depth);
        if (depth > 0) node.classList.add("is-nested");
        if (depth > MAX_INDENT_DEPTH) node.classList.add("is-deep");
        const kids = children.get(comment.id) ?? [];
        if (kids.length > 0) {
          const box = el("div", "thread-children");
          const collapsible =
            countDescendants(comment.id) > AUTO_COLLAPSE_DESCENDANTS;
          const previewCount = !collapsible
            ? kids.length
            : depth >= AUTO_COLLAPSE_DEPTH
              ? 0
              : Math.min(PREVIEW_CHILDREN, kids.length);
          for (const kid of kids.slice(0, previewCount)) {
            box.append(renderNode(kid, depth + 1));
          }
          const rest = collapsible ? kids.slice(previewCount) : [];
          if (rest.length > 0) {
            // 展开是「整段展开、页面正常滚动」，条数多就分几次展开，不再做成内部滚动条
            const shownBox = el("div", "thread-children-rest");
            const pendingBox = el("div", "thread-children-rest");
            pendingBox.hidden = true;
            for (const kid of rest)
              pendingBox.append(renderNode(kid, depth + 1));
            const totalHidden = rest.length;
            const toggle = el("button", "thread-more");
            toggle.type = "button";
            const collapse = el("button", "thread-collapse");
            collapse.type = "button";
            collapse.textContent = "收起";
            let revealed = 0;
            let hiddenReplies = totalHidden;
            const syncLabel = () => {
              collapse.hidden = revealed === 0 || revealed === rest.length;
              toggle.setAttribute("aria-expanded", String(revealed > 0));
              toggle.textContent =
                revealed === rest.length
                  ? "收起更多回复"
                  : `${revealed === 0 ? "查看其余" : "继续展开"} ${hiddenReplies} 条回复`;
            };
            const revealNext = () => {
              let added = 0;
              while (revealed < rest.length && added < EXPAND_PAGE_SIZE) {
                const next = pendingBox.firstElementChild as HTMLElement | null;
                if (!next) break;
                shownBox.append(next);
                hiddenReplies -= 1;
                revealed += 1;
                added += 1;
              }
              pendingBox.hidden = true;
              expandedCounts.set(comment.id, revealed);
              syncLabel();
            };
            const collapseAll = () => {
              while (shownBox.lastElementChild) {
                pendingBox.prepend(shownBox.lastElementChild);
              }
              revealed = 0;
              expandedCounts.delete(comment.id);
              hiddenReplies = totalHidden;
              pendingBox.hidden = true;
              syncLabel();
            };
            collapse.addEventListener("click", collapseAll);
            toggle.addEventListener("click", () => {
              if (revealed === rest.length) collapseAll();
              else revealNext();
            });
            // 深链接跳进被折叠的回帖：一次全展开
            expanders.set(pendingBox, () => {
              while (revealed < rest.length) revealNext();
            });
            const saved = expandedCounts.get(comment.id) ?? 0;
            while (revealed < Math.min(saved, rest.length)) revealNext();
            toggle.setAttribute("aria-controls", `children-${comment.id}`);
            shownBox.id = `children-${comment.id}`;
            syncLabel();
            box.append(shownBox, pendingBox, toggle, collapse);
          }
          box.id = `branch-${comment.id}`;
          const toggle = el("button", "branch-toggle");
          toggle.type = "button";
          toggle.setAttribute("aria-controls", box.id);
          const rail = el("button", "branch-rail");
          rail.type = "button";
          rail.setAttribute("aria-controls", box.id);
          const setCollapsed = (collapsed: boolean) => {
            if (collapsed && inlineReply && box.contains(inlineReply.host)) {
              if (inlineReply.host.dataset.busy === "true") {
                showToast("正在发送回复，请稍候");
                return;
              }
              closeInlineReply();
            }
            box.hidden = collapsed;
            node.classList.toggle("is-collapsed", collapsed);
            if (collapsed) collapsedBranches.add(comment.id);
            else collapsedBranches.delete(comment.id);
            toggle.textContent = collapsed
              ? `展开 ${countDescendants(comment.id)} 条回复`
              : "收起回复";
            toggle.setAttribute("aria-expanded", String(!collapsed));
            rail.setAttribute("aria-expanded", String(!collapsed));
            rail.setAttribute(
              "aria-label",
              `收起 ${comment.author.name} 的 ${countDescendants(comment.id)} 条回复`,
            );
            rail.title = "点击连接线收起此分支";
          };
          toggle.addEventListener("click", () => setCollapsed(!box.hidden));
          rail.addEventListener("click", () => setCollapsed(true));
          expanders.set(box, () => setCollapsed(false));
          setCollapsed(collapsedBranches.has(comment.id));
          node.querySelector(".thread-reply-actions")!.append(toggle);
          node.append(rail, box);
        }
        return node;
      };

      list.replaceChildren(...roots.map((comment) => renderNode(comment, 0)));
    };

    const refreshComments = async () => {
      try {
        const page = await getComments(post.id);
        status.textContent = "";
        renderList(page.comments, page.total);
        if (location.hash.startsWith("#comment-")) {
          scrollToComment(
            document.getElementById(decodeURIComponent(location.hash.slice(1))),
          );
        }
      } catch (error) {
        repliesCount!.textContent = "加载失败";
        const retry = el("button", "retry-btn");
        retry.textContent = "重新加载回帖";
        retry.addEventListener("click", () => void refreshComments());
        if (!list.childElementCount) list.append(retry);
        status.textContent =
          error instanceof Error ? error.message : "回帖加载失败";
      }
    };

    submit.addEventListener("click", async () => {
      const text = input.value.trim();
      if (
        (!text && !composerMedia.length) ||
        !me ||
        submit.dataset.busy === "true" ||
        submit.dataset.uploading === "true" ||
        [...input.value].length > MAX_COMMENT_CHARS
      )
        return;
      submit.dataset.busy = "true";
      input.disabled = true;
      submit.disabled = true;
      submit.textContent = "回复中…";
      syncComposerMedia();
      try {
        const created = await createComment(
          post.id,
          text,
          undefined,
          composerMedia.map((item) => item.id),
        );
        clearComposerMedia();
        input.value = "";
        syncCommentSubmit();
        resizeCommentInput();
        status.textContent = "";
        await refreshComments();
        scrollToComment(document.getElementById(`comment-${created.id}`));
      } catch (error) {
        status.textContent =
          error instanceof Error ? error.message : "回帖失败";
      } finally {
        delete submit.dataset.busy;
        input.disabled = !me;
        submit.textContent = "回复";
        syncCommentSubmit();
        syncComposerMedia();
      }
    });

    input.addEventListener("input", () => {
      syncCommentSubmit();
      resizeCommentInput();
    });
    syncCommentSubmit();
    requestAnimationFrame(resizeCommentInput);

    if (!list.isConnected) replies.append(list);
    thread.append(head, renderOriginPost(post), composer, replies);
    if (location.hash === "#reply" && me) {
      requestAnimationFrame(() => {
        composer.scrollIntoView({ behavior: "smooth", block: "center" });
        input.focus();
      });
    }
    void refreshComments();
    return { thread, composer };
  }

  const mount = async () => {
    const container = document.querySelector<HTMLElement>("[data-post]");
    if (!container) return;
    if (container.dataset.postMounted === "true") return;
    container.dataset.postMounted = "true";
    const sessionPromise = hydrateSession();

    container
      .querySelector<HTMLButtonElement>("[data-role=back]")!
      .addEventListener("click", () =>
        history.length > 1 ? history.back() : (location.href = "/"),
      );

    const layout = container.querySelector<HTMLElement>(".post-layout")!;
    layout.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      const follow = target.closest<HTMLButtonElement>(".follow-btn");
      if (follow?.dataset.handle) {
        if (!getAccount()) {
          requestAuthentication();
          return;
        }
        follow.disabled = true;
        const following = follow.dataset.following !== "true";
        void setFollow(follow.dataset.handle, following)
          .then((result) => setFollowButtonState(follow, result.following))
          .catch((error: unknown) => {
            if (error instanceof ApiError && error.status === 401) {
              requestAuthentication();
            }
          })
          .finally(() => {
            follow.disabled = false;
          });
        return;
      }

      const avatarLink = target.closest<HTMLElement>(".avatar-link");
      if (avatarLink?.dataset.handle) {
        event.preventDefault();
        navigate(userPath(avatarLink.dataset.handle));
      }
    });

    const parsedPath = parsePostPath(location.pathname);
    const host = container.querySelector<HTMLElement>(
      "[data-role=post-detail]",
    )!;
    const side = container.querySelector<HTMLElement>("[data-role=post-side]")!;

    const postRequest = parsedPath
      ? getPostByPath(parsedPath.handle, parsedPath.slug)
      : Promise.resolve(null);

    void Promise.all([postRequest, sessionPromise])
      .then(([post]) => {
        if (!container.isConnected) return;
        if (!post) {
          host.replaceChildren(
            statusRow("没有找到这条帖子，可能还未加载或已失效。"),
          );
          return;
        }
        if (!parsedPath) {
          history.replaceState(null, "", postPath(post));
        }
        document.title = `${post.author.name}：${post.text.slice(0, 30)} | FuckXter`;
        rememberPost(post);
        const controls = renderPostControls(post);
        const initialReplies =
          host.querySelector<HTMLElement>(".thread-replies");
        const { thread } = renderThread(
          post,
          getAccount()?.profile.handle === post.author.handle,
          (count) => {
            post.stats.replies = count;
            const reply = controls.querySelector<HTMLButtonElement>(
              '[data-action="reply"]',
            );
            if (!reply) return;
            reply.dataset.count = String(count);
            reply.querySelector<HTMLElement>(".action-count")!.textContent =
              count > 0 ? fmtCount(count) : "";
          },
          initialReplies ?? undefined,
        );
        const me = getAccount()?.profile.handle;
        if (me) {
          for (const button of thread.querySelectorAll<HTMLButtonElement>(
            "[data-static-delete]",
          )) {
            const reply = button.closest<HTMLElement>("[data-comment-author]");
            button.hidden =
              me !== post.author.handle && me !== reply?.dataset.commentAuthor;
          }
        }
        host.replaceChildren(thread);
        let hot = renderHotPosts(null, post.id);
        side.replaceChildren(renderPostInfo(post), controls, hot);
        const controlsMedia = matchMedia("(max-width: 900px)");
        const placeControls = () => {
          if (controlsMedia.matches) {
            thread
              .querySelector<HTMLElement>(".thread-origin")
              ?.after(controls);
            return;
          }
          side.querySelector<HTMLElement>(".post-info")?.after(controls);
        };
        placeControls();
        controlsMedia.addEventListener("change", placeControls);
        document.addEventListener(
          "astro:before-swap",
          () => controlsMedia.removeEventListener("change", placeControls),
          { once: true },
        );
        side.hidden = false;
        let hotPosts: Post[] | null = null;
        let hotLimit = 0;
        let renderedHotLimit = -1;
        const refreshHotPosts = () => {
          const candidates = (hotPosts ?? []).filter(
            (item) => item.id !== post.id,
          );
          if (matchMedia("(max-width: 900px)").matches) {
            hotLimit = Math.min(2, candidates.length);
          } else if (hotLimit === 0) {
            hotLimit = 1;
          }

          const replaceHot = (limit: number) => {
            if (renderedHotLimit === limit) return;
            renderedHotLimit = limit;
            const next = renderHotPosts(hotPosts, post.id, limit);
            hot.replaceWith(next);
            hot = next;
          };
          replaceHot(hotLimit);

          requestAnimationFrame(() => {
            if (matchMedia("(max-width: 900px)").matches) return;
            // 用实际 scrollHeight 判断，不猜每条帖子的高度；文本换行也不会溢出。
            while (hotLimit > 1 && side.scrollHeight > side.clientHeight) {
              hotLimit -= 1;
              replaceHot(hotLimit);
            }
            while (hotLimit < candidates.length) {
              hotLimit += 1;
              replaceHot(hotLimit);
              if (side.scrollHeight > side.clientHeight) {
                hotLimit -= 1;
                replaceHot(hotLimit);
                break;
              }
            }
          });
        };
        let hotWidth = 0;
        let hotHeight = 0;
        const hotSizeObserver = new ResizeObserver(([entry]) => {
          const { width, height } = entry.contentRect;
          if (width === hotWidth && height === hotHeight) return;
          hotWidth = width;
          hotHeight = height;
          if (hotPosts) refreshHotPosts();
        });
        hotSizeObserver.observe(side);
        document.addEventListener(
          "astro:before-swap",
          () => hotSizeObserver.disconnect(),
          { once: true },
        );
        void getTimeline("foryou", null)
          .then((page) => {
            hotPosts = page.posts;
            refreshHotPosts();
          })
          .catch(() => {
            hotPosts = [];
            refreshHotPosts();
          });
        void recordPostView(post.id)
          .then((result) => {
            post.stats.views = result.views;
            const stats = side.querySelector<HTMLElement>(
              ".post-info-rows dd:last-child",
            );
            if (stats) {
              stats.textContent = `${post.stats.replies} 回帖 · ${post.stats.reposts} 转发 · ${post.stats.likes} 喜欢 · ${fmtCount(post.stats.views)} 次浏览`;
            }
          })
          .catch(() => {});
      })
      .catch((error: unknown) => {
        const message =
          error instanceof Error ? error.message : "帖子加载失败。";
        host.replaceChildren(statusRow(message));
        side.replaceChildren(statusRow(message));
      });
  };

  onPageReady(() => {
    void mount();
  });
</script>
