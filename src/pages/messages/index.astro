---
import "../../styles/messages.css";

import Header from "../../components/Header.astro";
import Layout from "../../layouts/Layout.astro";
---

<Layout title="私信">
  <div class="app subpage" data-messages>
    <Header label="← 返回" />

    <main class="messages-main">
      <section class="messages-panel" data-role="threads-panel">
        <header class="messages-head">
          <div>
            <h1>私信</h1>
            <p data-role="threads-summary">正在加载…</p>
          </div>
        </header>
        <button
          type="button"
          class="new-chat"
          data-role="new-chat"
          aria-expanded="false"
          aria-controls="message-contacts"
        >
          <span class="new-chat-icon" aria-hidden="true">
            +
          </span>
          <span>
            <strong>发起聊天</strong>
            <small>从好友列表中选择联系人</small>
          </span>
        </button>
        <div
          class="quick-start"
          id="message-contacts"
          data-role="quick-start"
          hidden
        >
          <div class="quick-start-head">
            <strong>选择联系人</strong>
            <small data-role="quick-start-hint"></small>
          </div>
          <div class="quick-start-list" data-role="quick-start-list"></div>
        </div>
        <div class="thread-list" data-role="thread-list" aria-busy="true">
          {[0, 1, 2, 3].map(() => (
            <div class="thread thread-skeleton" aria-hidden="true">
              <span class="thread-skeleton-avatar"></span>
              <span class="thread-skeleton-copy">
                <span></span>
                <span></span>
              </span>
            </div>
          ))}
        </div>
        <p class="status" data-role="threads-empty" hidden>
          还没有私信，点击「发起聊天」或去对方主页开始会话。
        </p>
      </section>

      <section class="chat-placeholder" data-role="chat-placeholder">
        <svg
          viewBox="0 0 48 48"
          aria-hidden="true"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <path d="M8 9h30v23H21l-9 7v-7H8z"></path>
          <path d="M16 18h14M16 24h9"></path>
        </svg>
        <h2>开始一段对话</h2>
        <p>选择左侧会话，或发起聊天</p>
      </section>

      <section class="chat" data-role="chat" hidden>
        <header class="chat-head">
          <a class="chat-user" data-role="chat-user" href="#">
            <span class="avatar chat-avatar" data-role="chat-avatar"></span>
            <span class="chat-meta">
              <strong data-role="chat-name"></strong>
              <small data-role="chat-handle"></small>
            </span>
          </a>
          <a class="chat-profile" data-role="chat-profile" href="#">
            查看主页
          </a>
        </header>

        <div class="chat-messages" data-role="chat-messages"></div>

        <form class="chat-composer" data-role="chat-form" novalidate>
          <textarea
            class="chat-input"
            data-role="chat-input"
            rows="1"
            maxlength="1000"
            placeholder="写点私信…"
            aria-label="私信内容"
          ></textarea>
          <button
            type="submit"
            class="primary-btn chat-send"
            data-role="chat-send"
            disabled
          >
            发送
          </button>
        </form>
        <p
          class="chat-status"
          data-role="chat-status"
          aria-live="polite"
          hidden
        ></p>
      </section>
    </main>
  </div>
</Layout>

<script>
  import { navigate } from "astro:transitions/client";
  import {
    getConversation,
    getConversations,
    markConversationRead,
    recallDirectMessage,
    sendDirectMessage,
  } from "../../lib/accounts/api";
  import { hydrateSession } from "../../lib/accounts/auth";
  import {
    avatarGradient,
    el,
    relativeTime,
    showToast,
    statusRow,
  } from "../../lib/ui/dom";
  import { ApiError, apiEndpoint } from "../../lib/core/http";
  import { onPageReady } from "../../lib/core/page";
  import type {
    Conversation,
    DirectMessage,
    FeedUser,
    MessageSuggestion,
  } from "../../lib/core/types";
  import {
    conversationPath,
    messagesPath,
    parseMessagePath,
    userPath,
  } from "../../lib/core/urls";

  const MAX_CHARS = 1000;
  const POLL_MS = 2000;

  let pollTimer: number | undefined;

  function stopPolling(): void {
    if (pollTimer !== undefined) {
      window.clearInterval(pollTimer);
      pollTimer = undefined;
    }
  }

  function fillAvatar(node: HTMLElement, user: FeedUser): void {
    node.setAttribute("style", avatarGradient(user.handle));
    const fallback = el("span", "avatar-fallback");
    fallback.textContent = [...user.name.trim()][0]?.toLocaleUpperCase() ?? "?";
    const image = el("img", "avatar-image");
    image.src = user.avatarUrl
      ? user.avatarUrl.startsWith("/")
        ? apiEndpoint(user.avatarUrl)
        : user.avatarUrl
      : "/user.avif";
    image.alt = user.name;
    image.loading = "lazy";
    image.decoding = "async";
    image.fetchPriority = "low";
    image.referrerPolicy = "no-referrer";
    node.replaceChildren(fallback, image);
  }

  function avatarNode(user: FeedUser, className: string): HTMLElement {
    const wrap = el("span", `avatar ${className}`);
    fillAvatar(wrap, user);
    return wrap;
  }

  function renderThreads(
    container: HTMLElement,
    threads: Conversation[],
  ): void {
    container.replaceChildren();
    container.setAttribute("aria-busy", "false");
    if (threads.length === 0) return;
    for (const thread of threads) {
      const row = el("a", "thread");
      row.href = conversationPath(thread.other.handle);
      row.dataset.handle = thread.other.handle;
      if (thread.unread > 0) row.classList.add("is-unread");
      if (thread.other.handle === parseMessagePath(location.pathname)) {
        row.classList.add("is-active");
        row.setAttribute("aria-current", "page");
      }

      row.append(avatarNode(thread.other, "thread-avatar"));

      const body = el("span", "thread-body");
      const top = el("span", "thread-top");
      const name = el("strong");
      name.textContent = thread.other.name;
      const handle = el("small");
      handle.textContent = `@${thread.other.handle}`;
      const time = el("time");
      time.textContent = relativeTime(
        thread.lastMessage?.createdAt ?? thread.lastMessageAt,
      );
      top.append(name, handle, time);

      const preview = el("span", "thread-preview");
      if (thread.lastMessage) {
        if (thread.lastMessage.mine)
          preview.append(document.createTextNode("我："));
        const text = el("span");
        text.dataset.noTranslate = "";
        text.textContent = thread.lastMessage.body;
        preview.append(text);
      } else preview.textContent = "还没有消息";

      body.append(top, preview);
      row.append(body);

      if (thread.unread > 0) {
        const badge = el("span", "thread-badge");
        badge.textContent = thread.unread > 99 ? "99+" : String(thread.unread);
        row.append(badge);
      }
      container.append(row);
    }
  }

  /** 快速发起会话：把互关的人放在最前面，点一下直接开聊 */
  function renderQuickStart(
    hint: HTMLElement,
    container: HTMLElement,
    suggestions: MessageSuggestion[],
  ): void {
    container.replaceChildren();
    const usable = suggestions.filter((person) => person.canDm);
    if (usable.length === 0) {
      hint.textContent = "";
      container.append(
        statusRow("暂时没有可私信的联系人，可前往对方主页发起会话。"),
      );
      return;
    }
    const mutual = usable.filter((person) => person.mutual);
    for (const person of mutual) container.append(quickStartChip(person));
    for (const person of usable.filter((person) => !person.mutual)) {
      container.append(quickStartChip(person));
    }
    hint.textContent = mutual.length
      ? `互关 ${mutual.length} 人，其余是你关注的人`
      : "你关注的人";
  }

  function quickStartChip(person: MessageSuggestion): HTMLElement {
    const chip = el("button", "quick-start-chip");
    chip.type = "button";
    if (person.mutual) chip.classList.add("is-mutual");
    if (person.hasThread) chip.classList.add("is-existing");
    chip.append(avatarNode(person, "quick-start-avatar"));
    const name = el("span", "quick-start-name");
    name.textContent = person.name;
    chip.append(name);
    if (person.mutual) {
      const badge = el("span", "quick-start-badge");
      badge.textContent = "互关";
      chip.append(badge);
    }
    chip.title = person.hasThread
      ? `继续和 ${person.name} 的会话`
      : `给 ${person.name} 发私信`;
    chip.addEventListener(
      "click",
      () => void navigate(conversationPath(person.handle)),
    );
    return chip;
  }

  function messageRow(message: DirectMessage): HTMLElement {
    const row = el("div", `chat-row ${message.mine ? "is-mine" : "is-theirs"}`);
    row.dataset.id = message.id;
    const bubble = el("p", "chat-bubble");
    bubble.textContent = message.body;
    const foot = el("div", "chat-foot");
    const time = el("time", "chat-time");
    time.textContent = relativeTime(message.createdAt);
    foot.append(time);
    if (message.mine) {
      const recall = el("button", "chat-recall");
      recall.type = "button";
      recall.dataset.recall = message.id;
      recall.textContent = "撤回";
      foot.append(recall);
    }
    const wrap = el("div", "chat-bubble-wrap");
    wrap.append(bubble);
    row.append(wrap, foot);
    return row;
  }

  function renderMessages(
    container: HTMLElement,
    messages: DirectMessage[],
    follow = false,
  ): void {
    const top = container.scrollTop;
    const anchor = [
      ...container.querySelectorAll<HTMLElement>(".chat-row"),
    ].find(
      (node) =>
        node.getBoundingClientRect().bottom >
        container.getBoundingClientRect().top,
    );
    const offset = anchor?.getBoundingClientRect().top ?? 0;
    const bottom = container.scrollHeight - top - container.clientHeight < 80;
    container.querySelectorAll(".status").forEach((node) => node.remove());
    const ids = new Set(messages.map((message) => message.id));
    const rows = new Map(
      [...container.querySelectorAll<HTMLElement>(".chat-row")].map((node) => [
        node.dataset.id!,
        node,
      ]),
    );
    for (const [id, node] of rows) if (!ids.has(id)) node.remove();
    let previous: HTMLElement | null = container.querySelector(".chat-more");
    for (const message of messages) {
      const node = rows.get(message.id) ?? messageRow(message);
      const body = node.querySelector<HTMLElement>(".chat-bubble")!;
      if (body.textContent !== message.body) body.textContent = message.body;
      if (
        previous
          ? previous.nextElementSibling !== node
          : container.firstElementChild !== node
      ) {
        if (previous) previous.after(node);
        else container.prepend(node);
      }
      previous = node;
    }
    if (!messages.length)
      container.append(statusRow("还没有消息，打个招呼吧。"));
    if (follow || bottom) container.scrollTop = container.scrollHeight;
    else if (anchor?.isConnected)
      container.scrollTop = top + anchor.getBoundingClientRect().top - offset;
    else container.scrollTop = top;
  }

  async function mountConversation(
    root: HTMLElement,
    handle: string,
  ): Promise<void> {
    const threadsPanel = root.querySelector<HTMLElement>(
      "[data-role=threads-panel]",
    )!;
    const chat = root.querySelector<HTMLElement>("[data-role=chat]")!;
    const list = root.querySelector<HTMLElement>("[data-role=chat-messages]")!;
    const form = root.querySelector<HTMLFormElement>("[data-role=chat-form]")!;
    const input = root.querySelector<HTMLTextAreaElement>(
      "[data-role=chat-input]",
    )!;
    const sendBtn = root.querySelector<HTMLButtonElement>(
      "[data-role=chat-send]",
    )!;
    const status = root.querySelector<HTMLElement>("[data-role=chat-status]")!;
    const userLink = root.querySelector<HTMLAnchorElement>(
      "[data-role=chat-user]",
    )!;
    const profileLink = root.querySelector<HTMLAnchorElement>(
      "[data-role=chat-profile]",
    )!;
    const headAvatar = root.querySelector<HTMLElement>(
      "[data-role=chat-avatar]",
    )!;
    const headName = root.querySelector<HTMLElement>("[data-role=chat-name]")!;
    const headHandle = root.querySelector<HTMLElement>(
      "[data-role=chat-handle]",
    )!;
    const backBtn = root.querySelector<HTMLButtonElement>("[data-role=back]")!;

    threadsPanel.hidden = false;
    root.classList.add("has-conversation");
    root.querySelector<HTMLElement>("[data-role=chat-placeholder]")!.hidden =
      true;
    chat.hidden = false;
    headName.textContent = handle;
    headHandle.textContent = `@${handle}`;
    userLink.href = userPath(handle);
    profileLink.href = userPath(handle);
    input.disabled = true;
    backBtn.textContent = "← 返回私信";
    backBtn.onclick = () => void navigate(messagesPath());

    const setStatus = (message: string) => {
      status.textContent = message;
      status.hidden = !message;
    };

    /** 对方的私信权限不允许时，输入框直接锁掉并说明原因 */
    let canSend = false;
    const syncSendState = () => {
      const length = [...input.value].length;
      sendBtn.disabled =
        sending || !canSend || length === 0 || length > MAX_CHARS;
    };

    let sending = false;
    let composing = false;
    let compositionEndedAt = 0;
    const stored = new Map<string, DirectMessage>();
    let olderCursor: string | null = null;
    let latestCursor: string | null = null;
    let loading = false;
    let paging = false;
    let initialized = false;
    const more = el("button", "ghost-btn chat-more");
    more.type = "button";
    more.textContent = "加载更早消息";
    more.hidden = true;
    const notice = el("button", "ghost-btn chat-new");
    notice.type = "button";
    notice.textContent = "有新消息";
    notice.hidden = true;
    list.before(notice);
    notice.onclick = () => {
      list.scrollTop = list.scrollHeight;
      notice.hidden = true;
    };
    list.addEventListener(
      "scroll",
      () => {
        if (list.scrollHeight - list.clientHeight - list.scrollTop < 80)
          notice.hidden = true;
      },
      { passive: true },
    );
    const applyConversation = (
      user: FeedUser,
      messages: DirectMessage[],
      follow = false,
      recent = true,
    ) => {
      if (!root.isConnected) return;
      userLink.href = userPath(user.handle);
      profileLink.href = userPath(user.handle);
      fillAvatar(headAvatar, user);
      headName.textContent = user.name;
      headHandle.textContent = `@${user.handle}`;
      const away = list.scrollHeight - list.clientHeight - list.scrollTop >= 80;
      const incoming = messages.some(
        (message) => !message.mine && !stored.has(message.id),
      );
      if (recent && !messages.length) stored.clear();
      if (recent && messages.length) {
        const first = messages[0];
        const ids = new Set(messages.map((message) => message.id));
        for (const [id, message] of stored)
          if (
            (message.createdAt > first.createdAt ||
              (message.createdAt === first.createdAt && id >= first.id)) &&
            !ids.has(id)
          )
            stored.delete(id);
      }
      messages.forEach((message) => stored.set(message.id, message));
      if (!more.isConnected) list.prepend(more);
      renderMessages(
        list,
        [...stored.values()].sort(
          (a, b) =>
            a.createdAt.localeCompare(b.createdAt) || a.id.localeCompare(b.id),
        ),
        follow || !initialized,
      );
      if (initialized && incoming && away && !follow) notice.hidden = false;
      if (follow) notice.hidden = true;
      initialized = true;
    };

    const load = async (silent: boolean) => {
      if (loading || paging) return;
      loading = true;
      try {
        if (silent && latestCursor) {
          let after: string | null = latestCursor;
          let unread = 0;
          do {
            const update = await getConversation(handle, null, after);
            if (!root.isConnected) return;
            applyConversation(update.user, update.messages, false, false);
            latestCursor = update.latestCursor ?? latestCursor;
            after = update.nextAfter ?? null;
            unread = update.unread;
          } while (after);
          if (unread > 0) await markConversationRead(handle);
          return;
        }
        const page = await getConversation(handle);
        if (!root.isConnected) return;
        if (!initialized) olderCursor = page.nextCursor ?? null;
        latestCursor = page.latestCursor ?? latestCursor;
        more.hidden = !olderCursor;
        applyConversation(page.user, page.messages);
        canSend = page.canSend !== false;
        input.disabled = !canSend;
        input.placeholder = canSend ? "写点私信…" : "对方设置了私信权限";
        syncSendState();
        if (page.unread > 0) await markConversationRead(handle);
        if (!canSend)
          setStatus(page.hint ?? "对方设置了私信权限，暂时不能发消息。");
        else if (!silent) setStatus("");
      } catch (error) {
        if (!silent) {
          const message =
            error instanceof ApiError && error.status === 404
              ? "找不到这个用户。"
              : "私信加载失败，稍后再试。";
          if (!initialized) list.replaceChildren(statusRow(message));
          setStatus(message);
        }
      } finally {
        loading = false;
      }
    };
    more.onclick = () => {
      if (!olderCursor || paging || loading) return;
      paging = true;
      more.disabled = true;
      void getConversation(handle, olderCursor)
        .then((page) => {
          if (!root.isConnected) return;
          olderCursor = page.nextCursor ?? null;
          more.hidden = !olderCursor;
          applyConversation(page.user, page.messages, false, false);
        })
        .catch((error) =>
          setStatus(
            error instanceof Error ? error.message : "私信加载失败，稍后再试。",
          ),
        )
        .finally(() => {
          paging = false;
          more.disabled = false;
        });
    };

    input.addEventListener("input", () => {
      syncSendState();
      input.style.height = "auto";
      input.style.height = `${Math.min(input.scrollHeight, 128)}px`;
    });
    list.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>(
        "[data-recall]",
      );
      const id = button?.dataset.recall;
      if (!button || !id) return;
      button.disabled = true;
      button.textContent = "撤回中…";
      void recallDirectMessage(handle, id)
        .then((page) => {
          stored.delete(id);
          applyConversation(page.user, page.messages);
          showToast("已撤回");
        })
        .catch(() => {
          button.disabled = false;
          button.textContent = "撤回";
          showToast("撤回失败，请重试");
        });
    });
    input.addEventListener("compositionstart", () => {
      composing = true;
    });
    input.addEventListener("compositionend", () => {
      composing = false;
      compositionEndedAt = performance.now();
    });
    input.addEventListener("keydown", (event) => {
      if (
        composing ||
        event.isComposing ||
        event.key === "Process" ||
        (event.key === "Enter" && performance.now() - compositionEndedAt < 120)
      ) {
        return;
      }
      if (event.key === "Enter" && !event.shiftKey) {
        event.preventDefault();
        form.requestSubmit();
      }
    });
    syncSendState();

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const text = input.value.trim();
      if (
        sending ||
        composing ||
        performance.now() - compositionEndedAt < 120 ||
        !text ||
        !canSend
      )
        return;
      sending = true;
      sendBtn.disabled = true;
      setStatus("发送中…");
      void sendDirectMessage(handle, text)
        .then((page) => {
          input.value = "";
          input.style.height = "";
          setStatus("");
          latestCursor = page.latestCursor ?? latestCursor;
          applyConversation(page.user, page.messages, true);
        })
        .catch((error: unknown) => {
          setStatus(
            error instanceof ApiError && error.message
              ? error.message
              : "发送失败，请重试。",
          );
          showToast("私信发送失败");
        })
        .finally(() => {
          sending = false;
          syncSendState();
        });
    });

    await load(false);

    stopPolling();
    pollTimer = window.setInterval(() => {
      if (document.hidden || sending) return;
      void load(true);
    }, POLL_MS);
  }

  async function mountThreadList(root: HTMLElement): Promise<void> {
    const panel = root.querySelector<HTMLElement>("[data-role=threads-panel]")!;
    const list = root.querySelector<HTMLElement>("[data-role=thread-list]")!;
    const summary = root.querySelector<HTMLElement>(
      "[data-role=threads-summary]",
    )!;
    const empty = root.querySelector<HTMLElement>("[data-role=threads-empty]")!;
    const quickHint = root.querySelector<HTMLElement>(
      "[data-role=quick-start-hint]",
    )!;
    const quickList = root.querySelector<HTMLElement>(
      "[data-role=quick-start-list]",
    )!;
    const backBtn = root.querySelector<HTMLButtonElement>("[data-role=back]")!;

    panel.hidden = false;
    backBtn.onclick = () =>
      history.length > 1 ? history.back() : (location.href = "/");

    try {
      const page = await getConversations();
      if (list.dataset.ssr !== "true") renderThreads(list, page.threads);
      delete list.dataset.ssr;
      const active = parseMessagePath(location.pathname);
      for (const row of list.querySelectorAll<HTMLElement>(".thread")) {
        const selected = row.dataset.handle === active;
        row.classList.toggle("is-active", selected);
        if (selected) row.setAttribute("aria-current", "page");
      }
      renderQuickStart(quickHint, quickList, page.suggestions ?? []);
      empty.hidden = page.threads.length > 0;
      summary.textContent =
        page.unread > 0
          ? `${page.threads.length} 个会话 · ${page.unread} 条未读`
          : `${page.threads.length} 个会话`;
    } catch {
      list.replaceChildren(statusRow("私信列表加载失败，请稍后再试。"));
      summary.textContent = "加载失败";
    }
  }

  onPageReady(() => {
    const root = document.querySelector<HTMLElement>("[data-messages]");
    if (!root || root.dataset.messagesMounted === "true") return;
    root.dataset.messagesMounted = "true";

    document.addEventListener("astro:before-swap", stopPolling, { once: true });
    const newChat = root.querySelector<HTMLButtonElement>(
      "[data-role=new-chat]",
    )!;
    const contacts = root.querySelector<HTMLElement>(
      "[data-role=quick-start]",
    )!;
    newChat.addEventListener("click", () => {
      contacts.hidden = !contacts.hidden;
      newChat.setAttribute("aria-expanded", String(!contacts.hidden));
    });

    void hydrateSession().then((account) => {
      if (!account) {
        void navigate("/");
        return;
      }
      const handle = parseMessagePath(location.pathname);
      void mountThreadList(root);
      if (handle) void mountConversation(root, handle);
    });
  });
</script>
