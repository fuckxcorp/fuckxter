---
import "../../styles/messages.css";

import Header from "../../components/Header.astro";
import Layout from "../../layouts/Layout.astro";
---

<Layout title="私信">
  <div class="app subpage" data-messages>
    <Header />

    <main class="messages-main">
      <section class="messages-panel" data-role="threads-panel">
        <header class="messages-head">
          <div>
            <h1>私信</h1>
            <p data-role="threads-summary">正在加载…</p>
          </div>
        </header>
        <button class="start-chat" type="button" data-role="start-chat">
          <span class="start-chat-avatar" aria-hidden="true">
            ＋
          </span>
          <span class="start-chat-copy">
            <strong>发起聊天</strong>
            <small>从好友列表中选择联系人</small>
          </span>
        </button>
        <div class="thread-list" data-role="thread-list"></div>
        <p class="status" data-role="threads-empty" hidden>
          还没有私信。
        </p>
      </section>

      <section class="chat" data-role="chat">
        <header class="chat-head" data-role="chat-head" hidden>
          <a class="chat-user" data-role="chat-user" href="#">
            <span class="avatar chat-avatar" data-role="chat-avatar"></span>
            <span class="chat-meta">
              <strong data-role="chat-name"></strong>
              <small data-role="chat-handle"></small>
            </span>
          </a>
          <span class="chat-head-actions">
            <button class="chat-delete" type="button" data-role="chat-delete">
              删除会话
            </button>
            <a class="chat-profile" data-role="chat-profile" href="#">
              查看主页
            </a>
          </span>
        </header>

        <div class="chat-empty" data-role="chat-empty">
          <p>从左侧选择一个会话开始聊天</p>
        </div>

        <div class="chat-messages" data-role="chat-messages" hidden></div>

        <form class="chat-composer" data-role="chat-form" novalidate hidden>
          <textarea
            class="chat-input"
            data-role="chat-input"
            rows="1"
            maxlength="1000"
            placeholder="写点私信…"
            aria-label="私信内容"
          ></textarea>
          <button
            type="submit"
            class="primary-btn chat-send"
            data-role="chat-send"
            disabled
          >
            发送
          </button>
        </form>
        <p
          class="chat-status"
          data-role="chat-status"
          aria-live="polite"
          hidden
        ></p>
      </section>
    </main>

    <dialog class="contact-dialog" data-role="contact-dialog">
      <div class="contact-dialog-head">
        <div>
          <strong>发起聊天</strong>
          <small>选择一位好友</small>
        </div>
        <button type="button" data-role="contact-close" aria-label="关闭">
          ×
        </button>
      </div>
      <div class="contact-list" data-role="contact-list"></div>
      <p class="contact-empty" data-role="contact-empty" hidden>
        暂时没有可以私信的好友。
      </p>
    </dialog>
  </div>
</Layout>

<script>
  import { navigate } from "astro:transitions/client";
  import {
    deleteConversation,
    getConversation,
    getConversations,
    markConversationRead,
    recallDirectMessage,
    sendDirectMessage,
  } from "../../lib/accounts/api";
  import { hydrateSession } from "../../lib/accounts/auth";
  import {
    avatarGradient,
    el,
    relativeTime,
    showToast,
    statusRow,
  } from "../../lib/ui/dom";
  import { ApiError, apiEndpoint } from "../../lib/core/http";
  import { onPageReady } from "../../lib/core/page";
  import type {
    Conversation,
    DirectMessage,
    FeedUser,
    MessageSuggestion,
  } from "../../lib/core/types";
  import {
    conversationPath,
    messagesPath,
    parseMessagePath,
    userPath,
  } from "../../lib/core/urls";

  const MAX_CHARS = 1000;
  const POLL_MS = 6000;

  let pollTimer: number | undefined;

  function stopPolling(): void {
    if (pollTimer !== undefined) {
      window.clearInterval(pollTimer);
      pollTimer = undefined;
    }
  }

  function fillAvatar(node: HTMLElement, user: FeedUser): void {
    node.setAttribute("style", avatarGradient(user.handle));
    const fallback = el("span", "avatar-fallback");
    fallback.textContent = [...user.name.trim()][0]?.toLocaleUpperCase() ?? "?";
    const image = el("img", "avatar-image");
    image.src = user.avatarUrl
      ? user.avatarUrl.startsWith("/")
        ? apiEndpoint(user.avatarUrl)
        : user.avatarUrl
      : "/user.avif";
    image.alt = user.name;
    image.loading = "lazy";
    image.decoding = "async";
    image.fetchPriority = "low";
    image.referrerPolicy = "no-referrer";
    node.replaceChildren(fallback, image);
  }

  function avatarNode(user: FeedUser, className: string): HTMLElement {
    const wrap = el("span", `avatar ${className}`);
    fillAvatar(wrap, user);
    return wrap;
  }

  function renderThreads(
    container: HTMLElement,
    threads: Conversation[],
    active?: string,
  ): void {
    container.replaceChildren();
    if (threads.length === 0) return;
    for (const thread of threads) {
      const row = el("a", "thread");
      row.href = conversationPath(thread.other.handle);
      row.dataset.handle = thread.other.handle;
      if (thread.unread > 0) row.classList.add("is-unread");
      if (thread.other.handle === active) row.classList.add("is-active");

      row.append(avatarNode(thread.other, "thread-avatar"));

      const body = el("span", "thread-body");
      const top = el("span", "thread-top");
      const name = el("strong");
      name.textContent = thread.other.name;
      const handle = el("small");
      handle.textContent = `@${thread.other.handle}`;
      const time = el("time");
      time.textContent = relativeTime(
        thread.lastMessage?.createdAt ?? thread.lastMessageAt,
      );
      top.append(name, handle, time);

      const preview = el("span", "thread-preview");
      preview.textContent = thread.lastMessage
        ? `${thread.lastMessage.mine ? "我：" : ""}${thread.lastMessage.body}`
        : "还没有消息";

      body.append(top, preview);
      row.append(body);

      if (thread.unread > 0) {
        const badge = el("span", "thread-badge");
        badge.textContent = thread.unread > 99 ? "99+" : String(thread.unread);
        row.append(badge);
      }
      container.append(row);
    }
  }

  function renderContacts(
    container: HTMLElement,
    empty: HTMLElement,
    suggestions: MessageSuggestion[],
  ): void {
    container.replaceChildren();
    const usable = suggestions.filter((person) => person.canDm);
    empty.hidden = usable.length > 0;
    const mutual = usable.filter((person) => person.mutual);
    for (const person of mutual) container.append(contactRow(person));
    for (const person of usable.filter((person) => !person.mutual)) {
      container.append(contactRow(person));
    }
  }

  function contactRow(person: MessageSuggestion): HTMLElement {
    const row = el("button", "contact-row");
    row.type = "button";
    row.append(avatarNode(person, "contact-avatar"));
    const copy = el("span", "contact-copy");
    const name = el("strong");
    name.textContent = person.name;
    const detail = el("small");
    detail.textContent = `@${person.handle}${person.mutual ? " · 互关" : ""}`;
    copy.append(name, detail);
    row.append(copy);
    row.addEventListener("click", () => {
      row.closest<HTMLDialogElement>("dialog")?.close();
      void navigate(conversationPath(person.handle));
    });
    return row;
  }

  async function loadContacts(root: HTMLElement): Promise<void> {
    const list = root.querySelector<HTMLElement>("[data-role=contact-list]")!;
    const empty = root.querySelector<HTMLElement>("[data-role=contact-empty]")!;
    try {
      const page = await getConversations();
      renderContacts(list, empty, page.suggestions ?? []);
    } catch {
      list.replaceChildren(statusRow("联系人加载失败，请重试。"));
      empty.hidden = true;
    }
  }

  function messageRow(message: DirectMessage): HTMLElement {
    const row = el("div", `chat-row ${message.mine ? "is-mine" : "is-theirs"}`);
    row.dataset.id = message.id;
    const bubble = el("p", "chat-bubble");
    bubble.textContent = message.body;
    const foot = el("div", "chat-foot");
    const time = el("time", "chat-time");
    time.textContent = relativeTime(message.createdAt);
    foot.append(time);
    if (message.mine) {
      const recall = el("button", "chat-recall");
      recall.type = "button";
      recall.dataset.recall = message.id;
      recall.textContent = "撤回";
      foot.append(recall);
    }
    const wrap = el("div", "chat-bubble-wrap");
    wrap.append(bubble);
    row.append(wrap, foot);
    return row;
  }

  function renderMessages(
    container: HTMLElement,
    messages: DirectMessage[],
  ): void {
    container.replaceChildren();
    if (messages.length === 0) {
      container.append(statusRow("还没有消息，打个招呼吧。"));
    }
    for (const message of messages) container.append(messageRow(message));
    container.scrollTop = container.scrollHeight;
  }

  async function mountConversation(
    root: HTMLElement,
    handle: string,
  ): Promise<void> {
    const threadsPanel = root.querySelector<HTMLElement>(
      "[data-role=threads-panel]",
    )!;
    const chat = root.querySelector<HTMLElement>("[data-role=chat]")!;
    const chatHead = root.querySelector<HTMLElement>("[data-role=chat-head]")!;
    const chatEmpty = root.querySelector<HTMLElement>(
      "[data-role=chat-empty]",
    )!;
    const list = root.querySelector<HTMLElement>("[data-role=chat-messages]")!;
    const form = root.querySelector<HTMLFormElement>("[data-role=chat-form]")!;
    const input = root.querySelector<HTMLTextAreaElement>(
      "[data-role=chat-input]",
    )!;
    const sendBtn = root.querySelector<HTMLButtonElement>(
      "[data-role=chat-send]",
    )!;
    const status = root.querySelector<HTMLElement>("[data-role=chat-status]")!;
    const userLink = root.querySelector<HTMLAnchorElement>(
      "[data-role=chat-user]",
    )!;
    const profileLink = root.querySelector<HTMLAnchorElement>(
      "[data-role=chat-profile]",
    )!;
    const headAvatar = root.querySelector<HTMLElement>(
      "[data-role=chat-avatar]",
    )!;
    const headName = root.querySelector<HTMLElement>("[data-role=chat-name]")!;
    const headHandle = root.querySelector<HTMLElement>(
      "[data-role=chat-handle]",
    )!;
    const deleteBtn = root.querySelector<HTMLButtonElement>(
      "[data-role=chat-delete]",
    )!;

    root.classList.add("has-chat");
    threadsPanel.hidden = false;
    chat.hidden = false;
    chatHead.hidden = false;
    chatEmpty.hidden = true;
    list.hidden = false;
    form.hidden = false;
    deleteBtn.onclick = async () => {
      if (!confirm("确定删除与该用户的全部聊天记录吗？")) return;
      deleteBtn.disabled = true;
      try {
        await deleteConversation(handle);
        showToast("会话已删除");
        void navigate(messagesPath());
      } catch (error) {
        deleteBtn.disabled = false;
        showToast(error instanceof Error ? error.message : "删除会话失败");
      }
    };

    const threadList = root.querySelector<HTMLElement>(
      "[data-role=thread-list]",
    )!;
    const summary = root.querySelector<HTMLElement>(
      "[data-role=threads-summary]",
    )!;
    const contactList = root.querySelector<HTMLElement>(
      "[data-role=contact-list]",
    )!;
    const contactEmpty = root.querySelector<HTMLElement>(
      "[data-role=contact-empty]",
    )!;
    void getConversations()
      .then((page) => {
        renderThreads(threadList, page.threads, handle);
        renderContacts(contactList, contactEmpty, page.suggestions ?? []);
        summary.textContent =
          page.unread > 0
            ? `${page.threads.length} 个会话 · ${page.unread} 条未读`
            : `${page.threads.length} 个会话`;
      })
      .catch(() => undefined);

    const setStatus = (message: string) => {
      status.textContent = message;
      status.hidden = !message;
    };

    /** 对方的私信权限不允许时，输入框直接锁掉并说明原因 */
    let canSend = true;
    const syncSendState = () => {
      const length = [...input.value].length;
      sendBtn.disabled = !canSend || length === 0 || length > MAX_CHARS;
    };
    const resizeInput = () => {
      input.style.height = "auto";
      const style = getComputedStyle(input);
      const lineHeight = Number.parseFloat(style.lineHeight);
      const extra =
        Number.parseFloat(style.paddingTop) +
        Number.parseFloat(style.paddingBottom) +
        Number.parseFloat(style.borderTopWidth) +
        Number.parseFloat(style.borderBottomWidth);
      const maxHeight = lineHeight * 5 + extra;
      input.style.height = `${Math.min(input.scrollHeight, maxHeight)}px`;
      input.style.overflowY =
        input.scrollHeight > maxHeight ? "auto" : "hidden";
    };

    let sending = false;
    let lastRendered: string | null = null;

    const applyConversation = (user: FeedUser, messages: DirectMessage[]) => {
      userLink.href = userPath(user.handle);
      profileLink.href = userPath(user.handle);
      fillAvatar(headAvatar, user);
      headName.textContent = user.name;
      headHandle.textContent = `@${user.handle}`;
      const signature = messages.map((message) => message.id).join(",");
      if (signature !== lastRendered) {
        lastRendered = signature;
        renderMessages(list, messages);
      }
    };

    const load = async (silent: boolean) => {
      try {
        const page = await getConversation(handle);
        applyConversation(page.user, page.messages);
        canSend = page.canSend !== false;
        input.disabled = !canSend;
        input.placeholder = canSend ? "写点私信…" : "对方设置了私信权限";
        syncSendState();
        if (page.unread > 0) {
          await markConversationRead(handle);
        }
        if (!canSend) {
          setStatus(page.hint ?? "对方设置了私信权限，暂时不能发消息。");
        } else if (!silent) setStatus("");
      } catch (error) {
        if (!silent) {
          const message =
            error instanceof ApiError && error.status === 404
              ? "找不到这个用户。"
              : "私信加载失败，稍后再试。";
          list.replaceChildren(statusRow(message));
          setStatus(message);
        }
      }
    };

    input.addEventListener("input", () => {
      syncSendState();
      resizeInput();
    });
    list.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>(
        "[data-recall]",
      );
      const id = button?.dataset.recall;
      if (!button || !id) return;
      button.disabled = true;
      button.textContent = "撤回中…";
      void recallDirectMessage(handle, id)
        .then((page) => {
          applyConversation(page.user, page.messages);
          showToast("已撤回");
        })
        .catch(() => {
          button.disabled = false;
          button.textContent = "撤回";
          showToast("撤回失败，请重试");
        });
    });
    input.addEventListener("keydown", (event) => {
      if (event.key === "Enter" && !event.shiftKey) {
        event.preventDefault();
        form.requestSubmit();
      }
    });
    syncSendState();
    resizeInput();

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const text = input.value.trim();
      if (sending || !text || !canSend) return;
      sending = true;
      sendBtn.disabled = true;
      setStatus("发送中…");
      void sendDirectMessage(handle, text)
        .then((page) => {
          input.value = "";
          resizeInput();
          setStatus("");
          applyConversation(page.user, page.messages);
        })
        .catch((error: unknown) => {
          setStatus(
            error instanceof ApiError && error.message
              ? error.message
              : "发送失败，请重试。",
          );
          showToast("私信发送失败");
        })
        .finally(() => {
          sending = false;
          syncSendState();
        });
    });

    await load(false);

    stopPolling();
    pollTimer = window.setInterval(() => {
      if (document.hidden || sending) return;
      void load(true);
    }, POLL_MS);
  }

  async function mountThreadList(root: HTMLElement): Promise<void> {
    const panel = root.querySelector<HTMLElement>("[data-role=threads-panel]")!;
    const list = root.querySelector<HTMLElement>("[data-role=thread-list]")!;
    const summary = root.querySelector<HTMLElement>(
      "[data-role=threads-summary]",
    )!;
    const empty = root.querySelector<HTMLElement>("[data-role=threads-empty]")!;

    panel.hidden = false;
    root.classList.remove("has-chat");

    try {
      const page = await getConversations();
      if (list.dataset.ssr !== "true") renderThreads(list, page.threads);
      delete list.dataset.ssr;
      const contactList = root.querySelector<HTMLElement>(
        "[data-role=contact-list]",
      )!;
      const contactEmpty = root.querySelector<HTMLElement>(
        "[data-role=contact-empty]",
      )!;
      renderContacts(contactList, contactEmpty, page.suggestions ?? []);
      empty.hidden = page.threads.length > 0;
      summary.textContent =
        page.unread > 0
          ? `${page.threads.length} 个会话 · ${page.unread} 条未读`
          : `${page.threads.length} 个会话`;
    } catch (error) {
      if (error instanceof ApiError && error.status === 401) {
        void navigate("/login?next=%2Fmessages");
        return;
      }
      if (list.dataset.ssr !== "true") {
        list.replaceChildren(statusRow("私信列表暂时无法刷新。"));
      }
      const retry = el("button", "retry-btn");
      retry.type = "button";
      retry.textContent = "重试";
      retry.addEventListener("click", () => void mountThreadList(root));
      summary.replaceChildren(document.createTextNode("刷新失败 · "), retry);
    }
  }

  onPageReady(() => {
    const root = document.querySelector<HTMLElement>("[data-messages]");
    if (!root || root.dataset.messagesMounted === "true") return;
    root.dataset.messagesMounted = "true";

    document.addEventListener("astro:before-swap", stopPolling, { once: true });

    const dialog = root.querySelector<HTMLDialogElement>(
      "[data-role=contact-dialog]",
    )!;
    root.querySelector<HTMLButtonElement>("[data-role=start-chat]")!.onclick =
      () => {
        dialog.showModal();
        if (!dialog.querySelector(".contact-row")) void loadContacts(root);
      };
    root.querySelector<HTMLButtonElement>(
      "[data-role=contact-close]",
    )!.onclick = () => dialog.close();
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });

    void hydrateSession().then((account) => {
      if (!account) {
        void navigate("/");
        return;
      }
      const handle = parseMessagePath(location.pathname);
      if (handle) void mountConversation(root, handle);
      else void mountThreadList(root);
    });
  });
</script>
