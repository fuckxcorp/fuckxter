---
import "../../styles/user.css";

import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
---

<Layout title="个人主页">
  <div class="app subpage" data-user>
    <Header />

    <div class="user-main">
      <div class="user-inner">
        <section class="user-head" data-role="user-head" aria-label="用户资料">
          <section class="user-head-card" data-role="user-card">
            <div class="user-row">
              <button
                type="button"
                class="user-avatar"
                data-role="user-avatar"
                aria-label="放大头像"
                aria-haspopup="dialog"
                disabled
              >
                <span class="avatar-fallback" data-role="user-avatar-fallback">
                  ?
                </span>
                <img
                  class="avatar-image"
                  data-role="user-avatar-image"
                  alt=""
                  loading="eager"
                  decoding="async"
                />
              </button>

              <div class="user-who">
                <div class="user-name-line">
                  <strong data-role="user-name">加载中…</strong>
                  <span data-role="user-verified" hidden>
                    <svg
                      class="verified"
                      viewBox="0 0 24 24"
                      aria-label="认证账号"
                      role="img"
                    >
                      <path
                        fill="currentColor"
                        d="M12 1.5l2.6 2 3.2-.4 1.2 3 3 1.2-.4 3.2 2 2.5-2 2.5.4 3.2-3 1.2-1.2 3-3.2-.4-2.6 2-2.6-2-3.2.4-1.2-3-3-1.2.4-3.2-2-2.5 2-2.5-.4-3.2 3-1.2 1.2-3 3.2.4z"
                      ></path>
                      <path
                        class="verified-check"
                        d="M10.7 15.9l-3-3 1.3-1.3 1.7 1.7 4.3-4.3 1.3 1.3z"
                      ></path>
                    </svg>
                  </span>
                </div>
                <div class="user-handle" data-role="user-handle"></div>
                <span class="user-deleted" data-role="user-deleted" hidden>
                  已删除账号
                </span>
              </div>
            </div>

            <p class="user-bio" data-role="user-bio"></p>

            <div class="user-meta">
              <span class="user-chip" data-role="user-chip-gender" hidden>
                <span class="user-chip-label">性别</span>
                <span class="user-chip-value" data-role="user-gender"></span>
              </span>
              <span class="user-chip" data-role="user-chip-region" hidden>
                <span class="user-chip-label">地区</span>
                <span class="user-chip-value" data-role="user-region"></span>
              </span>
              <span class="user-chip" data-role="user-chip-birthday" hidden>
                <span class="user-chip-label">生日</span>
                <span class="user-chip-value" data-role="user-birthday"></span>
              </span>
              <span class="user-chip" data-role="user-chip-created" hidden>
                <span class="user-chip-label">加入时间</span>
                <span class="user-chip-value" data-role="user-created"></span>
              </span>
              <span class="user-chip" data-role="user-chip-posts-count" hidden>
                <span class="user-chip-label">帖子</span>
                <span
                  class="user-chip-value"
                  data-role="user-posts-count"
                ></span>
              </span>
              <a
                class="user-chip user-chip-action"
                data-role="user-chip-followers"
                href="#"
                hidden
              >
                <span class="user-chip-label">粉丝</span>
                <span class="user-chip-value" data-role="user-followers"></span>
              </a>
              <a
                class="user-chip user-chip-action"
                data-role="user-chip-following"
                href="#"
                hidden
              >
                <span class="user-chip-label">关注</span>
                <span class="user-chip-value" data-role="user-following"></span>
              </a>
            </div>

            <div class="user-actions">
              <button
                type="button"
                class="primary-btn"
                data-role="user-edit"
                hidden
              >
                编辑资料
              </button>
              <button
                type="button"
                class="primary-btn"
                data-role="user-follow"
                hidden
              >
                关注
              </button>
              <button
                type="button"
                class="ghost-btn"
                data-role="user-message"
                hidden
              >
                私信
              </button>
              <button
                type="button"
                class="ghost-btn block-btn"
                data-role="user-block"
                hidden
              >
                拉黑
              </button>
            </div>
          </section>
          <p class="status" data-role="user-status" hidden></p>
        </section>
        <div class="user-stream">
          <div class="user-banner-host" data-role="user-banner" hidden>
            <div
              class="user-banner is-media-loading"
              data-role="user-banner-card"
            >
              <img
                class="user-banner-image"
                data-role="user-banner-image"
                alt=""
                loading="eager"
                decoding="async"
              />
            </div>
          </div>
          <section
            class="user-posts"
            data-role="user-posts"
            aria-label="该用户的帖子"
          >
            <article class="post user-post-skeleton" aria-hidden="true">
              <span class="skeleton skeleton-avatar"></span>
              <div class="skeleton-copy">
                <span class="skeleton skeleton-line is-short"></span>
                <span class="skeleton skeleton-line"></span>
                <span class="skeleton skeleton-line is-medium"></span>
              </div>
            </article>
          </section>
        </div>
      </div>
    </div>
  </div>
  <dialog class="avatar-dialog" data-avatar-dialog aria-label="头像大图">
    <button
      type="button"
      class="avatar-dialog-close"
      aria-label="关闭"
      title="关闭"
      autofocus
    >
      &times;
    </button>
    <img alt="" />
  </dialog>
</Layout>

<script>
  import { navigate } from "astro:transitions/client";
  import {
    deletePost,
    getUserProfile,
    getPostsByUser,
    setBlock,
    setFollow,
    toggleLike,
    toggleRepost,
    toggleSave,
  } from "../../lib/accounts/api";
  import {
    getAccount,
    hydrateSession,
    requestAuthentication,
  } from "../../lib/accounts/auth";
  import {
    avatarGradient,
    fmtCount,
    renderPost,
    setFollowButtonState,
    showToast,
    statusRow,
  } from "../../lib/ui/dom";
  import { ApiError, apiEndpoint } from "../../lib/core/http";
  import { onPageReady } from "../../lib/core/page";
  import { openPostShareMenu } from "../../lib/ui/share";
  import type { Post, UserProfile } from "../../lib/core/types";
  import {
    conversationPath,
    parseUserPath,
    postPath,
    userPath,
  } from "../../lib/core/urls";

  const fullTime = (iso: string) =>
    new Date(iso).toLocaleString("zh-CN", { dateStyle: "long" });

  function setUserChip(card: HTMLElement, role: string, value: string): void {
    const chip = card.querySelector<HTMLElement>(
      `[data-role=user-chip-${role}]`,
    )!;
    const output = card.querySelector<HTMLElement>(`[data-role=user-${role}]`)!;
    chip.hidden = !value;
    output.textContent = value;
  }

  function fillUserProfile(
    card: HTMLElement,
    profile: UserProfile,
    isOwn: boolean,
  ): void {
    const role = <T extends Element>(name: string): T =>
      card.querySelector<T>(`[data-role=user-${name}]`)!;
    const avatar = role<HTMLButtonElement>("avatar");
    const avatarFallback = role<HTMLSpanElement>("avatar-fallback");
    const avatarImage = role<HTMLImageElement>("avatar-image");
    const verified = role<HTMLElement>("verified");
    const edit = role<HTMLButtonElement>("edit");
    const follow = role<HTMLButtonElement>("follow");
    const message = role<HTMLButtonElement>("message");
    const block = role<HTMLButtonElement>("block");
    const followersChip = role<HTMLAnchorElement>("chip-followers");
    const followingChip = role<HTMLAnchorElement>("chip-following");
    const deleted = Boolean(profile.deleted);

    avatar.disabled = false;
    avatar.dataset.handle = profile.handle;
    avatar.title = "放大头像";
    avatar.setAttribute(
      "aria-label",
      `放大 ${profile.name}（@${profile.handle}）的头像`,
    );
    avatar.setAttribute("style", avatarGradient(profile.handle));
    avatarFallback.textContent =
      [...profile.name.trim()][0]?.toLocaleUpperCase() ?? "?";
    avatarImage.src = profile.avatarUrl
      ? profile.avatarUrl.startsWith("/")
        ? apiEndpoint(profile.avatarUrl)
        : profile.avatarUrl
      : "/user.avif";
    avatarImage.alt = profile.name;

    role<HTMLElement>("name").textContent = profile.name;
    role<HTMLElement>("handle").textContent = `@${profile.handle}`;
    role<HTMLElement>("bio").textContent =
      profile.bio || "这个人很懒，什么都没有写。";
    verified.toggleAttribute("hidden", !profile.verified);
    role<HTMLElement>("deleted").toggleAttribute("hidden", !deleted);
    followersChip.href = `${userPath(profile.handle)}/followers`;
    followingChip.href = `${userPath(profile.handle)}/following`;

    setUserChip(card, "gender", profile.gender);
    setUserChip(card, "region", profile.region);
    setUserChip(card, "birthday", profile.birthday);
    setUserChip(card, "created", fullTime(profile.createdAt));
    setUserChip(card, "posts-count", String(profile.stats.posts));
    setUserChip(card, "followers", String(profile.stats.followers));
    setUserChip(card, "following", String(profile.stats.following));

    edit.hidden = !isOwn || deleted;
    const blocked = Boolean(profile.viewer.blocked);
    follow.hidden = isOwn || blocked || deleted;
    message.hidden = isOwn || blocked || deleted;
    block.hidden = isOwn || deleted;
    block.dataset.handle = profile.handle;
    block.textContent = blocked ? "已拉黑" : "拉黑";
    block.classList.toggle("is-danger", blocked);
    message.dataset.handle = profile.handle;
    // 对方的私信权限不允许时，按钮留着但置灰，并用 title 说明原因
    const dmBlocked =
      !isOwn && !blocked && !deleted && profile.viewer.canMessage === false;
    message.disabled = dmBlocked;
    message.title = dmBlocked ? "对方设置了私信权限，暂时不能给他发私信" : "";
    if (!isOwn) {
      follow.dataset.handle = profile.handle;
      follow.dataset.following = String(profile.viewer.following);
      follow.textContent = profile.viewer.following ? "已关注" : "关注";
      follow.classList.toggle("ghost-btn", profile.viewer.following);
    }
  }

  /**
   * 列表状态单独放一份：重新渲染只换数据，点击事件只绑一次，
   * 免得重复绑定导致一次点击跑两遍。
   */
  const postList: {
    posts: Post[];
    onChange: () => void;
    reload?: () => Promise<void>;
  } = {
    posts: [],
    onChange: () => {},
  };

  function bindPostList(
    root: HTMLElement,
    posts: Post[],
    onChange: () => void,
    reload?: () => Promise<void>,
  ) {
    postList.posts = posts;
    postList.onChange = onChange;
    if (reload) postList.reload = reload;
    root.replaceChildren(
      ...(posts.length === 0
        ? [statusRow("还没有发过帖子。")]
        : posts.map((post) => renderPost(post))),
    );

    if (root.dataset.postListBound === "true") return;
    root.dataset.postListBound = "true";

    root.addEventListener("click", async (event) => {
      const target = event.target as HTMLElement;

      const avatarLink = target.closest<HTMLElement>(".avatar-link");
      if (avatarLink?.dataset.handle) {
        event.preventDefault();
        navigate(userPath(avatarLink.dataset.handle));
        return;
      }

      const followButton = target.closest<HTMLButtonElement>(".follow-btn");
      if (followButton?.dataset.handle) {
        if (!getAccount()) {
          requestAuthentication();
          return;
        }
        followButton.disabled = true;
        const following = followButton.dataset.following !== "true";
        try {
          const result = await setFollow(
            followButton.dataset.handle,
            following,
          );
          setFollowButtonState(followButton, result.following);
        } catch (error) {
          if (error instanceof ApiError && error.status === 401) {
            requestAuthentication();
          }
        } finally {
          followButton.disabled = false;
        }
        return;
      }

      const btn = target.closest<HTMLButtonElement>(".action");
      const article = (btn ?? target).closest<HTMLElement>(".post");
      const id = article?.dataset.postId;
      const post = postList.posts.find((p) => p.id === id);
      if (!post) return;

      if (!btn) {
        navigate(postPath(post));
        return;
      }
      const action = btn.dataset.action;

      if (action === "save") {
        const willSave = !btn.classList.contains("is-saved");
        btn.classList.toggle("is-saved", willSave);
        try {
          await toggleSave(post, willSave);
        } catch {
          btn.classList.toggle("is-saved", !willSave);
        }
        return;
      }

      if (action === "delete") {
        if (!confirm("确定删除这条帖子吗？")) return;
        btn.disabled = true;
        try {
          await deletePost(post.id);
          const index = postList.posts.indexOf(post);
          if (index !== -1) postList.posts.splice(index, 1);
          article?.remove();
          const userCard = document.querySelector<HTMLElement>(
            "[data-role=user-card]",
          );
          if (userCard) {
            setUserChip(userCard, "posts-count", String(postList.posts.length));
          }
          if (postList.posts.length === 0) {
            root.replaceChildren(statusRow("还没有发过帖子。"));
          }
          showToast("帖子已删除");
          // 再按服务端结果刷一遍列表，避免本地状态和实际内容不一致
          await postList.reload?.();
        } catch (error) {
          btn.disabled = false;
          showToast(error instanceof Error ? error.message : "删除失败");
        }
        return;
      }

      if (action === "reply") {
        if (!getAccount()) {
          requestAuthentication();
          return;
        }
        navigate(`${postPath(post)}#reply`);
        return;
      }

      if (action === "like" || action === "repost") {
        const cls = action === "like" ? "is-liked" : "is-reposted";
        const willActive = !btn.classList.contains(cls);
        btn.classList.toggle(cls, willActive);
        try {
          let count: number;
          if (action === "like") {
            ({ likes: count } = await toggleLike(post.id, willActive));
          } else {
            ({ reposts: count } = await toggleRepost(post.id, willActive));
          }
          btn.querySelector<HTMLElement>(".action-count")!.textContent =
            count > 0 ? fmtCount(count) : "";
          btn.classList.toggle(cls, willActive);
          postList.onChange();
        } catch {
          btn.classList.toggle(cls, !willActive);
        }
        return;
      }

      if (action === "share") {
        const result = await openPostShareMenu(btn, post);
        if (result === "copied") showToast("链接已复制");
        if (result === "shared") showToast("已分享");
        if (result === "failed") showToast("分享失败");
      }
    });
  }

  const mount = async () => {
    const container = document.querySelector<HTMLElement>("[data-user]");
    if (!container) return;
    if (container.dataset.userMounted === "true") return;
    container.dataset.userMounted = "true";
    const sessionPromise = hydrateSession().then(() => getAccount());

    container
      .querySelector<HTMLButtonElement>("[data-role=back]")!
      .addEventListener("click", () =>
        history.length > 1 ? history.back() : (location.href = "/"),
      );

    const card = container.querySelector<HTMLElement>("[data-role=user-card]")!;
    const avatar = card.querySelector<HTMLButtonElement>(
      "[data-role=user-avatar]",
    )!;
    const avatarImage = card.querySelector<HTMLImageElement>(
      "[data-role=user-avatar-image]",
    )!;
    const avatarDialog = document.querySelector<HTMLDialogElement>(
      "[data-avatar-dialog]",
    )!;
    const enlargedAvatar = avatarDialog.querySelector<HTMLImageElement>("img")!;
    avatar.addEventListener("click", () => {
      enlargedAvatar.src = avatarImage.currentSrc || avatarImage.src;
      enlargedAvatar.alt = avatarImage.alt;
      avatarDialog.showModal();
    });
    avatarDialog
      .querySelector("button")!
      .addEventListener("click", () => avatarDialog.close());
    avatarDialog.addEventListener("click", (event) => {
      if (event.target === avatarDialog) avatarDialog.close();
    });
    enlargedAvatar.addEventListener("error", () => {
      avatarDialog.close();
      showToast("头像加载失败，请重试");
    });
    document.addEventListener("astro:before-swap", () => avatarDialog.close(), {
      once: true,
    });
    const userStatus = container.querySelector<HTMLElement>(
      "[data-role=user-status]",
    )!;
    const postsRoot = container.querySelector<HTMLElement>(
      "[data-role=user-posts]",
    )!;
    const bannerHost = container.querySelector<HTMLElement>(
      "[data-role=user-banner]",
    )!;
    const bannerCard = container.querySelector<HTMLElement>(
      "[data-role=user-banner-card]",
    )!;
    const bannerImage = container.querySelector<HTMLImageElement>(
      "[data-role=user-banner-image]",
    )!;
    const edit = container.querySelector<HTMLButtonElement>(
      "[data-role=user-edit]",
    )!;
    const follow = container.querySelector<HTMLButtonElement>(
      "[data-role=user-follow]",
    )!;
    const message = container.querySelector<HTMLButtonElement>(
      "[data-role=user-message]",
    )!;
    const block = container.querySelector<HTMLButtonElement>(
      "[data-role=user-block]",
    )!;
    edit.addEventListener("click", () => navigate("/settings/profile"));
    block.addEventListener("click", async () => {
      const handle = block.dataset.handle;
      if (!handle || !currentProfile) return;
      if (!getAccount()) {
        requestAuthentication();
        return;
      }
      const willBlock = !currentProfile.viewer.blocked;
      block.disabled = true;
      try {
        await setBlock(handle, willBlock);
        currentProfile.viewer.blocked = willBlock;
        fillUserProfile(card, currentProfile, false);
        bindPostList(postsRoot, await getPostsByUser(handle), () => {});
        showToast(willBlock ? "已拉黑" : "已取消拉黑");
      } catch {
        showToast("操作失败，请重试");
      } finally {
        block.disabled = false;
      }
    });
    message.addEventListener("click", () => {
      if (!message.dataset.handle) return;
      if (!getAccount()) {
        requestAuthentication();
        return;
      }
      navigate(conversationPath(message.dataset.handle));
    });
    follow.addEventListener("click", async () => {
      if (!follow.dataset.handle) return;
      if (!getAccount()) {
        requestAuthentication();
        return;
      }
      follow.disabled = true;
      const next = follow.dataset.following !== "true";
      try {
        const result = await setFollow(follow.dataset.handle, next);
        follow.dataset.following = String(result.following);
        follow.textContent = result.following ? "已关注" : "关注";
        follow.classList.toggle("ghost-btn", result.following);
      } catch (error) {
        if (error instanceof ApiError && error.status === 401) {
          requestAuthentication();
        }
      } finally {
        follow.disabled = false;
      }
    });
    bannerImage.addEventListener(
      "load",
      () => bannerCard.classList.add("is-media-ready"),
      { once: true },
    );
    bannerImage.addEventListener(
      "error",
      () => {
        bannerHost.hidden = true;
      },
      { once: true },
    );

    const pathHandle = parseUserPath(location.pathname);
    const handlePromise = (
      pathHandle
        ? Promise.resolve(pathHandle)
        : sessionPromise.then((account) => account?.profile.handle ?? "")
    ).then((value) => value.replace(/^@/, "").toLowerCase());
    let currentProfile: UserProfile | null = null;

    void handlePromise
      .then((handle) => {
        if (!handle) {
          navigate("/");
          return;
        }

        void getUserProfile(handle)
          .then((profile) => {
            currentProfile = profile;
            const isOwn = getAccount()?.profile.handle === profile.handle;
            document.title = `@${handle} | FuckXter`;
            userStatus.hidden = true;
            card.hidden = false;
            fillUserProfile(card, profile, isOwn);
            if (profile.headerUrl) {
              bannerCard.classList.remove("is-media-ready");
              bannerCard.classList.add("is-media-loading");
              bannerImage.src = profile.headerUrl.startsWith("/")
                ? apiEndpoint(profile.headerUrl)
                : profile.headerUrl;
              bannerImage.alt = `${profile.name} 的主页头图`;
              bannerHost.hidden = false;
            } else {
              bannerImage.removeAttribute("src");
              bannerHost.hidden = true;
            }
          })
          .catch((error: unknown) => {
            bannerHost.hidden = true;
            card.hidden = true;
            userStatus.hidden = false;
            userStatus.textContent =
              error instanceof Error ? error.message : "用户加载失败。";
          });

        const reloadPosts = async (): Promise<void> => {
          try {
            const posts = await getPostsByUser(handle);
            bindPostList(postsRoot, posts, () => {}, reloadPosts);
          } catch (error: unknown) {
            postsRoot.replaceChildren(
              statusRow(
                error instanceof Error ? error.message : "帖子加载失败。",
              ),
            );
          }
        };
        void reloadPosts();
      })
      .catch((error: unknown) => {
        bannerHost.hidden = true;
        card.hidden = true;
        userStatus.hidden = false;
        userStatus.textContent =
          error instanceof Error ? error.message : "用户加载失败。";
        postsRoot.replaceChildren();
      });

    void sessionPromise.then((account) => {
      if (!currentProfile) return;
      fillUserProfile(
        card,
        currentProfile,
        account?.profile.handle === currentProfile.handle,
      );
    });
  };

  onPageReady(() => {
    void mount();
  });
</script>
