---
import "../styles/saved.css";

import Notice from "../layouts/Notice.astro";
---

<Notice title="收藏" root="data-saved" subtitle="你保存的帖子">
  <div class="notice-list" data-role="saved-list"></div>
  <p class="status" data-role="saved-empty" hidden>
    还没有收藏内容
  </p>
</Notice>

<script>
  import { navigate } from "astro:transitions/client";
  import { hydrateSession } from "../lib/accounts/auth";
  import { onPageReady } from "../lib/core/page";
  import { mountSavedSettings } from "../lib/settings/saved";

  onPageReady(() => {
    const root = document.querySelector<HTMLElement>("[data-saved]");
    if (!root || root.dataset.savedMounted === "true") return;
    root.dataset.savedMounted = "true";

    void hydrateSession().then((account) => {
      if (!account) {
        void navigate("/");
        return;
      }
      mountSavedSettings(root);
    });
  });
</script>
