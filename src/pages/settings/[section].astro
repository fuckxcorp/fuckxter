---
import FuckxterSettingsPage from "../../components/FuckxterSettingsPage.astro";

type SettingsSection = "profile" | "security" | "saved" | "storage";

interface Props {
  section: SettingsSection;
}

export function getStaticPaths() {
  return [
    { params: { section: "profile" }, props: { section: "profile" } },
    { params: { section: "security" }, props: { section: "security" } },
    { params: { section: "saved" }, props: { section: "saved" } },
    { params: { section: "storage" }, props: { section: "storage" } },
  ];
}

const { section } = Astro.props;
---

<FuckxterSettingsPage section={section} />
