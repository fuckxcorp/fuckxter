---
import "../styles/user.css";

import Header from "../components/Header.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="用户关系">
  <div class="app subpage" data-connections>
    <Header />
    <main class="connections-main">
      <section class="connections-panel">
        <header class="connections-head">
          <h1 data-role="connections-title">用户关系</h1>
          <p data-role="connections-summary">正在加载…</p>
        </header>
        <div class="user-list" data-role="connections-list"></div>
      </section>
    </main>
  </div>
</Layout>

<script>
  import { getUserList } from "../lib/accounts/api";
  import { authorAvatar, el, statusRow } from "../lib/ui/dom";
  import { onPageReady } from "../lib/core/page";
  import { userPath } from "../lib/core/urls";

  const renderUsers = (users: Awaited<ReturnType<typeof getUserList>>) => {
    const fragment = document.createDocumentFragment();
    if (users.length === 0) {
      fragment.append(statusRow("这里还没有用户。"));
      return fragment;
    }
    for (const user of users) {
      const row = el("div", "user-list-item");
      const avatar = authorAvatar(
        user.handle,
        user.name,
        "avatar",
        user.avatarUrl,
      );
      const identity = el("a", "user-list-identity");
      identity.href = userPath(user.handle);
      const name = el("strong");
      name.textContent = user.name;
      const handle = el("span");
      handle.textContent = `@${user.handle}`;
      identity.append(name, handle);

      const details = el("div", "user-list-details");
      const bio = el("p");
      bio.textContent = user.bio || "这个人很懒，什么都没有写。";
      const stats = el("div", "user-list-stats");
      const stat = (label: string, value: number) => {
        const item = el("span");
        item.textContent = `${label} ${value}`;
        stats.append(item);
      };
      stat("帖子", user.stats.posts);
      stat("粉丝", user.stats.followers);
      stat("关注", user.stats.following);
      const joined = el("time", "user-list-joined");
      joined.dateTime = user.createdAt;
      joined.textContent = `加入于 ${new Date(user.createdAt).toLocaleDateString("zh-CN")}`;
      details.append(bio, stats, joined);

      row.append(avatar, identity, details);
      fragment.append(row);
    }
    return fragment;
  };

  onPageReady(() => {
    const root = document.querySelector<HTMLElement>("[data-connections]");
    if (!root || root.dataset.connectionsMounted === "true") return;
    root.dataset.connectionsMounted = "true";

    root
      .querySelector<HTMLButtonElement>("[data-role=back]")!
      .addEventListener("click", () =>
        history.length > 1 ? history.back() : (location.href = "/"),
      );

    const match = location.pathname.match(
      /^\/user\/([^/]+)\/(followers|following)\/?$/i,
    );
    const title = root.querySelector<HTMLElement>(
      "[data-role=connections-title]",
    )!;
    const summary = root.querySelector<HTMLElement>(
      "[data-role=connections-summary]",
    )!;
    const list = root.querySelector<HTMLElement>(
      "[data-role=connections-list]",
    )!;
    if (!match) {
      title.textContent = "未找到用户";
      summary.textContent = "关注关系地址无效";
      return;
    }

    const handle = decodeURIComponent(match[1]);
    const kind = match[2].toLowerCase() as "followers" | "following";
    title.textContent = kind === "followers" ? "粉丝" : "关注";
    document.title = `${title.textContent} · @${handle} | FuckXter`;
    if (list.dataset.ssr === "true") return;

    void getUserList(handle, kind)
      .then((users) => {
        summary.textContent = `${users.length} 个用户`;
        list.replaceChildren(renderUsers(users));
      })
      .catch((error) => {
        summary.textContent =
          error instanceof Error ? error.message : "用户加载失败";
      });
  });
</script>
