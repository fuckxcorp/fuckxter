---
import "../../styles/login.css";

import Layout from "../../layouts/Layout.astro";
---

<Layout title="登录">
  <div class="app subpage login-page" data-login>
    <div class="login-split">
      <h1 class="login-brand-panel">
        <img
          class="logo-img logo-light login-logo"
          src="/fuckxter_bk.avif"
          alt="FuckXter"
          width="515"
          height="128"
          decoding="async"
        />
        <img
          class="logo-img logo-dark login-logo"
          src="/fuckxter_wh.avif"
          alt="FuckXter"
          width="514"
          height="514"
          decoding="async"
        />
      </h1>

      <section class="login-card">
        <div data-role="login-body">
          <form data-role="login-form" novalidate>
            <label class="field">
              <span class="field-label">邮箱</span>
              <input
                name="identifier"
                type="email"
                autocomplete="username"
                placeholder="you@example.com"
                required
              />
            </label>
            <label class="field" data-role="password-field">
              <span class="field-label">密码</span>
              <input
                name="password"
                type="password"
                autocomplete="current-password"
                placeholder="密码"
                required
              />
            </label>
            <div class="field" data-role="forgot-code-field" hidden>
              <span class="field-label">邮箱验证码</span>
              <div class="login-code-row">
                <input
                  name="forgotCode"
                  type="text"
                  inputmode="numeric"
                  autocomplete="one-time-code"
                  maxlength="6"
                  placeholder="6 位验证码"
                />
                <button
                  class="ghost-btn"
                  type="button"
                  data-role="send-forgot-code"
                >
                  发送验证码
                </button>
              </div>
              <input
                name="newPassword"
                type="password"
                autocomplete="new-password"
                minlength="8"
                placeholder="新密码"
              />
              <input
                name="confirmPassword"
                type="password"
                autocomplete="new-password"
                minlength="8"
                placeholder="确认新密码"
              />
            </div>
            <label class="field" data-role="code-field" hidden>
              <span class="field-label">动态验证码</span>
              <input
                name="code"
                type="text"
                inputmode="numeric"
                autocomplete="one-time-code"
                maxlength="6"
                placeholder="6 位验证码"
              />
            </label>
            <label class="field" data-role="recovery-field" hidden>
              <span class="field-label">恢复码</span>
              <input
                name="recoveryCode"
                type="text"
                autocomplete="off"
                spellcheck="false"
                placeholder="XXXX-XXXX"
              />
            </label>
            <p
              class="form-status"
              data-role="login-status"
              aria-live="polite"
            ></p>
            <button class="primary-btn" type="submit" data-role="login-submit">
              登录
            </button>
          </form>

          <div class="login-links">
            <button type="button" data-role="use-forgot">
              忘记密码
            </button>
            <button type="button" data-role="use-recovery">
              用恢复码登录
            </button>
          </div>

          <p class="form-hint">
            未注册的用户将会自动注册，注册表示你同意我们的用户协议。
          </p>
        </div>

        <div data-role="recovery-notice" hidden>
          <p class="login-note" data-role="recovery-notice-text"></p>
          <div class="login-links">
            <a href="/settings/security">去重新生成</a>
            <button type="button" data-role="recovery-notice-continue">
              稍后再说
            </button>
          </div>
        </div>

        <div data-role="restored-notice" hidden>
          <p class="login-note">
            你之前申请过删除账号，本次登录已经自动取消删除，账号和内容都还在。
          </p>
          <div class="login-links">
            <button type="button" data-role="restored-continue">
              继续
            </button>
          </div>
        </div>
      </section>
    </div>
  </div>
</Layout>

<script>
  import { hydrateSession, signIn } from "../../lib/accounts/auth";
  import { ApiError } from "../../lib/core/http";
  import { onPageReady } from "../../lib/core/page";
  import { isValidEmail } from "../../lib/core/validation";

  /** 只接受站内路径，避免 ?next= 被拿去做跳转钓鱼。 */
  function nextPath(): string {
    const raw = new URL(location.href).searchParams.get("next") ?? "/";
    if (!raw.startsWith("/") || raw.startsWith("//") || raw.includes("\\")) {
      return "/";
    }
    return raw;
  }

  onPageReady(() => {
    const root = document.querySelector<HTMLElement>("[data-login]");
    if (!root || root.dataset.loginMounted === "true") return;
    root.dataset.loginMounted = "true";

    const form = root.querySelector<HTMLFormElement>("[data-role=login-form]")!;
    const identifier =
      form.querySelector<HTMLInputElement>("[name=identifier]")!;
    const password = form.querySelector<HTMLInputElement>("[name=password]")!;
    const passwordField = root.querySelector<HTMLElement>(
      "[data-role=password-field]",
    )!;
    const forgotCodeField = root.querySelector<HTMLElement>(
      "[data-role=forgot-code-field]",
    )!;
    const forgotCodeInput =
      forgotCodeField.querySelector<HTMLInputElement>("[name=forgotCode]")!;
    const newPassword =
      forgotCodeField.querySelector<HTMLInputElement>("[name=newPassword]")!;
    const confirmPassword = forgotCodeField.querySelector<HTMLInputElement>(
      "[name=confirmPassword]",
    )!;
    const sendForgotCode = root.querySelector<HTMLButtonElement>(
      "[data-role=send-forgot-code]",
    )!;
    const codeField = root.querySelector<HTMLElement>(
      "[data-role=code-field]",
    )!;
    const codeInput = codeField.querySelector<HTMLInputElement>("[name=code]")!;
    const recoveryField = root.querySelector<HTMLElement>(
      "[data-role=recovery-field]",
    )!;
    const recoveryInput = recoveryField.querySelector<HTMLInputElement>(
      "[name=recoveryCode]",
    )!;
    const status = root.querySelector<HTMLElement>("[data-role=login-status]")!;
    const submit = root.querySelector<HTMLButtonElement>(
      "[data-role=login-submit]",
    )!;
    const recoveryToggle = root.querySelector<HTMLButtonElement>(
      "[data-role=use-recovery]",
    )!;
    const forgotToggle = root.querySelector<HTMLButtonElement>(
      "[data-role=use-forgot]",
    )!;
    const loginBody = root.querySelector<HTMLElement>(
      "[data-role=login-body]",
    )!;
    const recoveryNotice = root.querySelector<HTMLElement>(
      "[data-role=recovery-notice]",
    )!;
    const recoveryNoticeText = root.querySelector<HTMLElement>(
      "[data-role=recovery-notice-text]",
    )!;
    const recoveryNoticeContinue = root.querySelector<HTMLButtonElement>(
      "[data-role=recovery-notice-continue]",
    )!;
    const restoredNotice = root.querySelector<HTMLElement>(
      "[data-role=restored-notice]",
    )!;
    const restoredContinue = root.querySelector<HTMLButtonElement>(
      "[data-role=restored-continue]",
    )!;

    /** totp：密码 + 动态验证码；recovery：密码 + 恢复码。 */
    let secondFactor: "totp" | "recovery" = "totp";
    let forgot = false;
    /** 只有密码验证通过、服务端要求 2FA 之后才显示验证码输入框。 */
    let codeRequested = false;

    const render = () => {
      recoveryField.hidden = forgot || secondFactor !== "recovery";
      forgotCodeField.hidden = !forgot;
      codeField.hidden =
        forgot ||
        secondFactor !== "totp" ||
        !codeRequested ||
        !isValidEmail(identifier.value.trim()) ||
        !password.value;
      // 恢复码代替密码使用，所以这个模式下不显示密码输入框
      passwordField.hidden = forgot || secondFactor === "recovery";
      recoveryToggle.hidden = forgot;
      forgotToggle.textContent = forgot ? "返回密码登录" : "忘记密码";
      recoveryToggle.textContent =
        secondFactor === "recovery" ? "改用密码登录" : "用恢复码登录";
      submit.textContent = forgot
        ? "重置密码"
        : secondFactor === "recovery"
          ? "用恢复码登录"
          : codeRequested
            ? "验证并登录"
            : "登录";
    };

    const setStatus = (message: string) => {
      status.textContent = message;
    };

    /** 用恢复码进来之后提醒重新生成，用完时语气更重。 */
    const showRecoveryNotice = (remaining: number) => {
      loginBody.hidden = true;
      recoveryNotice.hidden = false;
      recoveryNoticeText.textContent =
        remaining > 0
          ? `已使用一个恢复码登录，还剩 ${remaining} 个。建议重新生成一份新的。`
          : "你的恢复码已经全部用完，建议立即重新生成，否则下次就进不来了。";
      recoveryNotice.classList.toggle("is-warning", remaining === 0);
    };

    recoveryNoticeContinue.addEventListener("click", () => {
      location.href = nextPath();
    });

    restoredContinue.addEventListener("click", () => {
      location.href = nextPath();
    });

    recoveryToggle.addEventListener("click", () => {
      secondFactor = secondFactor === "recovery" ? "totp" : "recovery";
      codeRequested = false;
      codeInput.value = "";
      setStatus("");
      render();
      (secondFactor === "recovery" ? recoveryInput : password).focus();
    });

    forgotToggle.addEventListener("click", () => {
      forgot = !forgot;
      secondFactor = "totp";
      codeRequested = false;
      codeInput.value = "";
      forgotCodeInput.value = "";
      newPassword.value = "";
      confirmPassword.value = "";
      setStatus("");
      render();
      if (forgot && !isValidEmail(identifier.value.trim())) identifier.focus();
      else (forgot ? forgotCodeInput : password).focus();
    });

    sendForgotCode.addEventListener("click", () => {
      const email = identifier.value.trim();
      if (!isValidEmail(email)) {
        setStatus("请先输入有效的邮箱地址");
        identifier.focus();
        return;
      }
      setStatus("验证码发送功能即将开放");
    });

    identifier.addEventListener("input", () => {
      codeRequested = false;
      codeInput.value = "";
      render();
    });
    password.addEventListener("input", () => {
      if (!password.value) {
        codeRequested = false;
        codeInput.value = "";
      }
      render();
    });

    // 已经登录过就直接回目标页
    void hydrateSession().then((account) => {
      if (account) location.href = nextPath();
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const email = identifier.value.trim();
      if (!isValidEmail(email)) {
        identifier.setAttribute("aria-invalid", "true");
        setStatus("请输入有效的邮箱地址");
        identifier.focus();
        return;
      }
      identifier.removeAttribute("aria-invalid");

      if (forgot) {
        if (!forgotCodeInput.value.trim()) {
          setStatus("请输入邮箱验证码");
          forgotCodeInput.focus();
          return;
        }
        if (newPassword.value.length < 8) {
          setStatus("新密码至少需要 8 个字符");
          newPassword.focus();
          return;
        }
        if (newPassword.value !== confirmPassword.value) {
          setStatus("两次输入的新密码不一致");
          confirmPassword.focus();
          return;
        }
        setStatus("密码重置功能即将开放");
        return;
      }

      if (secondFactor === "totp" && !password.value) {
        setStatus("请输入密码");
        password.focus();
        return;
      }

      const code = codeInput.value.trim();
      const recoveryCode = recoveryInput.value.trim();
      if (secondFactor === "recovery" && !recoveryCode) {
        setStatus("请输入恢复码");
        recoveryInput.focus();
        return;
      }
      if (secondFactor === "totp" && codeRequested && !code) {
        setStatus("请输入动态验证码");
        codeInput.focus();
        return;
      }

      submit.disabled = true;
      setStatus("登录中…");
      try {
        const result = await signIn({
          identifier: email,
          password: secondFactor === "recovery" ? "" : password.value,
          code: secondFactor === "totp" ? code : undefined,
          recoveryCode: secondFactor === "recovery" ? recoveryCode : undefined,
        });
        // 之前申请过删除，登录即取消
        if (result.restored) {
          loginBody.hidden = true;
          restoredNotice.hidden = false;
          return;
        }
        // 只有确实开了 2FA、真的消费掉一个恢复码时才提醒
        if (secondFactor === "recovery" && result.account.twoFactorEnabled) {
          showRecoveryNotice(result.account.recoveryCodeCount);
          return;
        }
        location.href = nextPath();
      } catch (error) {
        const apiError = error instanceof ApiError ? error : null;
        if (apiError?.code === "TWO_FACTOR_REQUIRED") {
          codeRequested = true;
          setStatus("该账号已开启双重验证，请输入动态验证码。");
          render();
          codeInput.focus();
        } else {
          if (
            apiError?.code === "INVALID_TOTP" ||
            apiError?.code === "INVALID_RECOVERY_CODE"
          ) {
            codeRequested = true;
            render();
            (secondFactor === "recovery" ? recoveryInput : codeInput).focus();
          }
          setStatus(
            error instanceof Error ? error.message : "登录失败，请重试。",
          );
        }
      } finally {
        submit.disabled = false;
      }
    });

    render();
    identifier.focus();
  });
</script>
