---
import "../styles/home.css";

import Layout from "../layouts/Layout.astro";
---

<Layout title="FuckXter">
  <div class="splash" data-role="splash" aria-hidden="true">
    <script is:inline>
      (() => {
        const splash = document.currentScript.parentElement;
        // 开屏动画每个会话只播一次：从别的页面转回来（前端路由）时直接不显示。
        // 想改成「一辈子只播一次」把 sessionStorage 换成 localStorage 即可。
        let seen = false;
        try {
          seen = sessionStorage.getItem("splash-shown") === "1";
          if (!seen) sessionStorage.setItem("splash-shown", "1");
        } catch {}
        if (seen) {
          splash.remove();
          return;
        }
        splash.dataset.shownAt = String(performance.now());
        // 保险：app 的脚本若没加载成功（dev server 重启、chunk 404），
        // 模块里的收尾就不会执行，遮罩会一直盖着整页，所以在这里也放一个保险。
        window.setTimeout(() => {
          if (splash.isConnected) splash.remove();
        }, 1500);
      })();
    </script>
    <img
      class="splash-logo logo-light"
      src="/fuckxter_bk.avif"
      alt=""
      width="515"
      height="128"
      decoding="sync"
    />
    <img
      class="splash-logo logo-dark"
      src="/fuckxter_wh.avif"
      alt=""
      width="514"
      height="514"
      decoding="sync"
    />
  </div>
  <div class="app" data-app>
    <header class="topbar">
      <a class="brand" href="/" aria-label="FuckXter 首页">
        <img
          class="logo-img logo-light"
          src="/fuckxter_bk.avif"
          alt="FuckXter"
          width="515"
          height="128"
          decoding="async"
        />
        <img
          class="logo-img logo-dark"
          src="/fuckxter_wh.avif"
          alt="FuckXter"
          width="514"
          height="514"
          decoding="async"
        />
      </a>

      <div class="search">
        <svg
          class="search-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.35-4.35"></path>
        </svg>
        <input
          class="search-input"
          type="search"
          placeholder="搜索 FuckXter"
          aria-label="搜索 FuckXter"
          autocomplete="off"
        />
      </div>

      <nav class="tabs" aria-label="时间线">
        <button type="button" class="tab is-active" data-tab="foryou">
          推荐
        </button>
        <button type="button" class="tab" data-tab="latest">
          实时
        </button>
        <button type="button" class="tab" data-tab="following">
          关注
        </button>
      </nav>

      <div class="account">
        <button
          type="button"
          class="account-btn"
          data-role="account-btn"
          aria-label="账号"
          aria-expanded="false"
          aria-haspopup="menu"
        >
          <span class="account-avatar" data-role="account-avatar" hidden></span>
          <svg
            class="account-icon"
            data-role="account-icon"
            viewBox="0 0 24 24"
            width="21"
            height="21"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="8" r="4"></circle>
            <path d="M4 21c0-4 3.6-6.5 8-6.5s8 2.5 8 6.5"></path>
          </svg>
          <span
            class="account-notice-dot"
            data-role="account-notice-dot"
            hidden
          ></span>
        </button>

        <div
          class="menu account-menu"
          data-role="account-menu"
          role="menu"
          hidden
        >
          <div data-role="auth-items">
            <p class="menu-title">登录 FuckXter</p>
            <button
              type="button"
              class="menu-item"
              role="menuitem"
              data-auth-open="signin"
            >
              登录 / 注册
            </button>
          </div>

          <div data-role="user-items" hidden>
            <button
              type="button"
              class="menu-user"
              role="menuitem"
              data-account-open="profile"
              aria-label="进入我的主页"
            >
              <span class="menu-user-avatar" data-role="menu-avatar"></span>
              <span class="menu-user-meta">
                <strong data-role="menu-name"></strong>
                <small data-role="menu-handle"></small>
              </span>
            </button>
            <button
              type="button"
              class="menu-item notice-menu-item"
              role="menuitem"
              data-account-open="notice"
              data-role="notice-menu-item"
            >
              <span>通知</span>
              <span
                class="notice-menu-badge"
                data-role="notice-menu-badge"
                hidden
              ></span>
            </button>
            <button
              type="button"
              class="menu-item notice-menu-item"
              role="menuitem"
              data-account-open="messages"
              data-role="message-menu-item"
            >
              <span>私信</span>
              <span
                class="notice-menu-badge"
                data-role="message-menu-badge"
                hidden
              ></span>
            </button>
            <button
              type="button"
              class="menu-item"
              role="menuitem"
              data-account-open="saved"
            >
              收藏
            </button>
            <button
              type="button"
              class="menu-item"
              role="menuitem"
              data-account-open="settings"
            >
              设置
            </button>
          </div>

          <div class="menu-row">
            <button
              type="button"
              class="menu-item menu-expandable"
              role="menuitem"
              aria-expanded="false"
              aria-haspopup="menu"
              data-account-open="theme"
            >
              主题
              <span class="menu-arrow" aria-hidden="true">
                ▸
              </span>
            </button>

            <div class="submenu" data-role="theme-submenu" role="menu" hidden>
              <button
                type="button"
                class="menu-item"
                role="menuitemradio"
                data-theme-choice="auto"
              >
                <span class="menu-check">✓</span>跟随系统
              </button>
              <button
                type="button"
                class="menu-item"
                role="menuitemradio"
                data-theme-choice="light"
              >
                <span class="menu-check">✓</span>浅色
              </button>
              <button
                type="button"
                class="menu-item"
                role="menuitemradio"
                data-theme-choice="dark"
              >
                <span class="menu-check">✓</span>深色
              </button>
            </div>
          </div>

          <div class="menu-row">
            <button
              type="button"
              class="menu-item menu-expandable"
              role="menuitem"
              aria-expanded="false"
              aria-haspopup="menu"
              data-role="columns-trigger"
            >
              列数
              <span class="columns-value" data-role="columns-value">
                2 列
              </span>
              <span class="menu-arrow" aria-hidden="true">
                ▸
              </span>
            </button>

            <div class="submenu" data-role="columns-submenu" role="menu" hidden>
              <button
                type="button"
                class="menu-item"
                role="menuitemradio"
                aria-checked="false"
                data-columns-choice="3"
              >
                <span class="menu-check">✓</span>3 列
              </button>
              <button
                type="button"
                class="menu-item"
                role="menuitemradio"
                aria-checked="true"
                data-columns-choice="2"
              >
                <span class="menu-check">✓</span>2 列
              </button>
              <button
                type="button"
                class="menu-item"
                role="menuitemradio"
                aria-checked="false"
                data-columns-choice="1"
              >
                <span class="menu-check">✓</span>1 列
              </button>
              <button
                type="button"
                class="menu-item"
                role="menuitemradio"
                aria-checked="false"
                data-columns-choice="auto"
              >
                <span class="menu-check">✓</span>自动
              </button>
            </div>
          </div>

          <div data-role="signout-items" hidden>
            <hr class="menu-sep" />
            <button
              type="button"
              class="menu-item"
              role="menuitem"
              data-account-action="signout"
            >
              注销
            </button>
          </div>
        </div>
      </div>
    </header>

    <div class="main">
      <section class="composer" aria-label="发帖">
        <div class="avatar"></div>
        <div class="composer-body">
          <textarea
            class="composer-input"
            rows="2"
            placeholder="有什么新鲜事？"
            aria-label="发帖内容"
          ></textarea>
          <div class="composer-foot">
            <button
              type="button"
              class="composer-attach"
              data-role="attach-media"
              aria-label="添加图片"
              title="添加图片"
            >
              <svg
                viewBox="0 0 24 24"
                width="18"
                height="18"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"></path>
              </svg>
            </button>
            <input
              class="media-input"
              data-role="media-input"
              type="file"
              accept="image/jpeg,image/png,image/gif,image/webp,image/avif"
              hidden
            />
            <div
              class="composer-picker menu-row"
              data-role="media-storage-wrap"
              hidden
            >
              <button
                type="button"
                class="menu-item menu-expandable composer-picker-btn"
                data-role="media-storage-trigger"
                aria-label="选择附件存储桶"
                aria-expanded="false"
                aria-haspopup="menu"
              >
                <span
                  class="composer-picker-value"
                  data-role="media-storage-value"
                >
                  默认存储桶
                </span>
                <span class="menu-arrow" aria-hidden="true">
                  ▸
                </span>
              </button>
              <div
                class="submenu composer-submenu"
                data-role="media-storage-menu"
                role="menu"
                hidden
              ></div>
            </div>
            <div class="composer-picker menu-row" data-role="visibility-wrap">
              <button
                type="button"
                class="menu-item menu-expandable composer-picker-btn"
                data-role="visibility-trigger"
                aria-label="帖子可见范围"
                aria-expanded="false"
                aria-haspopup="menu"
              >
                <span
                  class="composer-picker-value"
                  data-role="visibility-value"
                >
                  公开可见
                </span>
                <span class="menu-arrow" aria-hidden="true">
                  ▸
                </span>
              </button>
              <div
                class="submenu composer-submenu"
                data-role="visibility-menu"
                role="menu"
                hidden
              >
                <button
                  type="button"
                  class="menu-item"
                  role="menuitemradio"
                  aria-checked="true"
                  data-visibility-choice="public"
                >
                  <span class="menu-check">✓</span>公开可见
                </button>
                <button
                  type="button"
                  class="menu-item"
                  role="menuitemradio"
                  aria-checked="false"
                  data-visibility-choice="mutual"
                >
                  <span class="menu-check">✓</span>仅互关可见
                </button>
                <button
                  type="button"
                  class="menu-item"
                  role="menuitemradio"
                  aria-checked="false"
                  data-visibility-choice="private"
                >
                  <span class="menu-check">✓</span>私密贴
                </button>
              </div>
            </div>
            <span
              class="media-status"
              data-role="media-status"
              aria-live="polite"
              hidden
            ></span>
            <span
              class="composer-auth-hint"
              data-role="composer-auth-hint"
              hidden
            >
              注册后才能发帖
            </span>
            <span class="char-count">0 / 1000</span>
            <button type="button" class="post-btn" disabled>
              发帖
            </button>
          </div>
          <div class="media composer-preview" data-role="media-preview" hidden>
            <img class="media-image" data-role="media-preview-image" alt="" />
            <label
              class="hdr-toggle"
              data-role="media-hdr-wrap"
              title="普通 SDR 图片本身没有超过 SDR 白的亮度，勾了也不会有变化；只有本身带 HDR 信息的图片（HDR gain map、PQ/BT.2020）才会看出区别。"
              hidden
            >
              <input type="checkbox" data-role="media-hdr" />
              <span>HDR 显示</span>
              <small class="hdr-hint">
                只对带 HDR 信息的图（gain map / PQ）有区别
              </small>
            </label>
          </div>
        </div>
      </section>

      <section class="feed" aria-label="信息流"></section>

      <div class="sentinel">
        <span class="spinner" aria-hidden="true"></span>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { mount } from "../lib/accounts/client";
  import { onPageReady } from "../lib/core/page";

  onPageReady(() => {
    mount("[data-app]");
  });
</script>
